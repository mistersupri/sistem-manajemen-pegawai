# Salin menjadi .env lalu isi. Jangan commit .env.

# --- Database ---------------------------------------------------------------
# Untuk docker compose, DATABASE_URL disusun otomatis dari POSTGRES_*.
POSTGRES_DB=simpeg
POSTGRES_USER=simpeg
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Untuk menjalankan tanpa Docker:
DATABASE_URL=postgresql://simpeg:ganti-dengan-password-kuat@127.0.0.1:5432/simpeg

# --- Rahasia aplikasi -------------------------------------------------------
# Minimal 32 karakter acak:  openssl rand -base64 48
APP_SECRET=
# Kunci AES-256 (32 byte, base64) untuk template wajah, NIK, secret perangkat, dan MFA.
#   openssl rand -base64 32
# PENTING: simpan cadangan kunci ini terpisah dari backup database. Tanpa kunci, data
# terenkripsi tidak bisa dibuka. Mengganti kunci berarti template wajah harus didaftarkan ulang.
BIOMETRIC_ENCRYPTION_KEY=

# --- Akun Super Admin --------------------------------------------------------
# Dibuat saat seed (npm run db:seed, npm run dev:local, atau saat container app mulai) bila username
# ini belum ada. Password akun yang sudah ada tidak ditimpa; untuk menerapkan ADMIN_PASSWORD
# yang baru atau membuka akun terkunci jalankan: npm run admin:reset
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=

# --- Lainnya ---------------------------------------------------------------
APP_TIMEZONE=Asia/Jakarta
STORAGE_DIR=./storage
APP_PORT=3000
# 1 bila aplikasi diakses lewat HTTPS (cookie Secure). Wajib di produksi.
COOKIE_SECURE=1
# 1 bila di belakang reverse proxy tepercaya (membaca X-Forwarded-For untuk audit/rate limit).
TRUST_PROXY=0
LOG_LEVEL=info
# 1 hanya untuk lingkungan demo: membuat data contoh bertanda "(demo)".
SEED_DEMO=0
BACKUP_RETENTION_DAYS=30

# --- Docker -------------------------------------------------------------------
# 1 (bawaan): container app menjalankan migrasi skema dan seed sebelum server mulai.
# 0: migrasi dijalankan manual dengan `docker compose run --rm app migrate`.
MIGRATE_ON_START=1
