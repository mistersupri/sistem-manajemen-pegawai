<%- include('../partials/header') %>
<%
  const shiftById = Object.fromEntries(shifts.map((s) => [s.id, s]));
  const [yy, mm] = bulan.split('-').map(Number);
  const prev = `${mm === 1 ? yy - 1 : yy}-${T.pad(mm === 1 ? 12 : mm - 1)}`;
  const next = `${mm === 12 ? yy + 1 : yy}-${T.pad(mm === 12 ? 1 : mm + 1)}`;
%>
<div class="page-head">
  <div>
    <h1>Jadwal shift · <%= T.BULAN[mm - 1] %> <%= yy %></h1>
    <div class="sub">Pilih sel untuk mengubah jadwal satu hari. Gunakan tombol panah untuk berpindah sel dan Enter untuk membuka pilihan.</div>
  </div>
  <div class="actions">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bulkModal">Atur banyak sekaligus</button>
    <a class="btn btn-outline-secondary" href="/admin/jadwal/export?bulan=<%= bulan %>&unit=<%= encodeURIComponent(unit) %>">Ekspor Excel</a>
    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#importModal">Impor</button>
  </div>
</div>

<form class="card card-body mb-3" method="get" aria-label="Pilih bulan dan unit">
  <div class="d-flex flex-wrap gap-2 align-items-end">
    <a class="btn btn-outline-secondary" href="?bulan=<%= prev %>&unit=<%= encodeURIComponent(unit) %>" aria-label="Bulan sebelumnya"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
    <div><label class="form-label small" for="bulan">Bulan</label><input type="month" id="bulan" name="bulan" class="form-control" value="<%= bulan %>"></div>
    <a class="btn btn-outline-secondary" href="?bulan=<%= next %>&unit=<%= encodeURIComponent(unit) %>" aria-label="Bulan berikutnya"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    <div style="min-width: 200px"><label class="form-label small" for="unitSel">Unit kerja</label>
      <select id="unitSel" name="unit" class="form-select"><option value="">Semua unit</option>
        <% units.forEach((u) => { %><option <%= unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </div>
    <button class="btn btn-primary">Tampilkan</button>
  </div>
  <div class="d-flex flex-wrap gap-3 small mt-3" aria-label="Keterangan">
    <% shifts.filter((s) => s.aktif).forEach((s) => { %><span><span class="shift-chip" style="background: <%= s.warna %>; color: <%= chipText(s.warna) %>"><%= s.kode %></span> <span class="num"><%= s.jam_masuk %> sampai <%= s.jam_pulang %></span></span><% }) %>
    <span><span class="shift-chip default" style="border-color: var(--biru)">REG</span> bergaris = mengikuti shift default</span>
    <span><span class="libur-tag">L</span> = libur dijadwalkan</span>
    <span><span class="text-muted fw-bold">L</span> = bukan hari kerja / tanggal merah</span>
  </div>
</form>

<div class="card">
  <% if (!employees.length) { %>
    <%- include('../partials/empty', { judul: 'Tidak ada pegawai aktif', alasan: unit ? `Tidak ada pegawai aktif di unit ${unit}.` : 'Tambahkan pegawai terlebih dahulu, lalu atur jadwalnya di sini.', aksi: [{ href: '/admin/pegawai/baru', label: 'Tambah pegawai', utama: true }] }) %>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-bordered schedule-table mb-0" role="grid" aria-label="Jadwal shift <%= T.BULAN[mm - 1] %> <%= yy %>">
      <thead>
        <tr>
          <th class="name" scope="col">Pegawai</th>
          <% days.forEach((d) => { const wd = T.parseDateTime(d).getDay(); %>
            <th scope="col" class="<%= !workday[d] ? 'weekend' : '' %>" title="<%= libur[d] || '' %>"><div class="num"><%= +d.slice(8) %></div><div class="fw-normal"><%= T.HARI_PENDEK[wd] %></div></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
      <% employees.forEach((e, ei) => { %>
        <tr data-default="<%= e.default_shift_id || '' %>">
          <th scope="row" class="name"><div class="fw-semibold"><%= e.nama %></div><span class="cell-sub fw-normal"><%= e.unit_kerja || '' %></span></th>
          <% days.forEach((d, di) => {
               const v = map[`${e.id}|${d}`];
               const val = v === undefined ? 'default' : v; %>
            <td class="<%= !workday[d] ? 'weekend' : '' %>">
              <button type="button" class="cell-btn" tabindex="<%= ei === 0 && di === 0 ? 0 : -1 %>" data-row="<%= ei %>" data-col="<%= di %>"
                data-emp="<%= e.id %>" data-nama="<%= e.nama %>" data-date="<%= d %>" data-tgl="<%= T.fmtTglPendek(d, false) %>"
                data-workday="<%= workday[d] ? 1 : 0 %>" data-libur="<%= libur[d] || '' %>" data-value="<%= val %>" aria-haspopup="menu"></button>
            </td>
          <% }) %>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<div class="cell-menu" id="cellMenu" role="menu" aria-label="Pilih shift">
  <% shifts.filter((s) => s.aktif).forEach((s) => { %>
    <button type="button" class="dropdown-item" role="menuitem" data-set="<%= s.id %>"><span class="shift-chip" style="background: <%= s.warna %>; color: <%= chipText(s.warna) %>"><%= s.kode %></span> <%= s.nama %></button>
  <% }) %>
  <button type="button" class="dropdown-item" role="menuitem" data-set="L"><span class="libur-tag">L</span> Libur</button>
  <div class="dropdown-divider"></div>
  <button type="button" class="dropdown-item" role="menuitem" data-set="default">Ikuti shift default</button>
</div>
<div id="cellStatus" class="visually-hidden" aria-live="polite"></div>

<div class="modal fade" id="bulkModal" tabindex="-1" aria-labelledby="bulkTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <form class="modal-content" method="post" action="/admin/jadwal/massal" data-loading="Menerapkan...">
      <div class="modal-header"><h2 class="modal-title h5" id="bulkTitle">Atur jadwal banyak pegawai</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="empSel">Pegawai</label>
            <select id="empSel" name="employee_ids" class="form-select" multiple size="10" required aria-describedby="empHelp">
              <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.nama %><%= e.unit_kerja ? ` (${e.unit_kerja})` : '' %></option><% }) %>
            </select>
            <div class="form-text" id="empHelp">Tahan Ctrl (atau Cmd) untuk memilih lebih dari satu.</div>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="selectAll">Pilih semua pegawai</button>
          </div>
          <div class="col-md-6">
            <div class="row g-2">
              <div class="col-6"><label class="form-label" for="bd">Dari</label><input type="date" id="bd" name="dari" class="form-control" value="<%= days[0] %>" required></div>
              <div class="col-6"><label class="form-label" for="bs">Sampai</label><input type="date" id="bs" name="sampai" class="form-control" value="<%= days[days.length - 1] %>" required></div>
              <div class="col-12">
                <div class="form-label">Hanya hari (kosongkan untuk semua hari)</div>
                <div class="d-flex flex-wrap gap-2">
                  <% T.HARI.forEach((h, i) => { %>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="hari" value="<%= i %>" id="h<%= i %>"><label class="form-check-label" for="h<%= i %>"><%= h %></label></div>
                  <% }) %>
                </div>
              </div>
              <div class="col-12">
                <label class="form-label" for="bv">Jadwal</label>
                <select id="bv" name="value" class="form-select" required>
                  <% shifts.filter((s) => s.aktif).forEach((s) => { %><option value="<%= s.id %>"><%= s.kode %> · <%= s.nama %> (<%= s.jam_masuk %> sampai <%= s.jam_pulang %>)</option><% }) %>
                  <option value="L">Libur</option>
                  <option value="default">Ikuti shift default</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Terapkan jadwal</button></div>
    </form>
  </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="impTitle" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/admin/jadwal/import" enctype="multipart/form-data" data-loading="Mengimpor...">
      <div class="modal-header"><h2 class="modal-title h5" id="impTitle">Impor jadwal shift</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
      <div class="modal-body small">
        <p>Gunakan file hasil <b>Ekspor</b> sebagai template: kolom <code>NIP</code>, <code>Nama</code>, lalu satu kolom per tanggal (format <code>YYYY-MM-DD</code>) berisi kode shift atau <code>L</code> untuk libur. Sel kosong diabaikan.</p>
        <label class="form-label" for="impJ">File</label>
        <input type="file" id="impJ" name="file" class="form-control" accept=".xlsx,.csv" required>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Impor jadwal</button></div>
    </form>
  </div>
</div>

<script>
const SHIFTS = <%- JSON.stringify(shiftById).replace(/</g, '\\u003c') %>;
(() => {
  const menu = document.getElementById('cellMenu');
  const status = document.getElementById('cellStatus');
  const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const chipText = (hex) => {
    const lin = (i) => { const v = parseInt(hex.slice(1 + i, 3 + i), 16) / 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
    const L = 0.2126 * lin(0) + 0.7152 * lin(2) + 0.0722 * lin(4);
    return 1.05 / (L + 0.05) >= (L + 0.05) / (0.0196 + 0.05) ? '#ffffff' : '#1f2733';
  };

  // Tampilan sel: isi visual + label untuk pembaca layar
  function render(btn) {
    const v = btn.dataset.value;
    const def = btn.closest('tr').dataset.default;
    const isDefault = v === 'default';
    let html;
    let text;
    if (v === 'L') { html = '<span class="libur-tag">L</span>'; text = 'libur'; }
    else if (isDefault && def && btn.dataset.workday !== '1') {
      html = '<span class="text-muted fw-bold">L</span>';
      text = btn.dataset.libur ? `libur nasional (${btn.dataset.libur})` : 'bukan hari kerja';
    } else {
      const s = SHIFTS[isDefault ? def : v];
      if (s) {
        html = isDefault
          ? `<span class="shift-chip default" style="border-color: ${s.warna}">${esc(s.kode)}</span>`
          : `<span class="shift-chip" style="background: ${s.warna}; color: ${chipText(s.warna)}">${esc(s.kode)}</span>`;
        text = `${s.nama}${isDefault ? ' (shift default)' : ''}`;
      } else { html = '<span class="text-muted">·</span>'; text = 'tanpa shift'; }
    }
    btn.innerHTML = html;
    btn.setAttribute('aria-label', `${btn.dataset.nama}, ${btn.dataset.tgl}: ${text}`);
    return text;
  }
  const cells = [...document.querySelectorAll('.cell-btn')];
  cells.forEach(render);

  // Navigasi panah antar sel (roving tabindex)
  const at = (r, c) => document.querySelector(`.cell-btn[data-row="${r}"][data-col="${c}"]`);
  function moveTo(next, from) {
    if (!next) return;
    from.tabIndex = -1;
    next.tabIndex = 0;
    next.focus();
  }
  cells.forEach((btn) => btn.addEventListener('keydown', (e) => {
    const r = +btn.dataset.row;
    const c = +btn.dataset.col;
    const map = { ArrowRight: [r, c + 1], ArrowLeft: [r, c - 1], ArrowDown: [r + 1, c], ArrowUp: [r - 1, c] };
    if (map[e.key]) { e.preventDefault(); moveTo(at(...map[e.key]), btn); }
  }));

  let current = null;
  const items = [...menu.querySelectorAll('[role=menuitem]')];
  function closeMenu(returnFocus) {
    menu.classList.remove('show');
    if (returnFocus && current) current.focus();
  }
  function openMenu(btn) {
    current = btn;
    cells.forEach((b) => { b.tabIndex = -1; });
    btn.tabIndex = 0;
    const r = btn.getBoundingClientRect();
    menu.classList.add('show');
    const left = Math.min(r.left + window.scrollX, window.scrollX + document.documentElement.clientWidth - menu.offsetWidth - 8);
    menu.style.left = `${Math.max(8, left)}px`;
    menu.style.top = `${r.bottom + window.scrollY + 4}px`;
    items[0].focus();
  }
  cells.forEach((btn) => btn.addEventListener('click', (ev) => { ev.stopPropagation(); openMenu(btn); }));
  document.addEventListener('click', (e) => { if (!menu.contains(e.target)) closeMenu(false); });
  menu.addEventListener('keydown', (e) => {
    const i = items.indexOf(document.activeElement);
    if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
    else if (e.key === 'Tab') closeMenu(false);
  });
  items.forEach((b) => b.addEventListener('click', async () => {
    const btn = current;
    closeMenu(true);
    btn.innerHTML = '<span class="spinner-border spinner-border-sm text-secondary" aria-hidden="true"></span>';
    try {
      const r = await fetch('/api/jadwal', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ employee_id: btn.dataset.emp, tanggal: btn.dataset.date, value: b.dataset.set }),
      });
      if (!r.ok) throw new Error((await r.json()).error || 'Gagal menyimpan jadwal.');
      btn.dataset.value = b.dataset.set;
      status.textContent = `Tersimpan: ${btn.dataset.nama}, ${btn.dataset.tgl}, ${render(btn)}.`;
    } catch (err) {
      render(btn);
      status.textContent = err.message;
      alert(`${err.message} Periksa koneksi lalu coba lagi.`);
    }
  }));
  const all = document.getElementById('selectAll');
  if (all) all.addEventListener('click', () => {
    document.querySelectorAll('select[name=employee_ids] option').forEach((o) => { o.selected = true; });
  });
})();
</script>
<%- include('../partials/footer') %>
