<%- include('../partials/header') %>
<%
  const shiftById = Object.fromEntries(shifts.map((s) => [s.id, s]));
  const [yy, mm] = bulan.split('-').map(Number);
  const prev = `${mm === 1 ? yy - 1 : yy}-${T.pad(mm === 1 ? 12 : mm - 1)}`;
  const next = `${mm === 12 ? yy + 1 : yy}-${T.pad(mm === 12 ? 1 : mm + 1)}`;
%>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-calendar3"></i> Jadwal Shift · <%= T.BULAN[mm - 1] %> <%= yy %></h1>
  <div class="d-flex flex-wrap gap-2">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bulkModal"><i class="bi bi-calendar-plus"></i> Atur Massal</button>
    <a class="btn btn-outline-success" href="/admin/jadwal/export?bulan=<%= bulan %>&unit=<%= encodeURIComponent(unit) %>"><i class="bi bi-file-earmark-excel"></i> Ekspor</a>
    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal"><i class="bi bi-upload"></i> Impor</button>
  </div>
</div>

<form class="card card-body shadow-sm mb-3" method="get">
  <div class="row g-2 align-items-center">
    <div class="col-auto"><a class="btn btn-light" href="?bulan=<%= prev %>&unit=<%= encodeURIComponent(unit) %>"><i class="bi bi-chevron-left"></i></a></div>
    <div class="col-auto"><input type="month" name="bulan" class="form-control" value="<%= bulan %>"></div>
    <div class="col-auto"><a class="btn btn-light" href="?bulan=<%= next %>&unit=<%= encodeURIComponent(unit) %>"><i class="bi bi-chevron-right"></i></a></div>
    <div class="col-md-3">
      <select name="unit" class="form-select"><option value="">Semua unit</option>
        <% units.forEach((u) => { %><option <%= unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </div>
    <div class="col-auto"><button class="btn btn-secondary">Tampilkan</button></div>
    <div class="col small text-muted">
      <% shifts.filter((s) => s.aktif).forEach((s) => { %><span class="shift-chip me-1" style="background: <%= s.warna %>"><%= s.kode %></span><%= s.jam_masuk %>-<%= s.jam_pulang %> &nbsp;<% }) %>
      <span class="libur">L</span> = Libur · warna pudar = shift default
    </div>
  </div>
</form>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-bordered schedule-table mb-0">
      <thead class="table-light">
        <tr>
          <th class="name">Pegawai</th>
          <% days.forEach((d) => { const wd = T.parseDateTime(d).getDay(); %>
            <th class="<%= wd === 0 || wd === 6 ? 'weekend' : '' %>"><div><%= +d.slice(8) %></div><div class="fw-normal text-muted"><%= T.HARI[wd].slice(0, 3) %></div></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
      <% if (!employees.length) { %><tr><td colspan="<%= days.length + 1 %>" class="text-muted py-4">Tidak ada pegawai aktif.</td></tr><% } %>
      <% employees.forEach((e) => { %>
        <tr data-default="<%= e.default_shift_id || '' %>">
          <td class="name"><div class="fw-semibold"><%= e.nama %></div><div class="text-muted"><%= e.unit_kerja || '' %></div></td>
          <% days.forEach((d) => {
               const v = map[`${e.id}|${d}`];
               const wd = T.parseDateTime(d).getDay();
               const isDefault = v === undefined;
               const s = isDefault ? shiftById[e.default_shift_id] : (v === 'L' ? null : shiftById[v]); %>
            <td class="cell <%= wd === 0 || wd === 6 ? 'weekend' : '' %>" data-emp="<%= e.id %>" data-date="<%= d %>" data-value="<%= isDefault ? 'default' : v %>">
              <% if (v === 'L') { %><span class="libur">L</span>
              <% } else if (s) { %><span class="shift-chip <%= isDefault ? 'default' : '' %>" style="background: <%= s.warna %>"><%= s.kode %></span>
              <% } else { %><span class="text-muted">·</span><% } %>
            </td>
          <% }) %>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="small text-muted mt-2">Klik sel untuk mengubah jadwal satu hari.</p>

<!-- Menu pilih shift per sel -->
<div class="dropdown-menu shadow" id="cellMenu" style="position: absolute">
  <% shifts.filter((s) => s.aktif).forEach((s) => { %>
    <button class="dropdown-item" data-set="<%= s.id %>"><span class="shift-chip" style="background: <%= s.warna %>"><%= s.kode %></span> <%= s.nama %></button>
  <% }) %>
  <button class="dropdown-item text-danger" data-set="L"><b>L</b> Libur</button>
  <div class="dropdown-divider"></div>
  <button class="dropdown-item text-muted" data-set="default">Kembalikan ke shift default</button>
</div>

<div class="modal fade" id="bulkModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form class="modal-content" method="post" action="/admin/jadwal/massal">
      <div class="modal-header"><h5 class="modal-title">Atur Jadwal Massal</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Pegawai</label>
            <select name="employee_ids" class="form-select" multiple size="10" required>
              <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.nama %> (<%= e.unit_kerja || '-' %>)</option><% }) %>
            </select>
            <button type="button" class="btn btn-link btn-sm px-0" id="selectAll">Pilih semua</button>
          </div>
          <div class="col-md-6">
            <div class="row g-2">
              <div class="col-6"><label class="form-label">Dari</label><input type="date" name="dari" class="form-control" value="<%= days[0] %>" required></div>
              <div class="col-6"><label class="form-label">Sampai</label><input type="date" name="sampai" class="form-control" value="<%= days[days.length - 1] %>" required></div>
              <div class="col-12">
                <label class="form-label">Hari (kosong = semua hari)</label>
                <div class="d-flex flex-wrap gap-2">
                  <% T.HARI.forEach((h, i) => { %>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="hari" value="<%= i %>" id="h<%= i %>"><label class="form-check-label" for="h<%= i %>"><%= h %></label></div>
                  <% }) %>
                </div>
              </div>
              <div class="col-12">
                <label class="form-label">Shift</label>
                <select name="value" class="form-select" required>
                  <% shifts.filter((s) => s.aktif).forEach((s) => { %><option value="<%= s.id %>"><%= s.kode %> · <%= s.nama %> (<%= s.jam_masuk %>-<%= s.jam_pulang %>)</option><% }) %>
                  <option value="L">Libur</option>
                  <option value="default">Kembalikan ke shift default</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Terapkan</button></div>
    </form>
  </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/admin/jadwal/import" enctype="multipart/form-data">
      <div class="modal-header"><h5 class="modal-title">Impor Jadwal Shift</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body small">
        <p>Gunakan file hasil <b>Ekspor</b> sebagai template: kolom <code>NIP</code>, <code>Nama</code>, lalu satu kolom per tanggal (format <code>YYYY-MM-DD</code>) berisi kode shift atau <code>L</code> untuk libur. Sel kosong diabaikan.</p>
        <input type="file" name="file" class="form-control" accept=".xlsx,.csv" required>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Impor</button></div>
    </form>
  </div>
</div>

<script>
const SHIFTS = <%- JSON.stringify(shiftById).replace(/</g, '\\u003c') %>;
(() => {
  const menu = document.getElementById('cellMenu');
  let current = null;
  document.querySelectorAll('td.cell').forEach((td) => td.addEventListener('click', (ev) => {
    ev.stopPropagation();
    current = td;
    const r = td.getBoundingClientRect();
    menu.style.left = `${r.left + window.scrollX}px`;
    menu.style.top = `${r.bottom + window.scrollY}px`;
    menu.classList.add('show');
  }));
  document.addEventListener('click', () => menu.classList.remove('show'));
  menu.querySelectorAll('[data-set]').forEach((b) => b.addEventListener('click', async () => {
    const td = current;
    const r = await fetch('/api/jadwal', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ employee_id: td.dataset.emp, tanggal: td.dataset.date, value: b.dataset.set }),
    });
    if (!r.ok) { alert((await r.json()).error || 'Gagal menyimpan'); return; }
    const v = b.dataset.set;
    const isDefault = v === 'default';
    const s = isDefault ? SHIFTS[td.closest('tr').dataset.default] : SHIFTS[v];
    td.dataset.value = v;
    td.innerHTML = v === 'L' ? '<span class="libur">L</span>'
      : s ? `<span class="shift-chip ${isDefault ? 'default' : ''}" style="background: ${s.warna}">${s.kode}</span>`
        : '<span class="text-muted">·</span>';
  }));
  document.getElementById('selectAll').addEventListener('click', () => {
    document.querySelectorAll('select[name=employee_ids] option').forEach((o) => { o.selected = true; });
  });
})();
</script>
<%- include('../partials/footer') %>
