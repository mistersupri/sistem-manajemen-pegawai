<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Hari libur nasional dan cuti bersama</h1>
    <div class="sub">Pada tanggal ini shift default tidak berlaku, jadi pegawai tidak dihitung tanpa keterangan.</div>
  </div>
  <form method="get" class="actions" aria-label="Pilih tahun">
    <a class="btn btn-outline-secondary" href="?tahun=<%= +tahun - 1 %>" aria-label="Tahun <%= +tahun - 1 %>"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
    <label class="visually-hidden" for="tahun">Tahun</label>
    <input type="number" id="tahun" name="tahun" class="form-control num" style="width: 110px" value="<%= tahun %>" onchange="this.form.submit()">
    <a class="btn btn-outline-secondary" href="?tahun=<%= +tahun + 1 %>" aria-label="Tahun <%= +tahun + 1 %>"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
  </form>
</div>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover table-stack">
          <thead><tr><th>Tanggal</th><th>Keterangan</th><th class="text-end">Aksi</th></tr></thead>
          <tbody>
          <% if (!list.length) { %><tr class="empty-row"><td colspan="3"><%- include('../partials/empty', { judul: `Belum ada hari libur untuk ${tahun}`, alasan: 'Tambahkan tanggal merah dan cuti bersama sesuai SKB pemerintah lewat formulir di samping.' }) %></td></tr><% } %>
          <% list.forEach((h) => { %>
            <tr>
              <td class="stack-head text-nowrap fw-semibold"><%= T.fmtTglPendek(h.tanggal) %></td>
              <td data-label="Keterangan"><%= h.keterangan %></td>
              <td class="text-end"><form method="post" action="/admin/hari-libur/hapus" data-confirm="Hapus hari libur <%= h.keterangan %>?"><input type="hidden" name="tanggal" value="<%= h.tanggal %>"><button class="btn btn-sm btn-outline-danger">Hapus</button></form></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <form method="post" class="card" data-loading="Menyimpan...">
      <div class="card-header"><h2 class="h6 mb-0">Tambah hari libur</h2></div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-6"><label class="form-label" for="hd">Tanggal</label><input type="date" id="hd" name="dari" class="form-control" required></div>
          <div class="col-6"><label class="form-label" for="hs">Sampai (opsional)</label><input type="date" id="hs" name="sampai" class="form-control"></div>
          <div class="col-12"><label class="form-label" for="hk">Keterangan</label><input id="hk" name="keterangan" class="form-control" placeholder="Contoh: Cuti bersama Idul Fitri" required maxlength="200"></div>
        </div>
      </div>
      <div class="card-footer"><button class="btn btn-primary">Simpan hari libur</button></div>
    </form>
    <p class="small text-muted mt-2">Pada hari libur, shift default tidak berlaku sehingga pegawai tidak dihitung "tanpa keterangan". Pegawai yang tetap bertugas (mis. piket) dapat diberi shift lewat <a href="/admin/jadwal">Jadwal Shift</a>.</p>
  </div>
</div>
<%- include('../partials/footer') %>
