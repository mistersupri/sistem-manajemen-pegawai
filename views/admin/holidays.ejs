<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-calendar-x"></i> Hari Libur Nasional &amp; Cuti Bersama</h1>
  <form method="get" class="d-flex gap-2">
    <a class="btn btn-light" href="?tahun=<%= +tahun - 1 %>"><i class="bi bi-chevron-left"></i></a>
    <input type="number" name="tahun" class="form-control" style="width: 110px" value="<%= tahun %>">
    <a class="btn btn-light" href="?tahun=<%= +tahun + 1 %>"><i class="bi bi-chevron-right"></i></a>
  </form>
</div>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Tanggal</th><th>Keterangan</th><th></th></tr></thead>
          <tbody>
          <% if (!list.length) { %><tr><td colspan="3" class="text-center text-muted py-4">Belum ada hari libur untuk tahun <%= tahun %>.</td></tr><% } %>
          <% list.forEach((h) => { %>
            <tr>
              <td class="text-nowrap"><%= T.fmtTanggalIndo(h.tanggal) %></td>
              <td><%= h.keterangan %></td>
              <td class="text-end"><form method="post" action="/admin/hari-libur/hapus" data-confirm="Hapus hari libur ini?"><input type="hidden" name="tanggal" value="<%= h.tanggal %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <form method="post" class="card shadow-sm">
      <div class="card-header bg-white"><b>Tambah Hari Libur</b></div>
      <div class="card-body">
        <div class="row g-2">
          <div class="col-6"><label class="form-label">Tanggal</label><input type="date" name="dari" class="form-control" required></div>
          <div class="col-6"><label class="form-label">Sampai (opsional)</label><input type="date" name="sampai" class="form-control"></div>
          <div class="col-12"><label class="form-label">Keterangan</label><input name="keterangan" class="form-control" placeholder="mis. Hari Buruh / Cuti Bersama Idul Fitri" required maxlength="200"></div>
        </div>
      </div>
      <div class="card-footer bg-white"><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Simpan</button></div>
    </form>
    <p class="small text-muted mt-2">Pada hari libur, shift default tidak berlaku sehingga pegawai tidak dihitung "tanpa keterangan". Pegawai yang tetap bertugas (mis. piket) dapat diberi shift lewat <a href="/admin/jadwal">Jadwal Shift</a>.</p>
  </div>
</div>
<%- include('../partials/footer') %>
