<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <div>
    <h1 class="h4 mb-0">Detail Absensi</h1>
    <div class="text-muted"><%= rec.nama %> · <%= rec.nip %> · <%= T.fmtTanggalIndo(rec.tanggal) %></div>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/absensi/input?employee_id=<%= rec.employee_id %>&tanggal=<%= rec.tanggal %>" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Koreksi</a>
    <form method="post" action="/admin/absensi/<%= rec.id %>/hapus" data-confirm="Hapus data absensi ini?"><button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Hapus</button></form>
  </div>
</div>
<div class="card shadow-sm mb-4">
  <div class="card-body row g-3">
    <div class="col-md-3"><div class="small text-muted">Shift</div><%= rec.shift_kode ? `${rec.shift_nama} (${rec.shift_masuk}-${rec.shift_pulang})` : 'Tanpa shift' %></div>
    <div class="col-md-2"><div class="small text-muted">Status</div><%- include('../partials/status_badge', { status: rec.status }) %><% if (rec.dispensasi) { %> <span class="badge bg-light text-dark">dispensasi</span><% } %></div>
    <div class="col-md-2"><div class="small text-muted">Terlambat</div><%= rec.terlambat_menit %> menit</div>
    <div class="col-md-2"><div class="small text-muted">Pulang cepat</div><%= rec.pulang_cepat_menit %> menit</div>
    <div class="col-md-3"><div class="small text-muted">Keterangan</div><%= rec.keterangan || '-' %></div>
  </div>
</div>
<div class="row g-4">
  <% [['Masuk', rec.jam_masuk, rec.metode_masuk, rec.foto_masuk, rec.lat_masuk, rec.lng_masuk, rec.alamat_masuk, rec.skor_wajah_masuk],
      ['Pulang', rec.jam_pulang, rec.metode_pulang, rec.foto_pulang, rec.lat_pulang, rec.lng_pulang, rec.alamat_pulang, rec.skor_wajah_pulang]]
     .forEach(([label, jam, metode, foto, lat, lng, alamat, skor]) => { %>
  <div class="col-md-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white"><b>Absen <%= label %></b></div>
      <div class="card-body">
        <% if (!jam) { %><p class="text-muted mb-0">Tidak ada data.</p><% } else { %>
          <div class="h4 mb-1"><%= jam.slice(11, 16) %> <small class="text-muted fs-6"><%= jam.slice(0, 10) %></small></div>
          <div class="small mb-2"><%= METODE_LABEL[metode] || metode %><% if (skor != null) { %> · kemiripan wajah <b><%= Math.round(skor) %>%</b><% } %></div>
          <% if (foto) { %><a href="/uploads/<%= foto %>" target="_blank"><img src="/uploads/<%= foto %>" class="photo-thumb" alt="Foto <%= label %>"></a><% } %>
          <%- include('../partials/location', { lat, lng, alamat }) %>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% if (scans.length) { %>
<div class="card shadow-sm mt-4">
  <div class="card-header bg-white"><b><i class="bi bi-fingerprint"></i> Scan mesin fingerprint</b></div>
  <ul class="list-group list-group-flush small">
    <% scans.forEach((l) => { %><li class="list-group-item d-flex justify-content-between"><span><%= l.waktu.slice(0, 16) %></span><span class="text-muted"><%= l.mesin || (l.sumber === 'lan' ? 'LAN' : 'File USB') %></span></li><% }) %>
  </ul>
</div>
<% } %>
<% if (rec.face_photo) { %>
<div class="mt-4"><div class="small text-muted">Foto referensi wajah terdaftar:</div><img src="/uploads/<%= rec.face_photo %>" class="photo-thumb" style="max-width: 160px" alt="Foto referensi"></div>
<% } %>
<% if (klarifikasi.length) { %>
<h2 class="h6 mt-4">Klarifikasi terkait</h2>
<ul class="list-group">
  <% klarifikasi.forEach((k) => { %>
    <li class="list-group-item d-flex justify-content-between"><span><%= JENIS[k.jenis] || k.jenis %> — <%= k.alasan %></span><a href="/admin/klarifikasi/<%= k.id %>"><span class="badge klar-<%= k.status %>"><%= STATUS_KLARIFIKASI[k.status] %></span></a></li>
  <% }) %>
</ul>
<% } %>
<%- include('../partials/footer') %>
