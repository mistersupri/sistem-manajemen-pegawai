<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="h4 mb-3"><i class="bi bi-pencil-square"></i> Input / Koreksi Absensi Manual</h1>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="get" class="card card-body shadow-sm mb-3">
      <div class="row g-2 align-items-end">
        <div class="col-md-6"><label class="form-label">Pegawai</label>
          <select name="employee_id" class="form-select" required>
            <option value="">- pilih -</option>
            <% employees.forEach((e) => { %><option value="<%= e.id %>" <%= empId === e.id ? 'selected' : '' %>><%= e.nama %> (<%= e.nip %>)</option><% }) %>
          </select>
        </div>
        <div class="col-md-4"><label class="form-label">Tanggal</label><input type="date" name="tanggal" class="form-control" value="<%= tanggal %>" required></div>
        <div class="col-md-2"><button class="btn btn-secondary w-100">Muat</button></div>
      </div>
    </form>
    <% if (empId) { %>
    <form method="post" class="card shadow-sm">
      <div class="card-body">
        <input type="hidden" name="employee_id" value="<%= empId %>">
        <input type="hidden" name="tanggal" value="<%= tanggal %>">
        <p class="mb-3"><%= rec ? 'Mengubah data absensi yang sudah ada.' : 'Belum ada data absensi pada tanggal ini — data baru akan dibuat.' %></p>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">Jam Masuk</label><input type="time" name="jam_masuk" class="form-control" value="<%= rec && rec.jam_masuk ? rec.jam_masuk.slice(11, 16) : '' %>"></div>
          <div class="col-md-4"><label class="form-label">Jam Pulang</label><input type="time" name="jam_pulang" class="form-control" value="<%= rec && rec.jam_pulang ? rec.jam_pulang.slice(11, 16) : '' %>"></div>
          <div class="col-md-4"><label class="form-label">Status</label>
            <select name="status" class="form-select">
              <% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= (rec ? rec.status : 'hadir') === k ? 'selected' : '' %>><%= v %></option><% }) %>
            </select>
            <div class="form-text">Hadir/Terlambat dihitung otomatis dari jam & shift.</div>
          </div>
          <div class="col-12"><label class="form-label">Keterangan</label><textarea name="keterangan" class="form-control" rows="2"><%= rec ? rec.keterangan || '' : '' %></textarea></div>
        </div>
      </div>
      <div class="card-footer bg-white"><button class="btn btn-primary"><i class="bi bi-save"></i> Simpan</button></div>
    </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
