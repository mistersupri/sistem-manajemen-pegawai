<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h4 mb-3"><i class="bi bi-gear"></i> Pengaturan</h1>
    <form method="post" class="card shadow-sm">
      <div class="card-body">
        <h2 class="h6 text-primary">Umum</h2>
        <div class="row g-3 mb-4">
          <div class="col-md-8"><label class="form-label">Nama Instansi</label><input name="nama_instansi" class="form-control" value="<%= settings.nama_instansi %>"></div>
          <div class="col-md-4"><label class="form-label">Label Zona Waktu</label><input name="timezone_label" class="form-control" value="<%= settings.timezone_label %>" maxlength="10"><div class="form-text">Ditampilkan di stempel waktu foto.</div></div>
        </div>

        <h2 class="h6 text-primary">Pengenalan Wajah</h2>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label">Ambang Batas Kecocokan: <b id="thVal"><%= settings.face_threshold %></b></label>
            <input type="range" class="form-range" name="face_threshold" min="0.3" max="0.7" step="0.01" value="<%= settings.face_threshold %>" oninput="thVal.textContent = this.value">
            <div class="form-text">Semakin kecil semakin ketat. Disarankan 0.45 – 0.55.</div>
          </div>
          <div class="col-md-6">
            <div class="form-check form-switch mt-4">
              <input class="form-check-input" type="checkbox" name="liveness" id="liveness" value="1" <%= settings.liveness === '1' ? 'checked' : '' %>>
              <label class="form-check-label" for="liveness">Wajib kedip mata (deteksi keaktifan / anti foto)</label>
            </div>
            <div class="form-check form-switch mt-2">
              <input class="form-check-input" type="checkbox" name="self_checkin" id="self" value="1" <%= settings.self_checkin === '1' ? 'checked' : '' %>>
              <label class="form-check-label" for="self">Izinkan pegawai absen wajah dari HP/laptop sendiri</label>
            </div>
          </div>
        </div>

        <h2 class="h6 text-primary">Lokasi Kantor (Geofence)</h2>
        <p class="small text-muted">Bila diaktifkan, absen wajah mandiri (bukan dinas luar) hanya diterima di dalam radius kantor. Absen <b>Dinas Luar</b> tidak dibatasi radius tetapi wajib menyertakan foto + GPS.</p>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label">Latitude</label><input name="office_lat" id="lat" class="form-control" value="<%= settings.office_lat %>" placeholder="-6.175392"></div>
          <div class="col-md-4"><label class="form-label">Longitude</label><input name="office_lng" id="lng" class="form-control" value="<%= settings.office_lng %>" placeholder="106.827153"></div>
          <div class="col-md-4"><label class="form-label">Radius (meter)</label><input type="number" name="office_radius" class="form-control" value="<%= settings.office_radius %>" min="10"></div>
          <div class="col-md-6">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="useHere"><i class="bi bi-crosshair"></i> Gunakan lokasi saya saat ini</button>
          </div>
          <div class="col-md-6">
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enforce_geofence" id="geo" value="1" <%= settings.enforce_geofence === '1' ? 'checked' : '' %>><label class="form-check-label" for="geo">Aktifkan pembatasan radius</label></div>
          </div>
        </div>
      </div>
      <div class="card-footer bg-white"><button class="btn btn-primary"><i class="bi bi-save"></i> Simpan Pengaturan</button></div>
    </form>
  </div>
</div>
<script>
document.getElementById('useHere').addEventListener('click', () => {
  navigator.geolocation.getCurrentPosition((p) => {
    document.getElementById('lat').value = p.coords.latitude.toFixed(6);
    document.getElementById('lng').value = p.coords.longitude.toFixed(6);
  }, () => alert('Gagal mendapatkan lokasi.'), { enableHighAccuracy: true });
});
</script>
<%- include('../partials/footer') %>
