<%- include('../partials/header') %>
<div class="page-head mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Pengaturan</h1>
  <p class="mt-1 text-sm text-muted-foreground">Identitas instansi, hari kerja, pengenalan wajah, dan lokasi kantor.</p>
</div>
<% const sw = (name, id, checked, text) => `<div class="flex items-start gap-3"><input class="${ui.switch('mt-0.5')}" type="checkbox" role="switch" name="${name}" id="${id}" value="1" ${checked ? 'checked' : ''}><label class="${ui.label('leading-snug font-normal')}" for="${id}">${text}</label></div>`; %>
<div class="grid items-start gap-6 lg:grid-cols-[2fr_1fr]">
  <form method="post" class="<%= ui.card('gap-0 py-0') %>" data-loading="Menyimpan...">
    <section class="grid gap-4 p-6" aria-labelledby="sIdentitas">
      <h2 class="<%= ui.cardTitle() %>" id="sIdentitas">Identitas</h2>
      <div class="grid items-start gap-4 md:grid-cols-[2fr_1fr]">
        <div class="grid content-start gap-2"><label class="<%= ui.label() %>" for="ni">Nama instansi</label><input id="ni" name="nama_instansi" class="<%= ui.input() %>" value="<%= settings.nama_instansi %>"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="tz">Label zona waktu</label><input id="tz" name="timezone_label" class="<%= ui.input() %>" value="<%= settings.timezone_label %>" maxlength="10" aria-describedby="tzHelp"><p class="text-sm text-muted-foreground" id="tzHelp">Tampil di stempel waktu foto dinas luar.</p></div>
      </div>
    </section>
    <div class="<%= ui.separator() %>"></div>
    <section class="grid gap-3 p-6" aria-labelledby="sHari">
      <h2 class="<%= ui.cardTitle() %>" id="sHari">Hari kerja</h2>
      <p class="text-sm text-muted-foreground">Shift default hanya berlaku di hari yang dicentang dan bukan <a href="/admin/hari-libur">hari libur nasional</a>. Pegawai yang bertugas di luar hari ini (misalnya piket) diatur di <a href="/admin/jadwal">Jadwal shift</a>.</p>
      <% const hk = String(settings.hari_kerja || '').split(',').filter(Boolean).map(Number); %>
      <fieldset class="flex flex-wrap gap-x-5 gap-y-3">
        <legend class="sr-only">Hari kerja</legend>
        <% T.HARI.forEach((h, i) => { %>
          <div class="flex min-h-8 items-center gap-2"><input class="<%= ui.checkbox() %>" type="checkbox" name="hari_kerja" value="<%= i %>" id="hk<%= i %>" <%= hk.includes(i) ? 'checked' : '' %>><label class="<%= ui.label('font-normal') %>" for="hk<%= i %>"><%= h %></label></div>
        <% }) %>
      </fieldset>
    </section>
    <div class="<%= ui.separator() %>"></div>
    <section class="grid gap-4 p-6" aria-labelledby="sWajah">
      <h2 class="<%= ui.cardTitle() %>" id="sWajah">Pengenalan wajah</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="grid content-start gap-2">
          <label class="<%= ui.label() %>" for="th">Ketelitian pencocokan: <b id="thVal" class="tabular"><%= settings.face_threshold %></b></label>
          <input type="range" class="h-6 w-full accent-primary" id="th" name="face_threshold" min="0.3" max="0.7" step="0.01" value="<%= settings.face_threshold %>" oninput="thVal.textContent = this.value" aria-describedby="thHelp">
          <p class="text-sm text-muted-foreground" id="thHelp">Angka lebih kecil berarti lebih ketat. Disarankan 0,45 sampai 0,55.</p>
        </div>
        <div class="grid content-start gap-4">
          <%- sw('liveness', 'liveness', settings.liveness === '1', 'Wajib kedip mata sebelum absen (mencegah absen memakai foto)') %>
          <%- sw('self_checkin', 'self', settings.self_checkin === '1', 'Izinkan pegawai absen wajah dari HP atau laptop sendiri') %>
        </div>
      </div>
    </section>
    <div class="<%= ui.separator() %>"></div>
    <section class="grid gap-4 p-6" aria-labelledby="sLokasi">
      <h2 class="<%= ui.cardTitle() %>" id="sLokasi">Lokasi kantor</h2>
      <p class="text-sm text-muted-foreground">Bila pembatasan radius aktif, absen wajah dari HP hanya diterima di dalam radius kantor. Absen dinas luar tidak dibatasi radius, tetapi wajib menyertakan foto dan GPS.</p>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="lat">Latitude</label><input id="lat" name="office_lat" class="<%= ui.input('tabular') %>" value="<%= settings.office_lat %>" placeholder="-6.175392" inputmode="decimal"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="lng">Longitude</label><input id="lng" name="office_lng" class="<%= ui.input('tabular') %>" value="<%= settings.office_lng %>" placeholder="106.827153" inputmode="decimal"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="rad">Radius (meter)</label><input type="number" id="rad" name="office_radius" class="<%= ui.input() %>" value="<%= settings.office_radius %>" min="10"></div>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <button type="button" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>" id="useHere"><%- ui.icon('locate-fixed') %> Pakai lokasi saya sekarang</button>
          <p id="geoMsg" class="mt-1 text-sm" aria-live="polite"></p>
        </div>
        <%- sw('enforce_geofence', 'geo', settings.enforce_geofence === '1', 'Aktifkan pembatasan radius') %>
      </div>
    </section>
    <div class="<%= ui.cardFooter('border-t py-4 [.border-t]:pt-4') %>"><button class="<%= ui.button() %>">Simpan pengaturan</button></div>
  </form>

  <section class="<%= ui.card() %>" aria-labelledby="logoTitle">
    <div class="<%= ui.cardHeader() %>"><h2 class="<%= ui.cardTitle() %>" id="logoTitle">Logo instansi</h2></div>
    <div class="<%= ui.cardContent('grid gap-3') %>">
      <% if (settings.logo) { %>
        <div class="rounded-lg bg-navy p-3"><img src="/logo?v=<%= encodeURIComponent(settings.logo) %>" alt="Logo saat ini" class="max-h-16 max-w-full rounded-md bg-white p-1"></div>
      <% } else { %>
        <p class="text-sm text-muted-foreground">Belum ada logo. Saat ini hanya nama instansi yang tampil di navigasi dan halaman masuk.</p>
      <% } %>
      <form method="post" action="/admin/pengaturan/logo" enctype="multipart/form-data" class="grid gap-2" data-loading="Mengunggah...">
        <label class="<%= ui.label() %>" for="logoFile"><%= settings.logo ? 'Ganti logo' : 'Unggah logo' %></label>
        <input type="file" id="logoFile" name="logo" class="<%= ui.input('h-auto py-1.5') %>" accept="image/png,image/jpeg,image/webp" required aria-describedby="logoHelp">
        <p class="text-sm text-muted-foreground" id="logoHelp">PNG, JPG, atau WebP, maksimal 1 MB. Logo berlatar transparan atau putih paling rapi.</p>
        <button class="<%= ui.button({}, 'mt-1 w-full') %>">Simpan logo</button>
      </form>
      <% if (settings.logo) { %>
        <form method="post" action="/admin/pengaturan/logo/hapus" data-confirm="Hapus logo instansi?" data-confirm-label="Hapus logo" data-loading="Menghapus...">
          <button class="<%= ui.button({ variant: 'outline-destructive' }, 'w-full') %>">Hapus logo</button>
        </form>
      <% } %>
    </div>
  </section>
</div>
<script>
document.getElementById('useHere').addEventListener('click', () => {
  const msg = document.getElementById('geoMsg');
  if (!navigator.geolocation) { msg.textContent = 'Browser ini tidak mendukung lokasi.'; return; }
  msg.textContent = 'Mengambil lokasi...';
  navigator.geolocation.getCurrentPosition((p) => {
    document.getElementById('lat').value = p.coords.latitude.toFixed(6);
    document.getElementById('lng').value = p.coords.longitude.toFixed(6);
    msg.textContent = `Lokasi terisi (akurasi sekitar ${Math.round(p.coords.accuracy)} m). Tekan Simpan pengaturan.`;
  }, () => { msg.textContent = 'Gagal mengambil lokasi. Izinkan akses lokasi di browser, lalu coba lagi.'; }, { enableHighAccuracy: true });
});
</script>
<%- include('../partials/footer') %>
