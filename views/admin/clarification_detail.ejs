<%- include('../partials/header') %>
<div class="page-head mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <%- include('../partials/breadcrumb', { items: [['/admin/klarifikasi', 'Klarifikasi'], [null, 'Tinjau pengajuan']] }) %>
    <h1 class="text-2xl font-bold tracking-tight">Klarifikasi dari <%= c.nama %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= JENIS[c.jenis] %> untuk <%= T.fmtTanggalIndo(c.tanggal) %></p>
  </div>
</div>
<div class="grid items-start gap-6 lg:grid-cols-2">
  <div class="grid gap-6">
    <section class="<%= ui.card() %>" aria-label="Pengajuan">
      <div class="<%= ui.cardHeader() %>" >
        <h2 class="<%= ui.cardTitle() %>"><%= c.nama %></h2>
        <p class="<%= ui.cardDescription() %>"><%= [c.nip, c.jabatan, c.unit_kerja].filter(Boolean).join(' · ') %></p>
        <div data-slot="card-action" class="<%= ui.cardAction() %>"><span class="<%= ui.statusBadge(c.status) %>"><%= STATUS_KLARIFIKASI[c.status] %></span></div>
      </div>
      <div class="<%= ui.cardContent() %>">
        <dl class="grid gap-x-4 gap-y-3 text-sm sm:grid-cols-[10rem_1fr]">
          <dt class="text-muted-foreground">Tanggal absen</dt><dd><%= T.fmtTanggalIndo(c.tanggal) %></dd>
          <dt class="text-muted-foreground">Jenis</dt><dd><%= JENIS[c.jenis] %></dd>
          <% if (c.jam_masuk_usulan) { %><dt class="text-muted-foreground">Jam masuk</dt><dd class="tabular"><%= c.jam_masuk_usulan %></dd><% } %>
          <% if (c.jam_pulang_usulan) { %><dt class="text-muted-foreground">Jam pulang</dt><dd class="tabular"><%= c.jam_pulang_usulan %></dd><% } %>
          <dt class="text-muted-foreground">Alasan</dt><dd class="whitespace-pre-wrap"><%= c.alasan %></dd>
          <dt class="text-muted-foreground">Diajukan</dt><dd><%= T.fmtTglPendek(c.created_at.slice(0, 10)) %>, <%= c.created_at.slice(11, 16) %></dd>
          <% if (c.lampiran) { %>
            <dt class="text-muted-foreground">Lampiran</dt>
            <dd>
              <% if (/\.(jpg|png)$/i.test(c.lampiran)) { %><a href="/uploads/<%= c.lampiran %>" target="_blank" rel="noopener"><img src="/uploads/<%= c.lampiran %>" class="w-full max-w-60 rounded-lg border" alt="Lampiran"></a>
              <% } else { %><a href="/uploads/<%= c.lampiran %>" target="_blank" rel="noopener">Buka lampiran</a><% } %>
            </dd>
          <% } %>
          <% if (c.status !== 'menunggu') { %>
            <dt class="text-muted-foreground">Diproses</dt><dd><%= c.reviewed_at %> oleh <%= c.reviewer || '-' %></dd>
            <dt class="text-muted-foreground">Catatan admin</dt><dd><%= c.catatan_admin || '-' %></dd>
          <% } %>
        </dl>
      </div>
    </section>
    <section class="<%= ui.card() %>" aria-label="Data absensi saat ini">
      <div class="<%= ui.cardHeader() %>"><h2 class="<%= ui.cardTitle() %>">Data absensi saat ini</h2></div>
      <div class="<%= ui.cardContent('grid gap-2 text-sm') %>">
        <p>Jadwal: <%= libur ? 'Libur' : shift ? `${shift.nama}, ${shift.jam_masuk} sampai ${shift.jam_pulang}` : 'Tanpa shift' %></p>
        <% if (rec) { %>
          <p>Masuk: <b class="tabular"><%= rec.jam_masuk ? rec.jam_masuk.slice(11, 16) : 'belum ada' %></b> · Pulang: <b class="tabular"><%= rec.jam_pulang ? rec.jam_pulang.slice(11, 16) : 'belum ada' %></b></p>
          <p class="flex flex-wrap items-center gap-2">Status: <%- include('../partials/status_badge', { status: rec.status }) %> <% if (rec.terlambat_menit) { %>terlambat <%= rec.terlambat_menit %> menit<% } %></p>
          <a href="/admin/absensi/<%= rec.id %>">Lihat detail absensi</a>
        <% } else { %><p class="text-muted-foreground">Tidak ada catatan absensi pada tanggal ini.</p><% } %>
      </div>
    </section>
  </div>
  <% if (c.status === 'menunggu') { %>
  <form method="post" action="/admin/klarifikasi/<%= c.id %>/proses" class="<%= ui.card('border-primary/50') %>" data-loading="Memproses...">
    <div class="<%= ui.cardHeader() %>">
      <h2 class="<%= ui.cardTitle() %>">Keputusan</h2>
      <p class="<%= ui.cardDescription() %>">Bila disetujui, absensi tanggal <%= T.fmtTglPendek(c.tanggal) %> disimpan sesuai isian di bawah. Isian sudah diisi dari usulan pegawai.</p>
    </div>
    <div class="<%= ui.cardContent('grid gap-4') %>">
      <div class="grid grid-cols-2 gap-3">
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="kjm">Jam masuk</label><input type="time" id="kjm" name="jam_masuk" class="<%= ui.input() %>" value="<%= proposal.jam_masuk %>"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="kjp">Jam pulang</label><input type="time" id="kjp" name="jam_pulang" class="<%= ui.input() %>" value="<%= proposal.jam_pulang %>"></div>
      </div>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="kst">Status absensi</label>
        <div class="<%= ui.selectWrap() %>"><select id="kst" name="status" class="<%= ui.select() %>">
          <% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= proposal.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select><%- ui.icon('chevron-down', ui.selectIcon) %></div>
      </div>
      <div class="flex items-start gap-3">
        <input class="<%= ui.checkbox('mt-0.5') %>" type="checkbox" name="dispensasi" value="1" id="disp" <%= proposal.dispensasi ? 'checked' : '' %>>
        <label class="<%= ui.label('leading-snug') %>" for="disp">Beri dispensasi: hapus hitungan terlambat dan pulang cepat</label>
      </div>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="kcat">Catatan untuk pegawai (opsional)</label><textarea id="kcat" name="catatan_admin" class="<%= ui.textarea() %>" rows="2"></textarea></div>
    </div>
    <div class="<%= ui.cardFooter('flex-wrap gap-2 border-t') %>">
      <button class="<%= ui.button() %>" name="aksi" value="setujui"><%- ui.icon('check') %> Setujui dan perbarui absensi</button>
      <button class="<%= ui.button({ variant: 'outline-destructive' }) %>" name="aksi" value="tolak" formnovalidate>Tolak</button>
    </div>
  </form>
  <% } %>
</div>
<%- include('../partials/footer') %>
