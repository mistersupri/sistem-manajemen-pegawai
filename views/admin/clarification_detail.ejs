<%- include('../partials/header') %>
<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h4 mb-0">Detail Klarifikasi</h1>
  <a href="/admin/klarifikasi" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
</div>
<div class="row g-4">
  <div class="col-lg-6">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between"><h2 class="h5"><%= c.nama %></h2><span class="badge klar-<%= c.status %> align-self-start"><%= STATUS_KLARIFIKASI[c.status] %></span></div>
        <div class="text-muted small mb-3"><%= c.nip %> · <%= c.jabatan || '' %> · <%= c.unit_kerja || '' %></div>
        <dl class="row mb-0">
          <dt class="col-sm-4">Tanggal absen</dt><dd class="col-sm-8"><%= T.fmtTanggalIndo(c.tanggal) %></dd>
          <dt class="col-sm-4">Jenis</dt><dd class="col-sm-8"><%= JENIS[c.jenis] %></dd>
          <% if (c.jam_masuk_usulan) { %><dt class="col-sm-4">Jam masuk</dt><dd class="col-sm-8"><%= c.jam_masuk_usulan %></dd><% } %>
          <% if (c.jam_pulang_usulan) { %><dt class="col-sm-4">Jam pulang</dt><dd class="col-sm-8"><%= c.jam_pulang_usulan %></dd><% } %>
          <dt class="col-sm-4">Alasan</dt><dd class="col-sm-8" style="white-space: pre-wrap"><%= c.alasan %></dd>
          <dt class="col-sm-4">Diajukan</dt><dd class="col-sm-8"><%= c.created_at %></dd>
          <% if (c.lampiran) { %>
            <dt class="col-sm-4">Lampiran</dt>
            <dd class="col-sm-8">
              <% if (/\.(jpg|png)$/i.test(c.lampiran)) { %><a href="/uploads/<%= c.lampiran %>" target="_blank"><img src="/uploads/<%= c.lampiran %>" class="photo-thumb" alt="Lampiran"></a>
              <% } else { %><a href="/uploads/<%= c.lampiran %>" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Buka lampiran</a><% } %>
            </dd>
          <% } %>
          <% if (c.status !== 'menunggu') { %>
            <dt class="col-sm-4">Diproses</dt><dd class="col-sm-8"><%= c.reviewed_at %> oleh <%= c.reviewer || '-' %></dd>
            <dt class="col-sm-4">Catatan admin</dt><dd class="col-sm-8"><%= c.catatan_admin || '-' %></dd>
          <% } %>
        </dl>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-header bg-white"><b>Data absensi saat ini</b></div>
      <div class="card-body">
        <p class="mb-1">Jadwal: <%= libur ? 'Libur' : shift ? `${shift.nama} (${shift.jam_masuk}-${shift.jam_pulang})` : 'Tanpa shift' %></p>
        <% if (rec) { %>
          <p class="mb-1">Masuk: <b><%= rec.jam_masuk ? rec.jam_masuk.slice(11, 16) : '-' %></b> · Pulang: <b><%= rec.jam_pulang ? rec.jam_pulang.slice(11, 16) : '-' %></b></p>
          <p class="mb-1">Status: <%- include('../partials/status_badge', { status: rec.status }) %> <% if (rec.terlambat_menit) { %>terlambat <%= rec.terlambat_menit %> menit<% } %></p>
          <a href="/admin/absensi/<%= rec.id %>" class="small">Lihat detail absensi</a>
        <% } else { %><p class="text-muted mb-0">Tidak ada catatan absensi pada tanggal ini.</p><% } %>
      </div>
    </div>
  </div>
  <% if (c.status === 'menunggu') { %>
  <div class="col-lg-6">
    <form method="post" action="/admin/klarifikasi/<%= c.id %>/proses" class="card shadow-sm border-primary">
      <div class="card-header bg-white"><b>Proses Klarifikasi</b></div>
      <div class="card-body">
        <p class="small text-muted">Bila disetujui, data absensi tanggal <%= c.tanggal %> akan disimpan sesuai isian berikut.</p>
        <div class="row g-3">
          <div class="col-6"><label class="form-label">Jam Masuk</label><input type="time" name="jam_masuk" class="form-control" value="<%= proposal.jam_masuk %>"></div>
          <div class="col-6"><label class="form-label">Jam Pulang</label><input type="time" name="jam_pulang" class="form-control" value="<%= proposal.jam_pulang %>"></div>
          <div class="col-12"><label class="form-label">Status Absensi</label>
            <select name="status" class="form-select">
              <% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= proposal.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
            </select>
          </div>
          <div class="col-12 form-check ms-1">
            <input class="form-check-input" type="checkbox" name="dispensasi" value="1" id="disp" <%= proposal.dispensasi ? 'checked' : '' %>>
            <label class="form-check-label" for="disp">Beri dispensasi (hapus hitungan terlambat / pulang cepat)</label>
          </div>
          <div class="col-12"><label class="form-label">Catatan Admin</label><textarea name="catatan_admin" class="form-control" rows="2"></textarea></div>
        </div>
      </div>
      <div class="card-footer bg-white d-flex gap-2">
        <button class="btn btn-success" name="aksi" value="setujui"><i class="bi bi-check-lg"></i> Setujui</button>
        <button class="btn btn-outline-danger" name="aksi" value="tolak" formnovalidate><i class="bi bi-x-lg"></i> Tolak</button>
      </div>
    </form>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
