<%- include('../partials/header') %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Master shift</h1>
    <p class="mt-1 text-sm text-muted-foreground">Jam kerja yang bisa dipakai sebagai shift default pegawai atau di jadwal harian.</p>
  </div>
  <a href="/admin/jadwal" class="<%= ui.button({ variant: 'outline' }) %>">Atur jadwal pegawai</a>
</div>
<div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
  <div>
    <div class="<%= ui.card('gap-0 py-0') %>">
      <div class="<%= ui.tableContainer %>">
        <table class="<%= ui.table('table-stack') %>">
          <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>"><th class="<%= ui.tableHead('pl-6') %>">Shift</th><th class="<%= ui.tableHead() %>">Jam kerja</th><th class="<%= ui.tableHead() %>">Toleransi</th><th class="<%= ui.tableHead() %>">Pegawai</th><th class="<%= ui.tableHead() %>">Status</th><th class="<%= ui.tableHead('pr-6 text-right') %>">Aksi</th></tr></thead>
          <tbody class="<%= ui.tableBody %>">
          <% if (!list.length) { %><tr><td colspan="6"><%- include('../partials/empty', { judul: 'Belum ada shift', alasan: 'Buat shift pertama lewat formulir di samping, misalnya Reguler 07.30 sampai 16.00.' }) %></td></tr><% } %>
          <% list.forEach((s) => { %>
            <tr class="<%= ui.tableRow() %>">
              <td class="<%= ui.tableCell('stack-head pl-6') %>"><span class="shift-chip" style="background: <%= s.warna %>; color: <%= chipText(s.warna) %>"><%= s.kode %></span> <span class="font-medium"><%= s.nama %></span></td>
              <td data-label="Jam kerja" class="<%= ui.tableCell() %>"><%= s.jam_masuk %> sampai <%= s.jam_pulang %><% if (s.jam_pulang <= s.jam_masuk) { %><span class="block text-xs text-muted-foreground">Pulang keesokan hari</span><% } %></td>
              <td data-label="Toleransi" class="<%= ui.tableCell() %>"><%= s.toleransi_menit %> menit</td>
              <td data-label="Pegawai" class="<%= ui.tableCell() %>"><%= s.jumlah_pegawai %></td>
              <td data-label="Status" class="<%= ui.tableCell() %>"><span class="<%= ui.badge({ variant: s.aktif ? 'hadir' : 'netral' }) %>"><%= s.aktif ? 'Aktif' : 'Nonaktif' %></span></td>
              <td class="<%= ui.tableCell('pr-6') %>"><div class="row-actions flex justify-end gap-1.5">
                <a href="/admin/shift?edit=<%= s.id %>" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>">Ubah</a>
                <form method="post" action="/admin/shift/<%= s.id %>/hapus" data-confirm="Hapus shift <%= s.nama %>? Bila sudah dipakai di data absensi, shift hanya dinonaktifkan." data-confirm-label="Hapus shift"><button class="<%= ui.button({ variant: 'outline-destructive', size: 'sm' }) %>" aria-label="Hapus shift <%= s.nama %>">Hapus</button></form>
              </div></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-3 text-sm text-muted-foreground">Terlambat dihitung bila absen masuk melewati jam masuk ditambah toleransi. Shift yang jam pulangnya lebih kecil dari jam masuk dianggap shift malam yang selesai keesokan hari.</p>
  </div>
  <% const e = edit || { warna: '#1d5fa8', toleransi_menit: 10, aktif: 1 }; %>
  <form method="post" action="/admin/shift" class="<%= ui.card('content-start self-start') %>" data-loading="Menyimpan...">
    <div class="<%= ui.cardHeader() %>"><h2 class="<%= ui.cardTitle() %>"><%= edit && edit.id ? `Ubah shift ${edit.kode}` : 'Tambah shift' %></h2></div>
    <div class="<%= ui.cardContent('grid gap-4') %>">
      <% if (errors.length) { %><div data-slot="alert" class="<%= ui.alert('destructive') %>" role="alert"><div class="<%= ui.alertTitle('line-clamp-none') %>"><% errors.forEach((x) => { %><div><%= x %></div><% }) %></div></div><% } %>
      <input type="hidden" name="id" value="<%= e.id || '' %>">
      <div class="grid grid-cols-[1fr_2fr] gap-3">
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="kode">Kode</label><input id="kode" name="kode" class="<%= ui.input('uppercase') %>" value="<%= e.kode || '' %>" required maxlength="10"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="nama">Nama</label><input id="nama" name="nama" class="<%= ui.input() %>" value="<%= e.nama || '' %>" required></div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="jm">Jam masuk</label><input type="time" id="jm" name="jam_masuk" class="<%= ui.input() %>" value="<%= e.jam_masuk || '' %>" required></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="jp">Jam pulang</label><input type="time" id="jp" name="jam_pulang" class="<%= ui.input() %>" value="<%= e.jam_pulang || '' %>" required></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="tol">Toleransi (menit)</label><input type="number" id="tol" min="0" max="240" name="toleransi_menit" class="<%= ui.input() %>" value="<%= e.toleransi_menit %>"></div>
        <div class="grid gap-2"><label class="<%= ui.label() %>" for="warna">Warna penanda</label><input type="color" id="warna" name="warna" class="<%= ui.input('p-1') %>" value="<%= e.warna %>"></div>
      </div>
      <label class="<%= ui.label('min-h-11 font-normal') %>"><input type="checkbox" class="<%= ui.checkbox() %>" name="aktif" value="1" <%= e.aktif ? 'checked' : '' %>> Aktif (bisa dipilih di jadwal)</label>
    </div>
    <div class="<%= ui.cardFooter('gap-2') %>">
      <button class="<%= ui.button() %>">Simpan shift</button>
      <% if (edit) { %><a href="/admin/shift" class="<%= ui.button({ variant: 'outline' }) %>">Batal</a><% } %>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
