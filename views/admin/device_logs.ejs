<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-list-ul"></i> Log Scan Fingerprint</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-success" href="/admin/mesin/log/export?dari=<%= f.dari %>&sampai=<%= f.sampai %>&device_id=<%= f.device_id %>&q=<%= encodeURIComponent(f.q) %>"><i class="bi bi-filetype-csv"></i> Ekspor CSV</a>
    <a href="/admin/mesin" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Mesin</a>
  </div>
</div>
<form class="card card-body shadow-sm mb-3" method="get">
  <div class="row g-2">
    <div class="col-6 col-md-2"><label class="form-label small mb-0">Dari</label><input type="date" name="dari" class="form-control" value="<%= f.dari %>"></div>
    <div class="col-6 col-md-2"><label class="form-label small mb-0">Sampai</label><input type="date" name="sampai" class="form-control" value="<%= f.sampai %>"></div>
    <div class="col-md-3"><label class="form-label small mb-0">Mesin</label>
      <select name="device_id" class="form-select"><option value="">Semua</option>
        <% devices.forEach((d) => { %><option value="<%= d.id %>" <%= f.device_id === d.id ? 'selected' : '' %>><%= d.nama %></option><% }) %>
      </select>
    </div>
    <div class="col-md-3"><label class="form-label small mb-0">ID mesin / nama</label><input name="q" class="form-control" value="<%= f.q %>"></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-secondary w-100"><i class="bi bi-funnel"></i> Filter</button></div>
  </div>
</form>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
      <thead><tr><th>Waktu</th><th>ID Mesin</th><th>Pegawai</th><th>Mesin</th><th>Sumber</th></tr></thead>
      <tbody>
      <% if (!logs.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Tidak ada scan pada rentang ini.</td></tr><% } %>
      <% logs.forEach((l) => { %>
        <tr>
          <td class="text-nowrap"><%= T.HARI[T.parseDateTime(l.waktu).getDay()].slice(0, 3) %>, <%= l.waktu.slice(0, 16) %></td>
          <td class="font-monospace"><%= l.pin %></td>
          <td><% if (l.employee_id) { %><a href="/admin/absensi?q=<%= encodeURIComponent(l.nip) %>&dari=<%= l.waktu.slice(0, 10) %>&sampai=<%= l.waktu.slice(0, 10) %>"><%= l.pegawai %></a>
              <% } else { %><span class="text-warning"><i class="bi bi-exclamation-triangle"></i> <%= l.nama_mesin || 'Belum dipetakan' %></span><% } %></td>
          <td class="small"><%= l.mesin || '-' %></td>
          <td class="small"><%= l.sumber === 'lan' ? 'LAN' : 'File USB' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white small text-muted"><%= logs.length %> scan<%= logs.length >= 2000 ? ' (dibatasi 2000 terbaru; gunakan ekspor CSV untuk semua)' : '' %></div>
</div>
<%- include('../partials/footer') %>
