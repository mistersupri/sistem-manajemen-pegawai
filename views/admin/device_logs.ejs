<%- include('../partials/header') %>
<% const devName = f.device_id && (devices.find((d) => d.id === f.device_id) || {}).nama; %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Log scan fingerprint</h1>
    <p class="mt-1 text-sm text-muted-foreground">Scan mentah dari semua mesin, sebelum diolah menjadi absensi harian.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a class="<%= ui.button({ variant: 'outline' }) %>" href="/admin/mesin/log/export?dari=<%= f.dari %>&sampai=<%= f.sampai %>&device_id=<%= f.device_id %>&q=<%= encodeURIComponent(f.q) %>"><%- ui.icon('download') %> Ekspor CSV</a>
    <a href="/admin/mesin" class="<%= ui.button({ variant: 'outline' }) %>"><%- ui.icon('arrow-left') %> Kembali ke mesin</a>
  </div>
</div>
<details data-collapsible class="<%= ui.card('mb-4 gap-0 py-0') %>">
  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-6 py-3 font-medium [&::-webkit-details-marker]:hidden">
    Periode dan filter
    <span class="flex items-center gap-2 text-right text-sm font-normal text-muted-foreground"><%= [`${T.fmtTglPendek(f.dari, false)} sampai ${T.fmtTglPendek(f.sampai)}`, devName, f.q && `"${f.q}"`].filter(Boolean).join(' · ') %> <%- ui.icon('chevron-down') %></span>
  </summary>
  <form class="grid grid-cols-2 gap-3 border-t px-6 py-4 md:grid-cols-[1fr_1fr_1.5fr_1.5fr_auto] md:items-end" method="get">
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="ld">Dari</label><input type="date" id="ld" name="dari" class="<%= ui.input() %>" value="<%= f.dari %>"></div>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="ls">Sampai</label><input type="date" id="ls" name="sampai" class="<%= ui.input() %>" value="<%= f.sampai %>"></div>
    <div class="col-span-2 grid gap-2 md:col-span-1"><label class="<%= ui.label() %>" for="lm">Mesin</label>
      <div class="<%= ui.selectWrap() %>"><select id="lm" name="device_id" class="<%= ui.select() %>"><option value="">Semua mesin</option>
        <% devices.forEach((d) => { %><option value="<%= d.id %>" <%= f.device_id === d.id ? 'selected' : '' %>><%= d.nama %></option><% }) %>
      </select><%- ui.icon('chevron-down', ui.selectIcon) %></div>
    </div>
    <div class="col-span-2 grid gap-2 md:col-span-1"><label class="<%= ui.label() %>" for="lq">ID mesin atau nama</label><input id="lq" name="q" class="<%= ui.input() %>" value="<%= f.q %>"></div>
    <button class="<%= ui.button({}, 'col-span-2 md:col-span-1') %>">Terapkan</button>
  </form>
</details>
<div class="<%= ui.card('gap-0 py-0') %>">
  <div class="<%= ui.tableContainer %>">
    <table class="<%= ui.table('table-stack') %>">
      <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>"><th class="<%= ui.tableHead('pl-6') %>">Pegawai</th><th class="<%= ui.tableHead() %>">Waktu scan</th><th class="<%= ui.tableHead() %>">ID mesin</th><th class="<%= ui.tableHead() %>">Mesin</th><th class="<%= ui.tableHead('pr-6') %>">Sumber</th></tr></thead>
      <tbody class="<%= ui.tableBody %>">
      <% if (!logs.length) { %>
        <tr><td colspan="5"><%- include('../partials/empty', { judul: 'Tidak ada scan pada periode ini', alasan: 'Scan masuk setelah data mesin ditarik lewat LAN atau file USB-nya diimpor. Coba perluas periode atau hapus filter.', aksi: [{ href: '/admin/mesin', label: 'Tarik atau impor data mesin', utama: true }] }) %></td></tr>
      <% } %>
      <% logs.forEach((l) => { %>
        <tr class="<%= ui.tableRow() %>">
          <td class="<%= ui.tableCell('stack-head pl-6') %>"><% if (l.employee_id) { %><a class="font-medium" href="/admin/absensi?q=<%= encodeURIComponent(l.nip) %>&dari=<%= l.waktu.slice(0, 10) %>&sampai=<%= l.waktu.slice(0, 10) %>"><%= l.pegawai %></a>
              <% } else { %><span class="font-medium"><%= l.nama_mesin || 'Tanpa nama' %></span> <a class="inline-flex items-center align-middle max-lg:min-h-11" href="/admin/mesin/pemetaan"><span class="<%= ui.badge({ variant: 'terlambat' }) %>">Belum dipetakan</span></a><% } %></td>
          <td data-label="Waktu scan" class="<%= ui.tableCell('whitespace-nowrap') %>"><%= T.fmtTglPendek(l.waktu.slice(0, 10)) %>, <span class="tabular"><%= l.waktu.slice(11, 16) %></span></td>
          <td data-label="ID mesin" class="<%= ui.tableCell('tabular') %>"><%= l.pin %></td>
          <td data-label="Mesin" class="<%= ui.tableCell() %>"><%= l.mesin || 'Tidak ditentukan' %></td>
          <td data-label="Sumber" class="<%= ui.tableCell('pr-6') %>"><%= l.sumber === 'lan' ? 'LAN' : 'File USB' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="border-t px-6 py-3 text-sm text-muted-foreground"><%= logs.length %> scan<%= logs.length >= 2000 ? '. Hanya 2000 scan terbaru yang ditampilkan; gunakan Ekspor CSV untuk semua.' : '' %></div>
</div>
<%- include('../partials/footer') %>
