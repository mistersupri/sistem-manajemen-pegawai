<%- include('../partials/header') %>
<% const devName = f.device_id && (devices.find((d) => d.id === f.device_id) || {}).nama; %>
<div class="page-head">
  <div>
    <h1>Log scan fingerprint</h1>
    <div class="sub">Scan mentah dari semua mesin, sebelum diolah menjadi absensi harian.</div>
  </div>
  <div class="actions">
    <a class="btn btn-outline-secondary" href="/admin/mesin/log/export?dari=<%= f.dari %>&sampai=<%= f.sampai %>&device_id=<%= f.device_id %>&q=<%= encodeURIComponent(f.q) %>">Ekspor CSV</a>
    <a href="/admin/mesin" class="btn btn-outline-secondary">Kembali ke mesin</a>
  </div>
</div>
<details class="filter-panel">
  <summary>Periode dan filter <span class="ringkas"><%= [`${T.fmtTglPendek(f.dari, false)} sampai ${T.fmtTglPendek(f.sampai)}`, devName, f.q && `"${f.q}"`].filter(Boolean).join(' · ') %></span></summary>
  <form class="filter-body" method="get">
    <div class="row g-2 align-items-end">
      <div class="col-6 col-md-2"><label class="form-label small" for="ld">Dari</label><input type="date" id="ld" name="dari" class="form-control" value="<%= f.dari %>"></div>
      <div class="col-6 col-md-2"><label class="form-label small" for="ls">Sampai</label><input type="date" id="ls" name="sampai" class="form-control" value="<%= f.sampai %>"></div>
      <div class="col-md-3"><label class="form-label small" for="lm">Mesin</label>
        <select id="lm" name="device_id" class="form-select"><option value="">Semua mesin</option>
          <% devices.forEach((d) => { %><option value="<%= d.id %>" <%= f.device_id === d.id ? 'selected' : '' %>><%= d.nama %></option><% }) %>
        </select>
      </div>
      <div class="col-md-3"><label class="form-label small" for="lq">ID mesin atau nama</label><input id="lq" name="q" class="form-control" value="<%= f.q %>"></div>
      <div class="col-md-2"><button class="btn btn-primary w-100">Terapkan</button></div>
    </div>
  </form>
</details>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Pegawai</th><th>Waktu scan</th><th>ID mesin</th><th>Mesin</th><th>Sumber</th></tr></thead>
      <tbody>
      <% if (!logs.length) { %>
        <tr class="empty-row"><td colspan="5"><%- include('../partials/empty', { judul: 'Tidak ada scan pada periode ini', alasan: 'Scan masuk setelah data mesin ditarik lewat LAN atau file USB-nya diimpor. Coba perluas periode atau hapus filter.', aksi: [{ href: '/admin/mesin', label: 'Tarik atau impor data mesin', utama: true }] }) %></td></tr>
      <% } %>
      <% logs.forEach((l) => { %>
        <tr>
          <td class="stack-head"><% if (l.employee_id) { %><a class="fw-semibold" href="/admin/absensi?q=<%= encodeURIComponent(l.nip) %>&dari=<%= l.waktu.slice(0, 10) %>&sampai=<%= l.waktu.slice(0, 10) %>"><%= l.pegawai %></a>
              <% } else { %><span class="fw-semibold"><%= l.nama_mesin || 'Tanpa nama' %></span> <a class="badge status-terlambat text-decoration-none" href="/admin/mesin/pemetaan">Belum dipetakan</a><% } %></td>
          <td data-label="Waktu scan" class="text-nowrap"><%= T.fmtTglPendek(l.waktu.slice(0, 10)) %>, <span class="num"><%= l.waktu.slice(11, 16) %></span></td>
          <td data-label="ID mesin" class="num"><%= l.pin %></td>
          <td data-label="Mesin" class="small"><%= l.mesin || 'Tidak ditentukan' %></td>
          <td data-label="Sumber" class="small"><%= l.sumber === 'lan' ? 'LAN' : 'File USB' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-footer small text-muted"><%= logs.length %> scan<%= logs.length >= 2000 ? '. Hanya 2000 scan terbaru yang ditampilkan; gunakan Ekspor CSV untuk semua.' : '' %></div>
</div>
<%- include('../partials/footer') %>
