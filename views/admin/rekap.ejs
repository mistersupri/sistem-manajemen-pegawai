<%- include('../partials/header') %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Rekap per pegawai</h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= T.fmtTglPendek(f.dari) %> sampai <%= T.fmtTglPendek(f.sampai) %> · diurutkan dari tanpa keterangan terbanyak</p>
  </div>
  <%- include('_export_menu') %>
</div>
<%- include('_filter', { showStatus: false }) %>
<% const sorted = [...rows].sort((a, b) => b.tanpa_keterangan - a.tanpa_keterangan || b.total_terlambat - a.total_terlambat); %>
<div class="<%= ui.card('gap-0 py-0') %>">
  <div class="<%= ui.tableContainer %>">
    <table class="<%= ui.table('table-stack') %>">
      <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>">
        <th class="<%= ui.tableHead('pl-6') %>">Pegawai</th><th class="<%= ui.tableHead() %>">Kehadiran</th><th class="<%= ui.tableHead() %>">Tanpa keterangan</th><th class="<%= ui.tableHead() %>">Terlambat</th><th class="<%= ui.tableHead() %>">Dinas luar</th><th class="<%= ui.tableHead() %>">Izin, sakit, cuti</th><th class="<%= ui.tableHead('pr-6') %>">Tidak absen pulang</th>
      </tr></thead>
      <tbody class="<%= ui.tableBody %>">
      <% if (!sorted.length) { %>
        <tr><td colspan="7"><%- include('../partials/empty', { judul: 'Tidak ada pegawai aktif yang cocok', alasan: 'Rekap hanya menampilkan pegawai aktif. Periksa filter unit atau nama.', aksi: [{ href: '/admin/rekap', label: 'Hapus filter' }] }) %></td></tr>
      <% } %>
      <% sorted.forEach((r) => { %>
        <tr class="<%= ui.tableRow() %>">
          <td class="<%= ui.tableCell('stack-head pl-6') %>"><div class="font-medium"><%= r.nama %></div><div class="text-sm text-muted-foreground"><%= r.unit_kerja || r.nip %></div></td>
          <td data-label="Kehadiran" class="<%= ui.tableCell('min-w-44') %>">
            <div class="flex justify-between text-sm"><span><%= r.total_hadir %> dari <%= r.hari_kerja %> hari</span><b><%= r.persen %>%</b></div>
            <div class="<%= ui.progress('mt-1') %>" role="progressbar" aria-label="Kehadiran <%= r.nama %>" aria-valuenow="<%= r.persen %>" aria-valuemin="0" aria-valuemax="100"><div class="<%= ui.progressBar %>" style="width: <%= Math.min(100, r.persen) %>%"></div></div>
          </td>
          <td data-label="Tanpa keterangan" class="<%= ui.tableCell() %>"><% if (r.tanpa_keterangan) { %><span class="<%= ui.badge({ variant: 'alpa' }) %>"><%= r.tanpa_keterangan %> hari</span><% } else { %>0<% } %></td>
          <td data-label="Terlambat" class="<%= ui.tableCell() %>"><%= r.terlambat %> kali<% if (r.total_terlambat) { %><span class="block text-xs text-muted-foreground"><%= r.total_terlambat %> menit</span><% } %></td>
          <td data-label="Dinas luar" class="<%= ui.tableCell() %>"><%= r.dinas_luar %></td>
          <td data-label="Izin, sakit, cuti" class="<%= ui.tableCell() %>"><%= r.izin + r.sakit + r.cuti %><% if (r.alpa) { %><span class="block text-xs text-muted-foreground">alpa <%= r.alpa %></span><% } %></td>
          <td data-label="Tidak absen pulang" class="<%= ui.tableCell('pr-6') %>"><%= r.tidak_absen_pulang %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="mt-3 text-sm text-muted-foreground">Hari kerja dihitung dari jadwal shift atau shift default di hari kerja, sampai hari ini, tanpa tanggal merah. Tanpa keterangan berarti hari kerja tanpa catatan absensi maupun klarifikasi.</p>
<%- include('../partials/footer') %>
