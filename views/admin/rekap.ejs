<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-bar-chart"></i> Rekap Absensi</h1>
  <%- include('_export_menu') %>
</div>
<%- include('_filter', { showStatus: false }) %>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover table-sm mb-0 text-center">
      <thead><tr><th class="text-start">Pegawai</th><th>Hari Kerja</th><th>Tepat Waktu</th><th>Terlambat</th><th>Dinas Luar</th><th>Izin</th><th>Sakit</th><th>Cuti</th><th>Alpa</th><th>Tanpa Ket.</th><th>Tdk Absen Pulang</th><th>Total Telat</th><th>Kehadiran</th></tr></thead>
      <tbody>
      <% if (!rows.length) { %><tr><td colspan="13" class="text-muted py-4">Tidak ada data.</td></tr><% } %>
      <% rows.forEach((r) => { %>
        <tr>
          <td class="text-start"><div class="fw-semibold"><%= r.nama %></div><div class="small text-muted"><%= r.nip %> · <%= r.unit_kerja %></div></td>
          <td><%= r.hari_kerja %></td><td><%= r.hadir %></td><td><%= r.terlambat %></td><td><%= r.dinas_luar %></td>
          <td><%= r.izin %></td><td><%= r.sakit %></td><td><%= r.cuti %></td><td><%= r.alpa %></td>
          <td class="<%= r.tanpa_keterangan ? 'text-danger fw-bold' : '' %>"><%= r.tanpa_keterangan %></td>
          <td><%= r.tidak_absen_pulang %></td>
          <td><%= r.total_terlambat %>m</td>
          <td><div class="progress" style="height: 18px; min-width: 80px"><div class="progress-bar <%= r.persen >= 90 ? 'bg-success' : r.persen >= 75 ? 'bg-warning' : 'bg-danger' %>" style="width: <%= Math.min(100, r.persen) %>%"><%= r.persen %>%</div></div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="small text-muted mt-2">Hari kerja dihitung dari jadwal shift (atau shift default) sampai hari ini. "Tanpa Ket." = hari kerja tanpa catatan absensi maupun klarifikasi.</p>
<%- include('../partials/footer') %>
