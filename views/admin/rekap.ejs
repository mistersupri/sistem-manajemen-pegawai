<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Rekap per pegawai</h1>
    <div class="sub"><%= T.fmtTglPendek(f.dari) %> sampai <%= T.fmtTglPendek(f.sampai) %> · diurutkan dari tanpa keterangan terbanyak</div>
  </div>
  <div class="actions"><%- include('_export_menu') %></div>
</div>
<%- include('_filter', { showStatus: false }) %>
<% const sorted = [...rows].sort((a, b) => b.tanpa_keterangan - a.tanpa_keterangan || b.total_terlambat - a.total_terlambat); %>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Pegawai</th><th>Kehadiran</th><th>Tanpa keterangan</th><th>Terlambat</th><th>Dinas luar</th><th>Izin, sakit, cuti</th><th>Tidak absen pulang</th></tr></thead>
      <tbody>
      <% if (!sorted.length) { %>
        <tr class="empty-row"><td colspan="7"><%- include('../partials/empty', { judul: 'Tidak ada pegawai aktif yang cocok', alasan: 'Rekap hanya menampilkan pegawai aktif. Periksa filter unit atau nama.', aksi: [{ href: '/admin/rekap', label: 'Hapus filter' }] }) %></td></tr>
      <% } %>
      <% sorted.forEach((r) => { %>
        <tr>
          <td class="stack-head"><div class="fw-semibold"><%= r.nama %></div><span class="cell-sub"><%= r.unit_kerja || r.nip %></span></td>
          <td data-label="Kehadiran" style="min-width: 160px">
            <div class="d-flex justify-content-between small num"><span><%= r.total_hadir %> dari <%= r.hari_kerja %> hari</span><b><%= r.persen %>%</b></div>
            <div class="progress mt-1" role="progressbar" aria-label="Kehadiran <%= r.nama %>" aria-valuenow="<%= r.persen %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: <%= Math.min(100, r.persen) %>%"></div></div>
          </td>
          <td data-label="Tanpa keterangan" class="num"><% if (r.tanpa_keterangan) { %><span class="badge status-alpa"><%= r.tanpa_keterangan %> hari</span><% } else { %>0<% } %></td>
          <td data-label="Terlambat" class="num"><%= r.terlambat %> kali<% if (r.total_terlambat) { %><span class="cell-sub"><%= r.total_terlambat %> menit</span><% } %></td>
          <td data-label="Dinas luar" class="num"><%= r.dinas_luar %></td>
          <td data-label="Izin, sakit, cuti" class="num"><%= r.izin + r.sakit + r.cuti %><% if (r.alpa) { %><span class="cell-sub">alpa <%= r.alpa %></span><% } %></td>
          <td data-label="Tidak absen pulang" class="num"><%= r.tidak_absen_pulang %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="small text-muted mt-3">Hari kerja dihitung dari jadwal shift atau shift default di hari kerja, sampai hari ini, tanpa tanggal merah. Tanpa keterangan berarti hari kerja tanpa catatan absensi maupun klarifikasi.</p>
<%- include('../partials/footer') %>
