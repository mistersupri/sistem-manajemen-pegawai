<form class="card card-body shadow-sm mb-3" method="get">
  <div class="row g-2">
    <div class="col-6 col-md-2"><label class="form-label small mb-0">Dari</label><input type="date" name="dari" class="form-control" value="<%= f.dari %>"></div>
    <div class="col-6 col-md-2"><label class="form-label small mb-0">Sampai</label><input type="date" name="sampai" class="form-control" value="<%= f.sampai %>"></div>
    <div class="col-md-2"><label class="form-label small mb-0">Unit</label>
      <select name="unit" class="form-select"><option value="">Semua</option>
        <% units.forEach((u) => { %><option <%= f.unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </div>
    <% if (typeof showStatus !== 'undefined' && showStatus) { %>
    <div class="col-md-2"><label class="form-label small mb-0">Status</label>
      <select name="status" class="form-select"><option value="">Semua</option>
        <% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-md-2"><label class="form-label small mb-0">Pegawai</label><input name="q" class="form-control" placeholder="Nama / NIP" value="<%= f.q %>"></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-secondary w-100"><i class="bi bi-funnel"></i> Filter</button></div>
  </div>
</form>
