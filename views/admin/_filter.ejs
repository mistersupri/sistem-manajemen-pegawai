<% const ringkas = [`${T.fmtTglPendek(f.dari, false)} sampai ${T.fmtTglPendek(f.sampai)}`, f.unit, f.status && STATUS_LABEL[f.status], f.q && `"${f.q}"`].filter(Boolean).join(' · '); %>
<details data-collapsible class="<%= ui.card('mb-4 gap-0 py-0') %>">
  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-6 py-3 font-medium [&::-webkit-details-marker]:hidden">
    Periode dan filter <span class="flex items-center gap-2 text-right text-sm font-normal text-muted-foreground"><%= ringkas %> <%- ui.icon('chevron-down') %></span>
  </summary>
  <form method="get" class="grid gap-3 border-t px-6 py-4 sm:grid-cols-2 lg:items-end <%= typeof showStatus !== 'undefined' && showStatus ? 'lg:grid-cols-[1fr_1fr_1.2fr_1fr_1.2fr_auto]' : 'lg:grid-cols-[1fr_1fr_1.2fr_1.2fr_auto]' %>">
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="fdari">Dari</label><input type="date" id="fdari" name="dari" class="<%= ui.input() %>" value="<%= f.dari %>"></div>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="fsampai">Sampai</label><input type="date" id="fsampai" name="sampai" class="<%= ui.input() %>" value="<%= f.sampai %>"></div>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="funit">Unit</label>
      <div class="<%= ui.selectWrap() %>"><select id="funit" name="unit" class="<%= ui.select() %>"><option value="">Semua unit</option><% units.forEach((u) => { %><option <%= f.unit === u ? 'selected' : '' %>><%= u %></option><% }) %></select><%- ui.icon('chevron-down', ui.selectIcon) %></div>
    </div>
    <% if (typeof showStatus !== 'undefined' && showStatus) { %>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="fstatus">Status</label>
      <div class="<%= ui.selectWrap() %>"><select id="fstatus" name="status" class="<%= ui.select() %>"><option value="">Semua status</option><% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= v %></option><% }) %></select><%- ui.icon('chevron-down', ui.selectIcon) %></div>
    </div>
    <% } %>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="fq">Pegawai</label><div class="relative"><%- ui.icon('search', ui.searchIcon) %><input type="search" id="fq" name="q" class="<%= ui.searchInput() %>" placeholder="Nama atau NIP" value="<%= f.q %>"></div></div>
    <button class="<%= ui.button() %>">Terapkan</button>
  </form>
</details>
