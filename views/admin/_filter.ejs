<% const ringkas = [`${T.fmtTglPendek(f.dari, false)} sampai ${T.fmtTglPendek(f.sampai)}`, f.unit, f.status && STATUS_LABEL[f.status], f.q && `"${f.q}"`].filter(Boolean).join(' · '); %>
<details class="filter-panel">
  <summary>Periode dan filter <span class="ringkas"><%= ringkas %></span></summary>
  <form class="filter-body" method="get">
    <div class="row g-2 align-items-end">
      <div class="col-6 col-md-2"><label class="form-label small" for="fdari">Dari</label><input type="date" id="fdari" name="dari" class="form-control" value="<%= f.dari %>"></div>
      <div class="col-6 col-md-2"><label class="form-label small" for="fsampai">Sampai</label><input type="date" id="fsampai" name="sampai" class="form-control" value="<%= f.sampai %>"></div>
      <div class="col-md-2"><label class="form-label small" for="funit">Unit</label>
        <select id="funit" name="unit" class="form-select"><option value="">Semua unit</option>
          <% units.forEach((u) => { %><option <%= f.unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
        </select>
      </div>
      <% if (typeof showStatus !== 'undefined' && showStatus) { %>
      <div class="col-md-2"><label class="form-label small" for="fstatus">Status</label>
        <select id="fstatus" name="status" class="form-select"><option value="">Semua status</option>
          <% Object.entries(STATUS_LABEL).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
      </div>
      <% } %>
      <div class="col-md-2"><label class="form-label small" for="fq">Pegawai</label><input id="fq" name="q" class="form-control" placeholder="Nama atau NIP" value="<%= f.q %>"></div>
      <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary flex-fill">Terapkan</button>
      </div>
    </div>
  </form>
</details>
