<%- include('../partials/header') %>
<% const filtered = f.unit || f.status || f.q; %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Data absensi</h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= records.length %> catatan · <%= T.fmtTglPendek(f.dari) %> sampai <%= T.fmtTglPendek(f.sampai) %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/absensi/input" class="<%= ui.button({ variant: 'outline' }) %>">Input manual</a>
    <%- include('_export_menu') %>
  </div>
</div>
<%- include('_filter', { showStatus: true }) %>
<div class="<%= ui.card('gap-0 py-0') %>">
  <div class="<%= ui.tableContainer %>">
    <table class="<%= ui.table('table-stack') %>">
      <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>">
        <th class="<%= ui.tableHead('pl-6') %>">Pegawai</th><th class="<%= ui.tableHead() %>">Tanggal</th><th class="<%= ui.tableHead() %>">Masuk</th><th class="<%= ui.tableHead() %>">Pulang</th><th class="<%= ui.tableHead() %>">Status</th><th class="<%= ui.tableHead() %>">Keterangan</th><th class="<%= ui.tableHead('pr-6') %>"><span class="sr-only">Aksi</span></th>
      </tr></thead>
      <tbody class="<%= ui.tableBody %>">
      <% if (!records.length) { %>
        <tr><td colspan="7">
          <% if (filtered) { %>
            <%- include('../partials/empty', { judul: 'Tidak ada absensi yang cocok dengan filter', alasan: 'Periode sudah benar? Coba hapus filter unit, status, atau nama pegawai.', aksi: [{ href: `/admin/absensi?dari=${f.dari}&sampai=${f.sampai}`, label: 'Hapus filter, tetap di periode ini' }] }) %>
          <% } else { %>
            <%- include('../partials/empty', { judul: 'Belum ada absensi pada periode ini', alasan: 'Absensi masuk dari kiosk wajah, HP pegawai, atau mesin fingerprint. Data mesin USB perlu diimpor dulu.', aksi: [{ href: '/admin/mesin', label: 'Impor data mesin', utama: true }, { href: '/admin/absensi/input', label: 'Input manual' }] }) %>
          <% } %>
        </td></tr>
      <% } %>
      <% records.forEach((r) => { %>
        <tr class="<%= ui.tableRow() %>">
          <td class="<%= ui.tableCell('stack-head pl-6') %>"><div class="font-medium"><%= r.nama %></div><div class="text-sm text-muted-foreground"><%= r.unit_kerja || r.nip %></div></td>
          <td data-label="Tanggal" class="<%= ui.tableCell('whitespace-nowrap') %>"><%= T.fmtTglPendek(r.tanggal) %><% if (r.shift_kode) { %><span class="block text-xs text-muted-foreground"><%= r.shift_kode %> <%= r.shift_masuk %> sampai <%= r.shift_pulang %></span><% } %></td>
          <td data-label="Masuk" class="<%= ui.tableCell() %>"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %><%- include('../partials/metode', { m: r.metode_masuk }) %></td>
          <td data-label="Pulang" class="<%= ui.tableCell() %>"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %><%- include('../partials/metode', { m: r.metode_pulang }) %></td>
          <td data-label="Status" class="<%= ui.tableCell() %>"><%- include('../partials/status_badge', { status: r.status }) %>
            <% if (r.terlambat_menit) { %><span class="block text-xs text-muted-foreground">telat <%= r.terlambat_menit %> mnt</span><% } %>
            <% if (r.pulang_cepat_menit) { %><span class="block text-xs text-muted-foreground">pulang cepat <%= r.pulang_cepat_menit %> mnt</span><% } %></td>
          <td data-label="Keterangan" class="<%= ui.tableCell('max-w-64 text-sm text-muted-foreground') %>"><%= r.keterangan || '' %></td>
          <td class="<%= ui.tableCell('pr-6') %>"><div class="row-actions flex justify-end gap-1.5">
            <a href="/admin/absensi/<%= r.id %>" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>">Detail</a>
            <a href="/admin/absensi/input?employee_id=<%= r.employee_id %>&tanggal=<%= r.tanggal %>" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>">Koreksi</a>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
