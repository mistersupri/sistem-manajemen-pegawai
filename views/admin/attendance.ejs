<%- include('../partials/header') %>
<% const filtered = f.unit || f.status || f.q; %>
<div class="page-head">
  <div>
    <h1>Data absensi</h1>
    <div class="sub"><%= records.length %> catatan · <%= T.fmtTglPendek(f.dari) %> sampai <%= T.fmtTglPendek(f.sampai) %></div>
  </div>
  <div class="actions">
    <a href="/admin/absensi/input" class="btn btn-outline-secondary">Input manual</a>
    <%- include('_export_menu') %>
  </div>
</div>
<%- include('_filter', { showStatus: true }) %>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Pegawai</th><th>Tanggal</th><th>Masuk</th><th>Pulang</th><th>Status</th><th>Keterangan</th><th class="text-end"><span class="visually-hidden">Aksi</span></th></tr></thead>
      <tbody>
      <% if (!records.length) { %>
        <tr class="empty-row"><td colspan="7">
          <% if (filtered) { %>
            <%- include('../partials/empty', { judul: 'Tidak ada absensi yang cocok dengan filter', alasan: 'Periode sudah benar? Coba hapus filter unit, status, atau nama pegawai.', aksi: [{ href: `/admin/absensi?dari=${f.dari}&sampai=${f.sampai}`, label: 'Hapus filter, tetap di periode ini' }] }) %>
          <% } else { %>
            <%- include('../partials/empty', { judul: 'Belum ada absensi pada periode ini', alasan: 'Absensi masuk dari kiosk wajah, HP pegawai, atau mesin fingerprint. Data mesin USB perlu diimpor dulu.', aksi: [{ href: '/admin/mesin', label: 'Impor data mesin', utama: true }, { href: '/admin/absensi/input', label: 'Input manual' }] }) %>
          <% } %>
        </td></tr>
      <% } %>
      <% records.forEach((r) => { %>
        <tr>
          <td class="stack-head"><div class="fw-semibold"><%= r.nama %></div><span class="cell-sub"><%= r.unit_kerja || r.nip %></span></td>
          <td data-label="Tanggal" class="text-nowrap"><%= T.fmtTglPendek(r.tanggal) %><% if (r.shift_kode) { %><span class="cell-sub num"><%= r.shift_kode %> <%= r.shift_masuk %> sampai <%= r.shift_pulang %></span><% } %></td>
          <td data-label="Masuk" class="jam"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %><%- include('../partials/metode', { m: r.metode_masuk }) %></td>
          <td data-label="Pulang" class="jam"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %><%- include('../partials/metode', { m: r.metode_pulang }) %></td>
          <td data-label="Status"><%- include('../partials/status_badge', { status: r.status }) %>
            <% if (r.terlambat_menit) { %><span class="cell-sub num">telat <%= r.terlambat_menit %> mnt</span><% } %>
            <% if (r.pulang_cepat_menit) { %><span class="cell-sub num">pulang cepat <%= r.pulang_cepat_menit %> mnt</span><% } %></td>
          <td data-label="Keterangan" class="small text-muted" style="max-width: 260px"><%= r.keterangan || '' %></td>
          <td><div class="row-actions">
            <a href="/admin/absensi/<%= r.id %>" class="btn btn-sm btn-outline-secondary">Detail</a>
            <a href="/admin/absensi/input?employee_id=<%= r.employee_id %>&tanggal=<%= r.tanggal %>" class="btn btn-sm btn-outline-secondary">Koreksi</a>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
