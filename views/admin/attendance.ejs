<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-calendar-check"></i> Data Absensi</h1>
  <div class="d-flex gap-2">
    <a href="/admin/absensi/input" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i> Input Manual</a>
    <%- include('_export_menu') %>
  </div>
</div>
<%- include('_filter', { showStatus: true }) %>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover table-sm mb-0">
      <thead><tr><th>Tanggal</th><th>Pegawai</th><th>Shift</th><th>Masuk</th><th>Pulang</th><th>Status</th><th>Telat / Cepat</th><th>Keterangan</th><th></th></tr></thead>
      <tbody>
      <% if (!records.length) { %><tr><td colspan="9" class="text-center text-muted py-4">Tidak ada data.</td></tr><% } %>
      <% records.forEach((r) => { %>
        <tr>
          <td class="text-nowrap"><%= r.tanggal %><div class="small text-muted"><%= T.HARI[T.parseDateTime(r.tanggal).getDay()] %></div></td>
          <td><div class="fw-semibold"><%= r.nama %></div><div class="small text-muted"><%= r.nip %></div></td>
          <td><% if (r.shift_kode) { %><span class="shift-chip" style="background: <%= r.shift_warna %>"><%= r.shift_kode %></span><div class="small text-muted"><%= r.shift_masuk %>-<%= r.shift_pulang %></div><% } else { %>-<% } %></td>
          <td class="text-nowrap"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %>
            <% if (r.metode_masuk === 'dinas_luar') { %><i class="bi bi-geo-alt-fill text-info" title="Foto GPS dinas luar"></i><% } else if (r.metode_masuk === 'wajah') { %><i class="bi bi-person-bounding-box text-success" title="Pengenalan wajah"></i><% } else if (r.metode_masuk) { %><i class="bi bi-pencil text-muted" title="<%= METODE_LABEL[r.metode_masuk] %>"></i><% } %></td>
          <td class="text-nowrap"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %>
            <% if (r.metode_pulang === 'dinas_luar') { %><i class="bi bi-geo-alt-fill text-info"></i><% } else if (r.metode_pulang === 'wajah') { %><i class="bi bi-person-bounding-box text-success"></i><% } else if (r.metode_pulang) { %><i class="bi bi-pencil text-muted"></i><% } %></td>
          <td><%- include('../partials/status_badge', { status: r.status }) %></td>
          <td class="small"><%= r.terlambat_menit ? `+${r.terlambat_menit}m` : '' %> <%= r.pulang_cepat_menit ? `-${r.pulang_cepat_menit}m` : '' %></td>
          <td class="small text-muted" style="max-width: 260px"><%= r.keterangan || '' %></td>
          <td class="text-nowrap"><a href="/admin/absensi/<%= r.id %>" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a>
            <a href="/admin/absensi/input?employee_id=<%= r.employee_id %>&tanggal=<%= r.tanggal %>" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white small text-muted"><%= records.length %> data</div>
</div>
<%- include('../partials/footer') %>
