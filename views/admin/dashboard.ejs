<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Absensi hari ini</h1>
    <div class="sub"><%= T.fmtTanggalIndo(today) %></div>
  </div>
  <div class="actions">
    <a href="/admin/absensi/export?dari=<%= today %>&sampai=<%= today %>" class="btn btn-outline-secondary">Unduh Excel hari ini</a>
  </div>
</div>

<section class="card mb-4" aria-labelledby="ringkasan">
  <div class="card-body">
    <h2 id="ringkasan" class="visually-hidden">Ringkasan</h2>
    <% if (!totalAktif) { %>
      <%- include('../partials/empty', { judul: 'Belum ada data pegawai', alasan: 'Tambahkan pegawai atau impor dari Excel. Pegawai dari mesin fingerprint juga bisa dibuat lewat menu Mesin.', aksi: [{ href: '/admin/pegawai/baru', label: 'Tambah pegawai', utama: true }, { href: '/admin/pegawai', label: 'Impor dari Excel' }] }) %>
    <% } else if (!terjadwal) { %>
      <p class="mb-0">Hari ini libur untuk semua pegawai (<%= libur %> orang). Tidak ada yang dijadwalkan bekerja.</p>
    <% } else { %>
      <div class="summary-line mb-3">
        <div><span class="big num"><%= hadirCount %></span> <span class="text-muted">dari <%= terjadwal %> pegawai terjadwal sudah hadir</span></div>
        <div class="item text-muted"><b class="text-body num"><%= counts.terlambat %></b> terlambat</div>
        <div class="item text-muted"><b class="text-body num"><%= counts.dinas_luar %></b> dinas luar</div>
        <div class="item text-muted"><b class="text-body num"><%= counts.izin + counts.sakit + counts.cuti %></b> izin, sakit, cuti</div>
        <% if (libur) { %><div class="item text-muted"><b class="text-body num"><%= libur %></b> libur</div><% } %>
      </div>
      <div class="progress" role="progressbar" aria-label="Kehadiran hari ini" aria-valuenow="<%= hadirCount %>" aria-valuemin="0" aria-valuemax="<%= terjadwal %>">
        <div class="progress-bar" style="width: <%= Math.round(hadirCount / terjadwal * 100) %>%"></div>
      </div>
    <% } %>
  </div>
</section>

<% if (mesinGagal.length) { %>
  <div class="alert alert-danger" role="alert">
    <b>Tarik data mesin gagal:</b>
    <% mesinGagal.forEach((m, i) => { %><%= i ? ', ' : '' %><%= m.nama %> (<%= m.last_sync_status %>)<% }) %>.
    Scan dari mesin ini belum masuk ke absensi. <a href="/admin/mesin" class="alert-link">Periksa koneksi mesin</a>.
  </div>
<% } %>

<div class="row g-4 mb-4 attention">
  <div class="col-lg-5">
    <section class="card h-100" aria-labelledby="belum">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2 id="belum">Belum absen</h2><span class="count"><%= belumAbsen.length %></span>
      </div>
      <% if (!belumAbsen.length) { %>
        <div class="card-body text-muted"><%= terjadwal ? 'Semua pegawai yang terjadwal hari ini sudah tercatat.' : 'Tidak ada pegawai yang terjadwal hari ini.' %></div>
      <% } else { %>
      <ul class="list-group list-group-flush" style="max-height: 420px; overflow-y: auto" tabindex="0" aria-label="Daftar pegawai yang belum absen">
        <% belumAbsen.forEach((e) => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <div><div class="fw-semibold"><%= e.nama %></div><span class="cell-sub"><%= e.unit_kerja || 'Unit belum diisi' %></span></div>
            <span class="text-muted small text-nowrap jam"><%= e.shift ? `${e.shift.kode} mulai ${e.shift.jam_masuk}` : 'Tanpa shift' %></span>
          </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </div>
  <div class="col-lg-7 d-flex flex-column gap-4">
    <section class="card" aria-labelledby="klar">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2 id="klar">Klarifikasi menunggu persetujuan</h2>
        <% if (pending) { %><span class="nav-count"><%= pending %></span><% } %>
      </div>
      <% if (!klarifikasi.length) { %>
        <div class="card-body text-muted">Tidak ada klarifikasi yang menunggu.</div>
      <% } else { %>
        <ul class="list-group list-group-flush">
          <% klarifikasi.forEach((c) => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
              <div><div class="fw-semibold"><%= c.nama %></div><span class="cell-sub"><%= JENIS[c.jenis] %> · untuk <%= T.fmtTglPendek(c.tanggal, false) %></span></div>
              <a class="btn btn-sm btn-primary" href="/admin/klarifikasi/<%= c.id %>">Tinjau</a>
            </li>
          <% }) %>
        </ul>
        <% if (pending > klarifikasi.length) { %><div class="card-footer"><a href="/admin/klarifikasi">Lihat semua <%= pending %> klarifikasi</a></div><% } %>
      <% } %>
    </section>
    <% if (tanpaWajah) { %>
      <div class="alert alert-warning mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span><b><%= tanpaWajah %></b> pegawai aktif belum mendaftarkan wajah, jadi belum bisa absen di kiosk atau HP.</span>
        <a href="/admin/pegawai?wajah=belum" class="btn btn-sm btn-outline-secondary">Lihat daftarnya</a>
      </div>
    <% } %>
  </div>
</div>

<section class="card" aria-labelledby="tercatat">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 id="tercatat" class="h6 mb-0">Sudah tercatat hari ini</h2>
    <span class="dayline-scale d-none d-md-flex" style="width: 220px" aria-hidden="true"><span>05.00</span><span>13.30</span><span>22.00</span></span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Pegawai</th><th>Masuk</th><th>Pulang</th><th>Status</th><th style="width: 240px">Garis hari kerja</th><th><span class="visually-hidden">Aksi</span></th></tr></thead>
      <tbody>
      <% if (!records.length) { %>
        <tr class="empty-row"><td colspan="6"><%- include('../partials/empty', { judul: 'Belum ada absensi hari ini', alasan: 'Absensi masuk dari kiosk wajah, HP pegawai, atau mesin fingerprint. Untuk mesin USB, impor file ekspornya agar data tampil di sini.', aksi: [{ href: '/kiosk', label: 'Buka kiosk wajah', utama: true }, { href: '/admin/mesin', label: 'Tarik atau impor data mesin' }] }) %></td></tr>
      <% } %>
      <% records.forEach((r) => { %>
        <tr>
          <td class="stack-head"><div class="fw-semibold"><%= r.nama %></div><span class="cell-sub"><%= r.unit_kerja || r.nip %></span></td>
          <td data-label="Masuk" class="jam"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %></td>
          <td data-label="Pulang" class="jam"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></td>
          <td data-label="Status"><%- include('../partials/status_badge', { status: r.status }) %><% if (r.terlambat_menit) { %> <span class="small text-muted num"><%= r.terlambat_menit %> mnt</span><% } %></td>
          <td class="stack-hide"><%- include('../partials/dayline', { shiftMasuk: r.shift_masuk, shiftPulang: r.shift_pulang, masuk: r.jam_masuk, pulang: r.jam_pulang, telat: r.terlambat_menit > 0 }) %></td>
          <td class="text-end"><a href="/admin/absensi/<%= r.id %>" class="btn btn-sm btn-outline-secondary">Detail</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
