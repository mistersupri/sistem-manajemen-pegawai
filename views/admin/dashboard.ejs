<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <div>
    <h1 class="h4 mb-0">Dashboard</h1>
    <div class="text-muted"><%= T.fmtTanggalIndo(today) %></div>
  </div>
  <div class="d-flex gap-2">
    <a href="/kiosk" target="_blank" class="btn btn-primary"><i class="bi bi-camera-video"></i> Buka Kiosk Wajah</a>
    <a href="/admin/absensi/export?dari=<%= today %>&sampai=<%= today %>" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Ekspor Hari Ini</a>
  </div>
</div>

<% const cards = [
  ['Pegawai Aktif', totalAktif, 'bi-people', 'primary'],
  ['Hadir Tepat Waktu', counts.hadir, 'bi-check2-circle', 'success'],
  ['Terlambat', counts.terlambat, 'bi-alarm', 'warning'],
  ['Dinas Luar', counts.dinas_luar, 'bi-geo-alt', 'info'],
  ['Izin / Sakit / Cuti', counts.izin + counts.sakit + counts.cuti, 'bi-envelope-paper', 'secondary'],
  ['Belum Absen', belumAbsen.length, 'bi-hourglass-split', 'danger'],
]; %>
<div class="row g-3 mb-4">
  <% cards.forEach(([label, val, icon, color]) => { %>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card shadow-sm border-0 h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="icon bg-<%= color %>-subtle text-<%= color %>"><i class="bi <%= icon %>"></i></div>
        <div><div class="h4 mb-0"><%= val %></div><div class="small text-muted"><%= label %></div></div>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<% if (pending || tanpaWajah) { %>
<div class="row g-3 mb-4">
  <% if (pending) { %>
  <div class="col-md-6"><div class="alert alert-warning mb-0 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-chat-square-text"></i> <b><%= pending %></b> klarifikasi absen menunggu persetujuan.</span>
    <a href="/admin/klarifikasi" class="btn btn-sm btn-warning">Tinjau</a>
  </div></div>
  <% } %>
  <% if (tanpaWajah) { %>
  <div class="col-md-6"><div class="alert alert-info mb-0 d-flex justify-content-between align-items-center">
    <span><i class="bi bi-person-bounding-box"></i> <b><%= tanpaWajah %></b> pegawai aktif belum mendaftarkan wajah.</span>
    <a href="/admin/pegawai" class="btn btn-sm btn-info">Lihat</a>
  </div></div>
  <% } %>
</div>
<% } %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-white"><b>Absensi Hari Ini</b></div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Pegawai</th><th>Shift</th><th>Masuk</th><th>Pulang</th><th>Status</th><th></th></tr></thead>
          <tbody>
          <% if (!records.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Belum ada absensi hari ini.</td></tr><% } %>
          <% records.forEach((r) => { %>
            <tr>
              <td><div class="fw-semibold"><%= r.nama %></div><div class="small text-muted"><%= r.nip %> · <%= r.unit_kerja || '-' %></div></td>
              <td><% if (r.shift_kode) { %><span class="shift-chip" style="background: <%= r.shift_warna %>"><%= r.shift_kode %></span><% } else { %>-<% } %></td>
              <td><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %><% if (r.metode_masuk === 'dinas_luar') { %> <i class="bi bi-geo-alt text-info" title="Dinas luar"></i><% } %></td>
              <td><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></td>
              <td><%- include('../partials/status_badge', { status: r.status }) %><% if (r.terlambat_menit) { %> <small class="text-muted"><%= r.terlambat_menit %>m</small><% } %></td>
              <td><a href="/admin/absensi/<%= r.id %>" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between"><b>Belum Absen</b><span class="text-muted small"><%= libur %> libur</span></div>
      <ul class="list-group list-group-flush" style="max-height: 480px; overflow-y: auto">
        <% if (!belumAbsen.length) { %><li class="list-group-item text-muted text-center py-4">Semua pegawai terjadwal sudah absen.</li><% } %>
        <% belumAbsen.forEach((e) => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div><div><%= e.nama %></div><div class="small text-muted"><%= e.unit_kerja || '-' %></div></div>
            <span class="small text-muted"><%= e.shift ? `${e.shift.kode} ${e.shift.jam_masuk}` : 'Tanpa shift' %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
