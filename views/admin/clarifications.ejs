<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-chat-square-text"></i> Klarifikasi Absen</h1>
  <ul class="nav nav-pills">
    <% [['menunggu', 'Menunggu'], ['disetujui', 'Disetujui'], ['ditolak', 'Ditolak'], ['semua', 'Semua']].forEach(([k, v]) => { %>
      <li class="nav-item"><a class="nav-link <%= (status || 'semua') === k ? 'active' : '' %>" href="?status=<%= k %>"><%= v %></a></li>
    <% }) %>
  </ul>
</div>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Diajukan</th><th>Pegawai</th><th>Tanggal Absen</th><th>Jenis</th><th>Alasan</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% if (!list.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Tidak ada klarifikasi.</td></tr><% } %>
      <% list.forEach((c) => { %>
        <tr>
          <td class="small text-nowrap"><%= c.created_at.slice(0, 16) %></td>
          <td><div class="fw-semibold"><%= c.nama %></div><div class="small text-muted"><%= c.nip %></div></td>
          <td class="text-nowrap"><%= c.tanggal %></td>
          <td><%= JENIS[c.jenis] %><% if (c.lampiran) { %> <i class="bi bi-paperclip" title="Ada lampiran"></i><% } %></td>
          <td class="small" style="max-width: 320px"><%= c.alasan.length > 120 ? c.alasan.slice(0, 120) + '…' : c.alasan %></td>
          <td><span class="badge klar-<%= c.status %>"><%= STATUS_KLARIFIKASI[c.status] %></span></td>
          <td><a href="/admin/klarifikasi/<%= c.id %>" class="btn btn-sm <%= c.status === 'menunggu' ? 'btn-primary' : 'btn-light' %>"><%= c.status === 'menunggu' ? 'Tinjau' : 'Lihat' %></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
