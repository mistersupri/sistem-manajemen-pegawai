<%- include('../partials/header') %>
<% const filtered = query.q || query.unit || query.status || query.wajah; %>
<div class="page-head">
  <div>
    <h1>Pegawai</h1>
    <div class="sub"><%= employees.length %> pegawai<%= filtered ? ' sesuai filter' : '' %></div>
  </div>
  <div class="actions">
    <a href="/admin/pegawai/baru" class="btn btn-primary">Tambah pegawai</a>
    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#importModal">Impor dari Excel</button>
    <div class="btn-group">
      <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Ekspor</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/admin/pegawai/export?format=xlsx">Excel (.xlsx)</a></li>
        <li><a class="dropdown-item" href="/admin/pegawai/export?format=csv">CSV</a></li>
      </ul>
    </div>
  </div>
</div>

<% if (importResult) { %>
  <div class="alert alert-<%= importResult.errors.length ? 'warning' : 'success' %>" role="status">
    <b>Hasil impor:</b> <%= importResult.created %> pegawai baru, <%= importResult.updated %> diperbarui<% if (importResult.errors.length) { %>, <%= importResult.errors.length %> baris gagal:<% } else { %>.<% } %>
    <% if (importResult.errors.length) { %>
      <ul class="mb-0 mt-2 small"><% importResult.errors.slice(0, 50).forEach((e) => { %><li><%= e %></li><% }) %></ul>
    <% } %>
  </div>
<% } %>

<details class="filter-panel">
  <summary>Cari dan filter <span class="ringkas"><%= [query.q && `"${query.q}"`, query.unit, query.status, query.wajah === 'belum' && 'wajah belum terdaftar'].filter(Boolean).join(' · ') || 'Semua pegawai' %></span></summary>
  <form class="filter-body" method="get">
    <div class="row g-2 align-items-end">
      <div class="col-md-4"><label class="form-label small" for="fq">Nama, NIP, atau jabatan</label><input class="form-control" id="fq" name="q" value="<%= query.q || '' %>"></div>
      <div class="col-md-3"><label class="form-label small" for="fu">Unit kerja</label>
        <select class="form-select" id="fu" name="unit">
          <option value="">Semua unit</option>
          <% units.forEach((u) => { %><option <%= query.unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
        </select>
      </div>
      <div class="col-md-2"><label class="form-label small" for="fs">Status</label>
        <select class="form-select" id="fs" name="status">
          <option value="">Semua</option>
          <option value="aktif" <%= query.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="nonaktif" <%= query.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary flex-fill">Terapkan</button>
        <% if (filtered) { %><a class="btn btn-outline-secondary" href="/admin/pegawai">Reset</a><% } %>
      </div>
    </div>
  </form>
</details>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Nama</th><th>NIP / ID mesin</th><th>Jabatan dan unit</th><th>Shift default</th><th>Wajah</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
      <tbody>
      <% if (!employees.length) { %>
        <tr class="empty-row"><td colspan="7">
          <% if (filtered) { %>
            <%- include('../partials/empty', { judul: 'Tidak ada pegawai yang cocok', alasan: 'Coba kata kunci lain atau hapus filter unit dan status.', aksi: [{ href: '/admin/pegawai', label: 'Tampilkan semua pegawai' }] }) %>
          <% } else { %>
            <%- include('../partials/empty', { judul: 'Belum ada data pegawai', alasan: 'Tambahkan satu per satu, impor dari Excel, atau buat dari daftar pengguna mesin fingerprint.', aksi: [{ href: '/admin/pegawai/baru', label: 'Tambah pegawai', utama: true }, { href: '/admin/mesin/pemetaan', label: 'Buat dari data mesin' }] }) %>
          <% } %>
        </td></tr>
      <% } %>
      <% employees.forEach((e) => { %>
        <tr>
          <td class="stack-head"><div class="fw-semibold"><%= e.nama %></div><% if (e.email) { %><span class="cell-sub"><%= e.email %></span><% } %></td>
          <td data-label="NIP / ID mesin" class="num"><%= e.nip %><% if (e.id_mesin) { %><span class="cell-sub">ID mesin <%= e.id_mesin %></span><% } %></td>
          <td data-label="Jabatan dan unit"><%= e.jabatan || '' %><span class="cell-sub"><%= e.unit_kerja || '' %></span><% if (!e.jabatan && !e.unit_kerja) { %><span class="text-muted">Belum diisi</span><% } %></td>
          <td data-label="Shift default"><% if (e.shift_kode) { %><span class="shift-chip" style="background: <%= e.shift_warna %>; color: <%= chipText(e.shift_warna) %>"><%= e.shift_kode %></span> <%= e.shift_nama %><% } else { %><span class="text-muted">Tanpa shift</span><% } %></td>
          <td data-label="Wajah"><% if (e.face_descriptors) { %><span class="badge ok">Terdaftar</span><% } else { %><a href="/admin/pegawai/<%= e.id %>/wajah">Daftarkan</a><% } %></td>
          <td data-label="Status"><span class="badge <%= e.status === 'aktif' ? 'ok' : 'netral' %>"><%= e.status === 'aktif' ? 'Aktif' : 'Nonaktif' %></span></td>
          <td>
            <div class="row-actions">
              <a href="/admin/pegawai/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary">Ubah</a>
              <a href="/admin/pegawai/<%= e.id %>/wajah" class="btn btn-sm btn-outline-secondary">Wajah</a>
              <a href="/admin/absensi?q=<%= encodeURIComponent(e.nip) %>" class="btn btn-sm btn-outline-secondary">Absensi</a>
              <form method="post" action="/admin/pegawai/<%= e.id %>/hapus" data-confirm="Hapus pegawai <%= e.nama %> beserta seluruh data absensinya?">
                <button class="btn btn-sm btn-outline-danger" aria-label="Hapus <%= e.nama %>">Hapus</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importTitle" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/admin/pegawai/import" enctype="multipart/form-data" data-loading="Mengimpor...">
      <div class="modal-header"><h2 class="modal-title h5" id="importTitle">Impor data pegawai</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
      <div class="modal-body">
        <p class="small">Unggah file <b>Excel (.xlsx)</b> atau <b>CSV</b>. NIP yang sudah ada akan diperbarui. NIP baru ditambahkan beserta akun login: username = NIP, password = NIP bila kolom password kosong.</p>
        <p class="small">Unduh template: <a href="/admin/pegawai/template">Excel</a> · <a href="/admin/pegawai/template?format=csv">CSV</a></p>
        <label class="form-label" for="impFile">File</label>
        <input type="file" id="impFile" name="file" class="form-control" accept=".xlsx,.csv" required>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Impor</button></div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
