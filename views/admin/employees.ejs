<%- include('../partials/header') %>
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h1 class="h4 mb-0"><i class="bi bi-people"></i> Data Pegawai</h1>
  <div class="d-flex flex-wrap gap-2">
    <a href="/admin/pegawai/baru" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tambah Pegawai</a>
    <div class="btn-group">
      <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-download"></i> Ekspor</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/admin/pegawai/export?format=xlsx"><i class="bi bi-file-earmark-excel"></i> Excel (.xlsx)</a></li>
        <li><a class="dropdown-item" href="/admin/pegawai/export?format=csv"><i class="bi bi-filetype-csv"></i> CSV</a></li>
      </ul>
    </div>
    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal"><i class="bi bi-upload"></i> Impor</button>
  </div>
</div>

<% if (importResult) { %>
  <div class="alert alert-<%= importResult.errors.length ? 'warning' : 'success' %>">
    <b>Hasil impor:</b> <%= importResult.created %> pegawai baru, <%= importResult.updated %> diperbarui<% if (importResult.errors.length) { %>, <%= importResult.errors.length %> baris gagal:<% } %>.
    <% if (importResult.errors.length) { %>
      <ul class="mb-0 mt-2 small"><% importResult.errors.slice(0, 50).forEach((e) => { %><li><%= e %></li><% }) %></ul>
    <% } %>
  </div>
<% } %>

<form class="card card-body shadow-sm mb-3" method="get">
  <div class="row g-2">
    <div class="col-md-5"><input class="form-control" name="q" placeholder="Cari nama / NIP / jabatan" value="<%= query.q || '' %>"></div>
    <div class="col-md-3">
      <select class="form-select" name="unit">
        <option value="">Semua unit kerja</option>
        <% units.forEach((u) => { %><option <%= query.unit === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select class="form-select" name="status">
        <option value="">Semua status</option>
        <option value="aktif" <%= query.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
        <option value="nonaktif" <%= query.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
      </select>
    </div>
    <div class="col-md-2"><button class="btn btn-secondary w-100"><i class="bi bi-search"></i> Filter</button></div>
  </div>
</form>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>NIP</th><th>Nama</th><th>Jabatan / Unit</th><th>Shift Default</th><th>Wajah</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
      <tbody>
      <% if (!employees.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Belum ada data pegawai.</td></tr><% } %>
      <% employees.forEach((e) => { %>
        <tr>
          <td class="font-monospace small"><%= e.nip %><% if (e.id_mesin) { %><div class="text-muted" title="ID mesin fingerprint"><i class="bi bi-fingerprint"></i> <%= e.id_mesin %></div><% } %></td>
          <td><div class="fw-semibold"><%= e.nama %></div><div class="small text-muted"><%= e.email || '' %></div></td>
          <td><div><%= e.jabatan || '-' %></div><div class="small text-muted"><%= e.unit_kerja || '' %></div></td>
          <td><% if (e.shift_kode) { %><span class="shift-chip" style="background: <%= e.shift_warna %>"><%= e.shift_kode %></span> <small><%= e.shift_nama %></small><% } else { %><span class="text-muted">-</span><% } %></td>
          <td>
            <% if (e.face_descriptors) { %><span class="badge bg-success"><i class="bi bi-check"></i> Terdaftar</span>
            <% } else { %><a href="/admin/pegawai/<%= e.id %>/wajah" class="badge bg-secondary text-decoration-none">Belum</a><% } %>
          </td>
          <td><span class="badge <%= e.status === 'aktif' ? 'bg-primary' : 'bg-light text-dark' %>"><%= e.status %></span></td>
          <td class="text-end text-nowrap">
            <a href="/admin/pegawai/<%= e.id %>/wajah" class="btn btn-sm btn-outline-primary" title="Daftarkan wajah"><i class="bi bi-person-bounding-box"></i></a>
            <a href="/admin/absensi?q=<%= encodeURIComponent(e.nip) %>" class="btn btn-sm btn-outline-secondary" title="Riwayat absensi"><i class="bi bi-calendar-check"></i></a>
            <a href="/admin/pegawai/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Ubah"><i class="bi bi-pencil"></i></a>
            <form method="post" action="/admin/pegawai/<%= e.id %>/hapus" class="d-inline" data-confirm="Hapus pegawai <%= e.nama %> beserta seluruh data absensinya?">
              <button class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white small text-muted">Total: <%= employees.length %> pegawai</div>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/admin/pegawai/import" enctype="multipart/form-data">
      <div class="modal-header"><h5 class="modal-title">Impor Data Pegawai</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p class="small">Unggah file <b>Excel (.xlsx)</b> atau <b>CSV</b>. Pegawai dengan NIP yang sudah ada akan diperbarui, NIP baru akan ditambahkan beserta akun login (username = NIP, password = NIP bila kolom password kosong).</p>
        <p class="small">Unduh template: <a href="/admin/pegawai/template">Excel</a> · <a href="/admin/pegawai/template?format=csv">CSV</a></p>
        <input type="file" name="file" class="form-control" accept=".xlsx,.csv" required>
      </div>
      <div class="modal-footer"><button class="btn btn-primary"><i class="bi bi-upload"></i> Impor</button></div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
