<%- include('../partials/header') %>
<% const chev = ui.icon('chevron-down', ui.selectIcon); %>
<div class="page-head mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <%- include('../partials/breadcrumb', { items: [['/admin/mesin', 'Mesin fingerprint'], [null, 'Pemetaan ID mesin']] }) %>
    <h1 class="text-2xl font-bold tracking-tight">Pemetaan ID mesin ke pegawai</h1>
    <p class="mt-1 text-sm text-muted-foreground">ID pengguna di mesin fingerprint yang belum terhubung ke data pegawai. Scan mereka belum masuk ke absensi.</p>
  </div>
</div>
<% if (!unmatched.length) { %>
  <div class="<%= ui.card('py-0') %>"><%- include('../partials/empty', { judul: 'Semua ID mesin sudah terhubung', alasan: 'Setiap scan dari mesin sudah diproses menjadi absensi pegawai. ID baru akan muncul di sini setelah impor atau tarik data berikutnya.', aksi: [{ href: '/admin/mesin', label: 'Kembali ke mesin' }] }) %></div>
<% } else { %>
<form method="post" action="/admin/mesin/pemetaan" id="mapForm" data-loading="Menyimpan pemetaan..."></form>
<form method="post" action="/admin/mesin/pemetaan/buat" id="createForm" data-confirm="Buat pegawai baru untuk ID mesin yang dicentang?" data-confirm-label="Buat pegawai" data-loading="Membuat pegawai..."></form>
<div data-slot="alert" class="<%= ui.alert('default', 'mb-4') %>"><%- ui.icon('info') %><div data-slot="alert-description" class="<%= ui.alertDescription() %>">Pegawai yang namanya sama persis dengan nama di mesin sudah dipilih otomatis. Periksa dulu sebelum menyimpan. Setelah disimpan, seluruh scan ID tersebut langsung diproses menjadi absensi.</div></div>
<div class="<%= ui.card('gap-0 py-0') %>">
  <div class="<%= ui.tableContainer %>">
    <table class="<%= ui.table('table-stack') %>">
      <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>"><th class="<%= ui.tableHead('w-11 pl-6') %>"><input type="checkbox" class="<%= ui.checkbox() %>" id="checkAll" aria-label="Centang semua ID untuk dibuat sebagai pegawai baru"></th><th class="<%= ui.tableHead() %>">Nama di mesin</th><th class="<%= ui.tableHead() %>">ID mesin</th><th class="<%= ui.tableHead() %>">Departemen</th><th class="<%= ui.tableHead() %>">Scan</th><th class="<%= ui.tableHead('min-w-64 pr-6') %>">Hubungkan ke pegawai</th></tr></thead>
      <tbody class="<%= ui.tableBody %>">
      <% unmatched.forEach((u, i) => {
           const guess = employees.find((e) => !e.id_mesin && u.nama && e.nama.toLowerCase().replace(/[^a-z]/g, '') === u.nama.toLowerCase().replace(/[^a-z]/g, '')); %>
        <tr class="<%= ui.tableRow() %>">
          <td data-label="Buat pegawai baru" class="<%= ui.tableCell('pl-6') %>"><input type="checkbox" class="<%= ui.checkbox('pin-check') %>" name="pins" value="<%= u.pin %>" form="createForm" aria-label="Buat pegawai baru dari ID <%= u.pin %>"></td>
          <td class="<%= ui.tableCell('stack-head font-medium') %>"><%= u.nama || `Tanpa nama (ID ${u.pin})` %></td>
          <td data-label="ID mesin" class="<%= ui.tableCell('tabular') %>"><%= u.pin %></td>
          <td data-label="Departemen" class="<%= ui.tableCell() %>"><%= u.departemen || 'Tidak tercatat' %></td>
          <td data-label="Scan" class="<%= ui.tableCell('tabular') %>"><%= u.jumlah_log %><% if (u.terakhir) { %><span class="block text-xs text-muted-foreground">terakhir <%= T.fmtTglPendek(u.terakhir.slice(0, 10)) %></span><% } %></td>
          <td data-label="Pegawai" class="<%= ui.tableCell('pr-6') %>">
            <input type="hidden" name="map_pin" value="<%= u.pin %>" form="mapForm">
            <label class="sr-only" for="map<%= i %>">Pegawai untuk ID <%= u.pin %></label>
            <div class="<%= ui.selectWrap() %>"><select id="map<%= i %>" name="map_emp" class="<%= ui.select() %>" form="mapForm">
              <option value="">Belum dipilih</option>
              <% employees.filter((e) => !e.id_mesin).forEach((e) => { %>
                <option value="<%= e.id %>" <%= guess && guess.id === e.id ? 'selected' : '' %>><%= e.nama %> (<%= e.nip %>)</option>
              <% }) %>
            </select><%- chev %></div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="flex flex-wrap items-end justify-between gap-4 border-t px-6 py-4">
    <button class="<%= ui.button() %>" form="mapForm">Simpan pemetaan</button>
    <div class="flex flex-wrap items-end gap-2">
      <div class="grid gap-2">
        <label class="<%= ui.label('text-muted-foreground') %>" for="newShift">Belum ada di data pegawai? Buat dari yang dicentang, dengan shift</label>
        <div class="<%= ui.selectWrap() %>"><select id="newShift" name="shift_id" class="<%= ui.select() %>" form="createForm">
          <option value="">Tanpa shift default</option>
          <% shifts.forEach((s) => { %><option value="<%= s.id %>" <%= s.kode === 'REG' ? 'selected' : '' %>><%= s.kode %> (<%= s.jam_masuk %> sampai <%= s.jam_pulang %>)</option><% }) %>
        </select><%- chev %></div>
      </div>
      <button class="<%= ui.button({ variant: 'outline' }) %>" form="createForm"><%- ui.icon('user-plus') %> Buat pegawai baru</button>
    </div>
  </div>
</div>
<script>
document.getElementById('checkAll').addEventListener('change', (e) => {
  document.querySelectorAll('.pin-check').forEach((c) => { c.checked = e.target.checked; });
});
</script>
<% } %>
<%- include('../partials/footer') %>
