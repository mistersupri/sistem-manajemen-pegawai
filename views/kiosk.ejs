<!doctype html>
<html lang="id" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kiosk Absensi · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="min-h-screen">
<% const toggle = 'flex min-h-12 cursor-pointer items-center justify-center rounded-md px-4 text-base font-medium text-muted-foreground transition-colors hover:text-foreground peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:ring-[3px] peer-focus-visible:ring-ring/50'; %>
<div class="mx-auto max-w-7xl px-4 py-4 lg:px-6">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <% if (settings.logo) { %><img src="/logo?v=<%= encodeURIComponent(settings.logo) %>" alt="Logo <%= settings.nama_instansi %>" class="h-12 rounded-lg bg-white p-1"><% } %>
      <div>
        <h1 class="text-xl font-bold tracking-tight">Absensi wajah</h1>
        <p class="text-sm text-muted-foreground"><%= settings.nama_instansi %></p>
      </div>
    </div>
    <div class="text-right">
      <div class="text-3xl font-bold tabular md:text-4xl" id="clock" aria-live="off">--:--:--</div>
      <div class="text-sm text-muted-foreground" id="date"></div>
    </div>
  </div>
  <div class="grid items-start gap-6 lg:grid-cols-[7fr_5fr]">
    <div>
      <fieldset class="mb-3">
        <legend class="sr-only">Jenis absen</legend>
        <div class="grid grid-cols-2 gap-1 rounded-lg bg-muted p-1">
          <div><input type="radio" class="peer sr-only" name="mode" id="mMasuk" value="masuk" checked><label class="<%= toggle %>" for="mMasuk">Absen masuk</label></div>
          <div><input type="radio" class="peer sr-only" name="mode" id="mPulang" value="pulang"><label class="<%= toggle %>" for="mPulang">Absen pulang</label></div>
        </div>
      </fieldset>
      <div class="camera-wrap mirror">
        <video id="video" autoplay muted playsinline></video>
        <canvas class="overlay" id="overlay"></canvas>
        <div class="face-guide"></div>
        <div class="camera-status" id="status" aria-live="polite">Memuat model pengenal wajah...</div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-muted-foreground">
        <span><%= settings.liveness === '1' ? 'Hadapkan wajah ke kamera, lalu kedipkan mata.' : 'Hadapkan wajah ke kamera, satu orang setiap kali.' %></span>
        <span class="flex gap-2"><button type="button" id="fs" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>"><%- ui.icon('maximize') %> Layar penuh</button> <a href="/admin" class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>">Keluar kiosk</a></span>
      </div>
    </div>
    <div class="grid gap-4">
      <div id="result" aria-live="assertive">
        <% if (!totalWajah) { %>
          <div class="<%= ui.card() %>">
            <div class="<%= ui.cardHeader() %>"><h2 class="<%= ui.cardTitle('text-lg') %>">Belum ada wajah terdaftar</h2><p class="<%= ui.cardDescription() %>">Kiosk hanya mengenali pegawai yang wajahnya sudah didaftarkan. Daftarkan wajah pegawai dari menu Pegawai, lalu muat ulang halaman ini.</p></div>
            <div class="<%= ui.cardContent() %>"><a href="/admin/pegawai?wajah=belum" class="<%= ui.button() %>">Daftarkan wajah pegawai</a></div>
          </div>
        <% } else { %>
          <div class="<%= ui.card('py-12 text-center text-muted-foreground') %>"><p class="px-6"><%= totalWajah %> pegawai siap dikenali. Hasil absen akan tampil di sini.</p></div>
        <% } %>
      </div>
      <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="logTitle">
        <h2 class="border-b px-6 py-3 text-sm font-medium" id="logTitle">Riwayat di perangkat ini</h2>
        <ul class="max-h-72 divide-y overflow-y-auto text-sm" id="log"><li class="px-6 py-3 text-muted-foreground" id="logEmpty">Belum ada absen dari perangkat ini sejak halaman dibuka.</li></ul>
      </section>
    </div>
  </div>
</div>

<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const LIVENESS = <%- JSON.stringify(settings.liveness === '1') %>;
  const TZ = <%- JSON.stringify(settings.timezone_label).replace(/</g, '\\u003c') %>;
  const video = document.getElementById('video');
  const overlay = document.getElementById('overlay');
  const status = document.getElementById('status');
  const result = document.getElementById('result');
  const log = document.getElementById('log');
  const esc = FaceKit.esc;
  const ICON_OK = <%- JSON.stringify(ui.icon('circle-check', 'size-14 shrink-0 text-[#7ee2a8]')) %>;
  const ICON_FAIL = <%- JSON.stringify(ui.icon('circle-x', 'size-14 shrink-0 text-[#ff9b94]')) %>;
  const BADGE = <%- JSON.stringify({ hadir: ui.badge({ variant: 'hadir' }), terlambat: ui.badge({ variant: 'terlambat' }), alpa: ui.badge({ variant: 'alpa' }) }) %>;
  const HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const now = await FaceKit.serverClock();
  setInterval(() => {
    const d = now();
    document.getElementById('clock').textContent = `${FaceKit.fmtClock(d)} ${TZ}`;
    document.getElementById('date').textContent = `${HARI[d.getUTCDay()]}, ${d.getUTCDate()} ${BULAN[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  }, 500);

  // Mode default: sebelum jam 12 masuk, sesudahnya pulang (dapat diganti manual).
  if (now().getUTCHours() >= 12) document.getElementById('mPulang').checked = true;
  const mode = () => document.querySelector('input[name=mode]:checked').value;

  document.getElementById('fs').addEventListener('click', () => {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  });

  function showResult(ok, html) {
    result.innerHTML = `<div data-result="${ok ? 'ok' : 'gagal'}" class="flex flex-col rounded-xl border-2 bg-card p-6 shadow-sm ${ok ? 'border-[#7ee2a8]' : 'border-[#ff9b94]'}">${html}</div>`;
  }
  function addLog(text, ok) {
    const li = document.createElement('li');
    li.className = 'flex justify-between gap-3 px-6 py-2.5';
    li.innerHTML = `<span><span class="${ok ? BADGE.hadir : BADGE.alpa} mr-1.5">${ok ? 'Berhasil' : 'Gagal'}</span>${esc(text)}</span><span class="text-muted-foreground tabular">${FaceKit.fmtClock(now()).slice(0, 5)}</span>`;
    document.getElementById('logEmpty')?.remove();
    log.prepend(li);
    while (log.children.length > 30) log.lastChild.remove();
  }

  try {
    await FaceKit.load();
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Gagal memulai: ' + e.message;
    return;
  }

  let busy = false;
  let pauseUntil = 0;
  let stable = 0;
  const blink = FaceKit.blinkDetector();

  async function submit(det) {
    busy = true;
    status.textContent = 'Mencocokkan wajah...';
    const photo = FaceKit.capture(video, { maxWidth: 480 }).toDataURL('image/jpeg', 0.8);
    try {
      const r = await FaceKit.postJson('/api/kiosk/absen', { descriptor: FaceKit.toArray(det.descriptor), mode: mode(), photo });
      const masuk = r.mode === 'masuk';
      const info = masuk
        ? (r.terlambat_menit ? `<span class="${BADGE.terlambat}">Terlambat ${r.terlambat_menit} menit</span>` : `<span class="${BADGE.hadir}">Tepat waktu</span>`)
        : (r.pulang_cepat_menit ? `<span class="${BADGE.terlambat}">Pulang cepat ${r.pulang_cepat_menit} menit</span>` : `<span class="${BADGE.hadir}">Sesuai jadwal</span>`);
      showResult(true, `
        <div class="flex items-center gap-4">
          ${ICON_OK}
          <div>
            <div class="text-2xl font-bold">${esc(r.nama)}</div>
            <div class="text-muted-foreground">${esc(r.nip)}${r.jabatan ? ' · ' + esc(r.jabatan) : ''}</div>
            <div class="mt-2 flex flex-wrap items-center gap-2">Absen <b>${masuk ? 'MASUK' : 'PULANG'}</b> pukul <b class="tabular">${esc(r.jam)}</b> ${info}</div>
            ${r.shift ? `<div class="mt-1 text-sm text-muted-foreground">${esc(r.shift)} · kemiripan ${r.similarity}%</div>` : ''}
          </div>
        </div>`);
      addLog(`${r.nama}, ${masuk ? 'masuk' : 'pulang'} ${r.jam}`, true);
      status.textContent = `Terima kasih, ${r.nama}!`;
      pauseUntil = Date.now() + 4000;
    } catch (e) {
      showResult(false, `<div class="flex items-center gap-4">${ICON_FAIL}<div class="text-lg font-semibold">${esc(e.message)}</div></div>`);
      addLog(e.message, false);
      status.textContent = e.message;
      pauseUntil = Date.now() + 3500;
    }
    blink.reset();
    stable = 0;
    busy = false;
  }

  async function loop() {
    if (!busy && video.readyState >= 2 && Date.now() > pauseUntil) {
      const { detection, count } = await FaceKit.detect(video, 320);
      FaceKit.draw(overlay, video, detection, detection && count === 1 ? '#00e676' : '#ffc107');
      if (!detection) {
        stable = 0; blink.reset();
        status.textContent = 'Silakan hadapkan wajah ke kamera.';
      } else if (count > 1) {
        stable = 0;
        status.textContent = 'Terdeteksi lebih dari satu wajah. Satu per satu ya.';
      } else {
        const blinked = LIVENESS ? blink.update(detection) : true;
        stable = detection.detection.score > 0.5 ? stable + 1 : 0;
        if (!blinked) status.textContent = 'Wajah terdeteksi. Silakan kedipkan mata.';
        else if (stable >= 3) await submit(detection);
        else status.textContent = 'Tahan posisi...';
      }
    } else if (Date.now() <= pauseUntil) {
      overlay.getContext('2d').clearRect(0, 0, overlay.width, overlay.height);
    }
    requestAnimationFrame(loop);
  }
  status.textContent = 'Siap. Silakan hadapkan wajah ke kamera.';
  loop();
})();
</script>
</body>
</html>
