<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kiosk Absensi · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="kiosk-body">
<div class="container-xl py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
    <div class="d-flex align-items-center gap-3">
      <% if (settings.logo) { %><img src="/logo?v=<%= encodeURIComponent(settings.logo) %>" alt="Logo <%= settings.nama_instansi %>" style="height: 48px; background: #fff; border-radius: 8px; padding: 3px"><% } %>
      <div>
        <h1 class="h4 mb-0">Absensi wajah</h1>
        <div class="kiosk-muted"><%= settings.nama_instansi %></div>
      </div>
    </div>
    <div class="text-end">
      <div class="kiosk-clock" id="clock" aria-live="off">--:--:--</div>
      <div class="kiosk-muted" id="date"></div>
    </div>
  </div>
  <div class="row g-4">
    <div class="col-lg-7">
      <fieldset class="mb-3">
        <legend class="visually-hidden">Jenis absen</legend>
        <div class="btn-group w-100" role="group">
          <input type="radio" class="btn-check" name="mode" id="mMasuk" value="masuk" checked>
          <label class="btn btn-lg btn-outline-light" for="mMasuk">Absen masuk</label>
          <input type="radio" class="btn-check" name="mode" id="mPulang" value="pulang">
          <label class="btn btn-lg btn-outline-light" for="mPulang">Absen pulang</label>
        </div>
      </fieldset>
      <div class="camera-wrap mirror">
        <video id="video" autoplay muted playsinline></video>
        <canvas class="overlay" id="overlay"></canvas>
        <div class="face-guide"></div>
        <div class="camera-status" id="status" aria-live="polite">Memuat model pengenal wajah...</div>
      </div>
      <div class="d-flex flex-wrap justify-content-between gap-2 mt-2 small kiosk-muted">
        <span><%= settings.liveness === '1' ? 'Hadapkan wajah ke kamera, lalu kedipkan mata.' : 'Hadapkan wajah ke kamera, satu orang setiap kali.' %></span>
        <span><button type="button" id="fs" class="btn btn-sm btn-outline-light">Layar penuh</button> <a href="/admin" class="btn btn-sm btn-outline-light">Keluar kiosk</a></span>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="kiosk-result mb-3" id="result" aria-live="assertive">
        <% if (!totalWajah) { %>
          <div class="card"><div class="card-body">
            <h2 class="h5">Belum ada wajah terdaftar</h2>
            <p class="kiosk-muted mb-3">Kiosk hanya mengenali pegawai yang wajahnya sudah didaftarkan. Daftarkan wajah pegawai dari menu Pegawai, lalu muat ulang halaman ini.</p>
            <a href="/admin/pegawai?wajah=belum" class="btn btn-light">Daftarkan wajah pegawai</a>
          </div></div>
        <% } else { %>
          <div class="card"><div class="card-body kiosk-muted py-5 text-center"><%= totalWajah %> pegawai siap dikenali. Hasil absen akan tampil di sini.</div></div>
        <% } %>
      </div>
      <section class="card kiosk-panel" aria-labelledby="logTitle">
        <div class="card-header kiosk-panel small" id="logTitle">Riwayat di perangkat ini</div>
        <ul class="list-group list-group-flush kiosk-log" id="log"><li class="list-group-item bg-transparent kiosk-muted small" id="logEmpty">Belum ada absen dari perangkat ini sejak halaman dibuka.</li></ul>
      </section>
    </div>
  </div>
</div>

<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const LIVENESS = <%- JSON.stringify(settings.liveness === '1') %>;
  const TZ = <%- JSON.stringify(settings.timezone_label).replace(/</g, '\\u003c') %>;
  const video = document.getElementById('video');
  const overlay = document.getElementById('overlay');
  const status = document.getElementById('status');
  const result = document.getElementById('result');
  const log = document.getElementById('log');
  const esc = FaceKit.esc;
  const HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const now = await FaceKit.serverClock();
  setInterval(() => {
    const d = now();
    document.getElementById('clock').textContent = `${FaceKit.fmtClock(d)} ${TZ}`;
    document.getElementById('date').textContent = `${HARI[d.getUTCDay()]}, ${d.getUTCDate()} ${BULAN[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  }, 500);

  // Mode default: sebelum jam 12 masuk, sesudahnya pulang (dapat diganti manual).
  if (now().getUTCHours() >= 12) document.getElementById('mPulang').checked = true;
  const mode = () => document.querySelector('input[name=mode]:checked').value;

  document.getElementById('fs').addEventListener('click', () => {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  });

  function showResult(ok, html) {
    result.innerHTML = `<div class="card border-${ok ? 'success' : 'danger'}"><div class="card-body">${html}</div></div>`;
  }
  function addLog(text, ok) {
    const li = document.createElement('li');
    li.className = 'list-group-item bg-transparent text-white small d-flex justify-content-between';
    li.innerHTML = `<span><span class="badge ${ok ? 'ok' : 'gagal'} me-1">${ok ? 'Berhasil' : 'Gagal'}</span>${esc(text)}</span><span class="kiosk-muted num">${FaceKit.fmtClock(now()).slice(0, 5)}</span>`;
    document.getElementById('logEmpty')?.remove();
    log.prepend(li);
    while (log.children.length > 30) log.lastChild.remove();
  }

  try {
    await FaceKit.load();
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Gagal memulai: ' + e.message;
    return;
  }

  let busy = false;
  let pauseUntil = 0;
  let stable = 0;
  const blink = FaceKit.blinkDetector();

  async function submit(det) {
    busy = true;
    status.textContent = 'Mencocokkan wajah...';
    const photo = FaceKit.capture(video, { maxWidth: 480 }).toDataURL('image/jpeg', 0.8);
    try {
      const r = await FaceKit.postJson('/api/kiosk/absen', { descriptor: FaceKit.toArray(det.descriptor), mode: mode(), photo });
      const masuk = r.mode === 'masuk';
      const info = masuk
        ? (r.terlambat_menit ? `<span class="badge status-terlambat">Terlambat ${r.terlambat_menit} menit</span>` : '<span class="badge status-hadir">Tepat waktu</span>')
        : (r.pulang_cepat_menit ? `<span class="badge status-terlambat">Pulang cepat ${r.pulang_cepat_menit} menit</span>` : '<span class="badge status-hadir">Sesuai jadwal</span>');
      showResult(true, `
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-check-circle-fill display-4" style="color: #7ee2a8" aria-hidden="true"></i>
          <div>
            <div class="h4 mb-0">${esc(r.nama)}</div>
            <div class="kiosk-muted">${esc(r.nip)}${r.jabatan ? ' · ' + esc(r.jabatan) : ''}</div>
            <div class="mt-2">Absen <b>${masuk ? 'MASUK' : 'PULANG'}</b> pukul <b>${esc(r.jam)}</b> ${info}</div>
            ${r.shift ? `<div class="small kiosk-muted mt-1">${esc(r.shift)} · kemiripan ${r.similarity}%</div>` : ''}
          </div>
        </div>`);
      addLog(`${r.nama}, ${masuk ? 'masuk' : 'pulang'} ${r.jam}`, true);
      status.textContent = `Terima kasih, ${r.nama}!`;
      pauseUntil = Date.now() + 4000;
    } catch (e) {
      showResult(false, `<div class="d-flex align-items-center gap-3"><i class="bi bi-x-circle-fill display-4" style="color: #ff9b94" aria-hidden="true"></i><div class="h5 mb-0">${esc(e.message)}</div></div>`);
      addLog(e.message, false);
      status.textContent = e.message;
      pauseUntil = Date.now() + 3500;
    }
    blink.reset();
    stable = 0;
    busy = false;
  }

  async function loop() {
    if (!busy && video.readyState >= 2 && Date.now() > pauseUntil) {
      const { detection, count } = await FaceKit.detect(video, 320);
      FaceKit.draw(overlay, video, detection, detection && count === 1 ? '#00e676' : '#ffc107');
      if (!detection) {
        stable = 0; blink.reset();
        status.textContent = 'Silakan hadapkan wajah ke kamera.';
      } else if (count > 1) {
        stable = 0;
        status.textContent = 'Terdeteksi lebih dari satu wajah. Satu per satu ya.';
      } else {
        const blinked = LIVENESS ? blink.update(detection) : true;
        stable = detection.detection.score > 0.5 ? stable + 1 : 0;
        if (!blinked) status.textContent = 'Wajah terdeteksi. Silakan kedipkan mata.';
        else if (stable >= 3) await submit(detection);
        else status.textContent = 'Tahan posisi...';
      }
    } else if (Date.now() <= pauseUntil) {
      overlay.getContext('2d').clearRect(0, 0, overlay.width, overlay.height);
    }
    requestAnimationFrame(loop);
  }
  status.textContent = 'Siap. Silakan hadapkan wajah ke kamera.';
  loop();
})();
</script>
</body>
</html>
