<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Masuk · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="min-h-dvh">
<div class="grid min-h-dvh lg:grid-cols-[5fr_7fr]">
  <aside class="hidden flex-col justify-between bg-[linear-gradient(165deg,#0c1a45_0%,#12276b_60%,#1a3590_100%)] p-10 text-white lg:flex">
    <div>
      <% if (settings.logo) { %><img class="mb-6 max-h-18 max-w-56 rounded-lg bg-white object-contain p-1.5" src="/logo?v=<%= encodeURIComponent(settings.logo) %>" alt="Logo <%= settings.nama_instansi %>"><% } %>
      <h1 class="text-3xl font-bold tracking-tight"><%= settings.nama_instansi %></h1>
      <p class="mt-3 max-w-md text-[#d6e2f2]">Absensi pegawai: kiosk wajah, absen dari HP, dinas luar dengan foto GPS, dan data mesin fingerprint dalam satu tempat.</p>
    </div>
    <p class="text-sm text-[#d6e2f2]">Masalah akun? Hubungi admin tata usaha.</p>
  </aside>
  <main class="flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm">
      <div class="mb-8 lg:hidden">
        <% if (settings.logo) { %><img class="mb-3 max-h-16 max-w-48 rounded-lg bg-white object-contain p-1" src="/logo?v=<%= encodeURIComponent(settings.logo) %>" alt="Logo <%= settings.nama_instansi %>"><% } %>
        <div class="font-bold text-navy"><%= settings.nama_instansi %></div>
      </div>
      <div class="<%= ui.card() %>">
        <div class="<%= ui.cardHeader() %>">
          <h2 class="<%= ui.cardTitle('text-xl') %>">Masuk ke sistem absensi</h2>
          <p class="<%= ui.cardDescription() %>">Pegawai masuk dengan NIP. Password awal sama dengan NIP.</p>
        </div>
        <div class="<%= ui.cardContent() %>">
          <% if (error) { %>
            <div data-slot="alert" class="<%= ui.alert('destructive', 'mb-4') %>" role="alert"><div class="<%= ui.alertTitle('line-clamp-none') %>"><%= error %></div></div>
          <% } %>
          <form method="post" action="/login" class="grid gap-5" data-loading="Memeriksa...">
            <div class="grid gap-2">
              <label class="<%= ui.label() %>" for="username">Username atau NIP</label>
              <input class="<%= ui.input('h-10') %>" id="username" name="username" value="<%= username %>" required autofocus autocomplete="username">
            </div>
            <div class="grid gap-2">
              <label class="<%= ui.label() %>" for="password">Password</label>
              <input class="<%= ui.input('h-10') %>" type="password" id="password" name="password" required autocomplete="current-password">
            </div>
            <button type="submit" class="<%= ui.button({ size: 'lg' }, 'w-full') %>">Masuk</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/static/js/app.js"></script>
</body>
</html>
