<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="login-bg d-flex align-items-center min-vh-100">
  <div class="container" style="max-width: 420px">
    <div class="card shadow border-0">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="bi bi-person-bounding-box display-4 text-primary"></i>
          <h1 class="h4 mt-2 mb-0">Sistem Absensi Pegawai</h1>
          <div class="text-muted"><%= settings.nama_instansi %></div>
        </div>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post" action="/login">
          <div class="mb-3">
            <label class="form-label" for="username">Username / NIP</label>
            <input class="form-control" id="username" name="username" value="<%= username %>" required autofocus autocomplete="username">
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" type="password" id="password" name="password" required autocomplete="current-password">
          </div>
          <button class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Masuk</button>
        </form>
      </div>
    </div>
    <p class="text-center text-white-50 small mt-3">Pegawai login menggunakan NIP. Password awal = NIP.</p>
  </div>
</body>
</html>
