<%- include('partials/header') %>
<div class="page-head mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <%- include('partials/breadcrumb', { items: backUrl === '/pegawai' ? [['/pegawai', 'Beranda'], [null, 'Daftarkan wajah']] : [['/admin/pegawai', 'Pegawai'], [null, 'Daftarkan wajah']] }) %>
    <h1 class="text-2xl font-bold tracking-tight">Daftarkan wajah</h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= emp.nama %> · NIP <span class="tabular"><%= emp.nip %></span></p>
  </div>
</div>

<div class="grid items-start gap-6 lg:grid-cols-[7fr_5fr]">
  <div>
    <div class="camera-wrap mirror" id="camWrap">
      <video id="video" autoplay muted playsinline></video>
      <canvas class="overlay" id="overlay"></canvas>
      <div class="face-guide"></div>
      <div class="camera-status" id="status" aria-live="polite">Memuat model pengenal wajah...</div>
    </div>
    <div class="mt-4 mb-2 flex justify-between text-sm"><span>Sampel terekam</span><span id="progressText" class="tabular">0 dari 5</span></div>
    <div class="<%= ui.progress() %>" role="progressbar" aria-labelledby="progressText" aria-valuemin="0" aria-valuemax="5">
      <div class="<%= ui.progressBar %>" id="progress" style="width: 0%"></div>
    </div>
  </div>
  <section class="<%= ui.card() %>" aria-label="Pendaftaran wajah">
    <div class="<%= ui.cardHeader() %>">
      <h2 class="<%= ui.cardTitle() %>">Status wajah</h2>
      <div data-slot="card-action" class="<%= ui.cardAction() %>"><% if (samples) { %>
        <span class="<%= ui.badge({ variant: 'hadir' }) %>"><%= samples %> sampel terdaftar</span>
      <% } else { %>
        <span class="<%= ui.badge({ variant: 'netral' }) %>">Belum terdaftar</span>
      <% } %></div>
    </div>
    <div class="<%= ui.cardContent('grid gap-3') %>">
      <% if (!canReset && samples) { %>
        <div data-slot="alert" class="<%= ui.alert() %>"><%- ui.icon('info') %><div data-slot="alert-description" class="<%= ui.alertDescription() %>">Wajah Anda sudah terdaftar. Hubungi admin bila perlu mendaftarkan ulang.</div></div>
      <% } else { %>
      <ol class="grid list-decimal gap-1 pl-4 text-sm text-muted-foreground">
        <li>Pastikan pencahayaan cukup dan wajah terlihat jelas, tanpa masker atau kacamata gelap.</li>
        <li>Posisikan wajah di dalam bingkai oval.</li>
        <li>Tekan <b class="text-foreground">Mulai rekam</b>, lalu gerakkan kepala sedikit ke kiri, kanan, dan atas agar sampel bervariasi.</li>
      </ol>
      <% if (canReset && samples) { %>
        <div class="flex items-center gap-2">
          <input class="<%= ui.checkbox() %>" type="checkbox" id="replace" checked>
          <label class="<%= ui.label('font-normal') %>" for="replace">Ganti semua sampel lama</label>
        </div>
      <% } %>
      <button class="<%= ui.button({}, 'w-full') %>" id="btnStart" disabled><%- ui.icon('scan-face') %> Mulai rekam</button>
      <% if (canReset) { %>
        <button type="button" class="<%= ui.button({ variant: 'outline' }, 'w-full') %>" id="btnFile"><%- ui.icon('image-up') %> Daftarkan dari file foto</button>
        <input type="file" accept="image/*" id="fileInput" hidden>
      <% } %>
      <div id="msg" aria-live="polite"></div>
      <% } %>
      <% if (canReset && samples) { %>
        <div class="<%= ui.separator('my-1') %>"></div>
        <form method="post" action="/admin/pegawai/<%= emp.id %>/wajah/hapus" data-confirm="Hapus semua data wajah pegawai ini?" data-confirm-label="Hapus data wajah">
          <button class="<%= ui.button({ variant: 'outline-destructive', size: 'sm' }) %>">Hapus data wajah</button>
        </form>
      <% } %>
      <% if (emp.face_photo) { %>
        <div class="<%= ui.separator('my-1') %>"></div>
        <p class="text-sm text-muted-foreground">Foto referensi</p>
        <img src="/uploads/<%= emp.face_photo %>" class="w-40 rounded-lg border" alt="Foto wajah">
      <% } %>
    </div>
  </section>
</div>

<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const TARGET = 5;
  const saveUrl = <%- JSON.stringify(saveUrl) %>;
  const video = document.getElementById('video');
  const overlay = document.getElementById('overlay');
  const status = document.getElementById('status');
  const progress = document.getElementById('progress');
  const btn = document.getElementById('btnStart');
  const msg = document.getElementById('msg');
  const fileInput = document.getElementById('fileInput');
  const replaceBox = document.getElementById('replace');
  let recording = false;
  let samples = [];
  let photo = null;
  let lastAt = 0;

  const show = (type, text) => { if (msg) msg.innerHTML = uiAlert(type, FaceKit.esc(text)); };
  const setProgress = () => {
    progress.style.width = `${(samples.length / TARGET) * 100}%`;
    document.getElementById('progressText').textContent = `${samples.length} dari ${TARGET}`;
  };

  async function save(descriptors, photoData) {
    status.textContent = 'Menyimpan data wajah...';
    try {
      const r = await FaceKit.postJson(saveUrl, { descriptors, photo: photoData, replace: replaceBox ? replaceBox.checked : true });
      show('success', `Berhasil! ${r.samples} sampel wajah tersimpan. Halaman akan dimuat ulang...`);
      status.textContent = 'Selesai.';
      setTimeout(() => location.reload(), 1500);
    } catch (e) {
      show('danger', e.message);
      status.textContent = 'Gagal menyimpan.';
      if (btn) btn.disabled = false;
    }
  }

  try {
    await FaceKit.load();
  } catch (e) {
    status.textContent = 'Gagal memuat model wajah: ' + e.message;
    return;
  }
  if (!btn) { status.textContent = 'Wajah sudah terdaftar.'; return; }

  const btnFile = document.getElementById('btnFile');
  if (btnFile) btnFile.addEventListener('click', () => fileInput.click());
  if (fileInput) {
    fileInput.addEventListener('change', async () => {
      const f = fileInput.files[0];
      if (!f) return;
      const img = await faceapi.bufferToImage(f);
      status.textContent = 'Menganalisis foto...';
      const { detection, count } = await FaceKit.detect(img, 608);
      if (!detection) return show('warning', 'Wajah tidak terdeteksi pada foto.');
      if (count > 1) return show('warning', 'Terdeteksi lebih dari satu wajah. Gunakan foto satu orang.');
      const c = document.createElement('canvas');
      const scale = Math.min(1, 640 / img.width);
      c.width = img.width * scale; c.height = img.height * scale;
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      await save([FaceKit.toArray(detection.descriptor)], c.toDataURL('image/jpeg', 0.85));
      fileInput.value = '';
    });
  }

  try {
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Kamera tidak tersedia: ' + e.message;
    return;
  }
  status.textContent = 'Kamera siap. Klik "Mulai Rekam".';
  btn.disabled = false;

  btn.addEventListener('click', () => {
    samples = []; photo = null; recording = true; btn.disabled = true; setProgress();
    if (msg) msg.innerHTML = '';
  });

  async function loop() {
    if (video.readyState >= 2) {
      const { detection, count } = await FaceKit.detect(video, 416);
      const good = detection && count === 1 && detection.detection.score > 0.6;
      FaceKit.draw(overlay, video, detection, good ? '#00e676' : '#ffc107');
      if (!recording) {
        status.textContent = !detection ? 'Wajah belum terdeteksi.' : count > 1 ? 'Hanya satu wajah yang boleh terlihat.' : 'Wajah terdeteksi. Klik "Mulai Rekam".';
      } else if (good && Date.now() - lastAt > 700) {
        lastAt = Date.now();
        samples.push(FaceKit.toArray(detection.descriptor));
        if (!photo) photo = FaceKit.capture(video).toDataURL('image/jpeg', 0.85);
        setProgress();
        status.textContent = `Merekam sampel ${samples.length}/${TARGET}... gerakkan kepala sedikit.`;
        if (samples.length >= TARGET) {
          recording = false;
          await save(samples, photo);
        }
      } else if (recording) {
        status.textContent = !detection ? 'Wajah hilang dari kamera...' : 'Tahan posisi, pastikan wajah jelas...';
      }
    }
    requestAnimationFrame(loop);
  }
  loop();
})();
</script>
<%- include('partials/footer') %>
