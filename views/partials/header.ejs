<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<%
  const isAdmin = user && user.role === 'admin';
  const isPegawai = user && user.role === 'pegawai';
  const on = (...prefixes) => prefixes.some((p) => path === p || path.startsWith(p + '/'));
  const navLink = (active) => ui.cn('inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-white/85 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-highlight',
    active && 'bg-white/10 text-white shadow-[inset_0_-3px_0_var(--highlight)]');
  const adminNav = [
    { href: '/admin', label: 'Dashboard', active: path === '/admin' },
    { label: 'Absensi', id: 'mAbsensi', active: on('/admin/absensi', '/admin/rekap'), items: [['/admin/absensi', 'Data absensi'], ['/admin/rekap', 'Rekap per pegawai'], ['/admin/absensi/input', 'Input atau koreksi manual']] },
    { href: '/admin/klarifikasi', label: 'Klarifikasi', active: on('/admin/klarifikasi'), count: pendingKlarifikasi },
    { href: '/admin/pegawai', label: 'Pegawai', active: on('/admin/pegawai') },
    { label: 'Jadwal', id: 'mJadwal', active: on('/admin/shift', '/admin/jadwal', '/admin/hari-libur'), items: [['/admin/jadwal', 'Jadwal shift pegawai'], ['/admin/shift', 'Master shift'], ['/admin/hari-libur', 'Hari libur nasional']] },
    { href: '/admin/mesin', label: 'Mesin fingerprint', active: on('/admin/mesin') },
    { href: '/admin/pengaturan', label: 'Pengaturan', active: on('/admin/pengaturan') },
  ];
  const pegNav = [
    ['/pegawai', 'Beranda', 'house', path === '/pegawai'],
    ['/pegawai/absen', 'Absen', 'scan-face', on('/pegawai/absen')],
    ['/pegawai/dinas-luar', 'Dinas luar', 'map-pin', on('/pegawai/dinas-luar')],
    ['/pegawai/riwayat', 'Riwayat', 'calendar-days', on('/pegawai/riwayat')],
    ['/pegawai/klarifikasi', 'Klarifikasi', 'message-square-text', on('/pegawai/klarifikasi')],
  ];
%>
<body class="min-h-dvh <%= isPegawai ? 'has-bottom-nav' : '' %>">
<a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] <%= ui.button({ variant: 'outline' }) %>">Lewati ke konten</a>
<header class="bg-navy text-white">
  <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-2 lg:px-6">
    <a href="/" class="flex min-h-11 min-w-0 items-center gap-2.5 font-bold"><%- include('brand') %></a>
    <% if (user) { %>
    <nav class="ml-4 hidden flex-1 items-center gap-1 lg:flex" aria-label="Navigasi utama">
      <% if (isAdmin) { adminNav.forEach((n) => { if (n.items) { %>
        <div class="relative">
          <button type="button" class="<%= navLink(n.active) %>" data-dropdown aria-controls="<%= n.id %>" aria-expanded="false" aria-haspopup="menu"><%= n.label %> <%- ui.icon('chevron-down', 'size-4 opacity-70') %></button>
          <div id="<%= n.id %>" role="menu" class="<%= ui.dropdownContent('absolute left-0 top-full mt-1 w-60') %>">
            <% n.items.forEach(([href, label]) => { %><a role="menuitem" class="<%= ui.dropdownItem() %>" href="<%= href %>"><%= label %></a><% }) %>
          </div>
        </div>
      <% } else { %>
        <a class="<%= navLink(n.active) %>" href="<%= n.href %>" <%- n.active ? 'aria-current="page"' : '' %>><%= n.label %><% if (n.count) { %><span class="<%= ui.badge({ variant: 'highlight' }, 'ml-1') %>" title="<%= n.count %> menunggu persetujuan"><%= n.count %></span><% } %></a>
      <% } }) } else { pegNav.forEach(([href, label, , active]) => { %>
        <a class="<%= navLink(active) %>" href="<%= href %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) } %>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <% if (isAdmin) { %><a href="/kiosk" target="_blank" rel="noopener" class="<%= ui.button({ variant: 'secondary', size: 'sm' }, 'hidden lg:inline-flex') %>">Buka kiosk wajah</a><% } %>
      <div class="relative">
        <button type="button" class="<%= navLink(false) %> min-h-11" data-dropdown aria-controls="mAkun" aria-expanded="false" aria-haspopup="menu">
          <span class="max-w-40 truncate"><%= user.nama || user.username %></span> <%- ui.icon('chevron-down', 'size-4 opacity-70') %>
        </button>
        <div id="mAkun" role="menu" class="<%= ui.dropdownContent('absolute right-0 top-full mt-1 w-56') %>">
          <div class="<%= ui.dropdownLabel %>"><span class="block text-xs font-normal text-muted-foreground"><%= isAdmin ? 'Administrator' : 'Pegawai' %> · <%= user.username %></span></div>
          <div class="<%= ui.dropdownSeparator %>"></div>
          <a role="menuitem" class="<%= ui.dropdownItem() %>" href="/akun/password">Ubah password</a>
          <form method="post" action="/logout"><button role="menuitem" class="<%= ui.dropdownItem('destructive') %>">Keluar</button></form>
        </div>
      </div>
      <% if (isAdmin) { %>
        <button type="button" class="<%= ui.button({ variant: 'ghost' }, 'text-white hover:bg-white/10 hover:text-white lg:hidden') %>" data-dialog-open="navSheet" aria-controls="navSheet" aria-expanded="false"><%- ui.icon('menu') %> Menu</button>
      <% } %>
    </div>
    <% } %>
  </div>
</header>
<% if (isAdmin) { %>
<dialog id="navSheet" class="<%= ui.sheet('right') %>" aria-label="Menu navigasi">
  <div class="flex items-center justify-between border-b p-4">
    <span class="font-semibold">Menu</span>
    <button type="button" class="<%= ui.button({ variant: 'ghost', size: 'icon' }) %>" data-dialog-close aria-label="Tutup menu"><%- ui.icon('x') %></button>
  </div>
  <nav class="flex flex-col gap-1 overflow-y-auto px-3 pb-6" aria-label="Navigasi utama">
    <% adminNav.forEach((n) => { if (n.items) { %>
      <div class="px-3 pt-3 pb-1 text-xs font-semibold text-muted-foreground"><%= n.label %></div>
      <% n.items.forEach(([href, label]) => { %><a class="<%= ui.button({ variant: path === href ? 'secondary' : 'ghost' }, 'justify-start') %>" href="<%= href %>"><%= label %></a><% }) %>
    <% } else { %>
      <a class="<%= ui.button({ variant: n.active ? 'secondary' : 'ghost' }, 'justify-start') %>" href="<%= n.href %>"><%= n.label %><% if (n.count) { %><span class="<%= ui.badge({ variant: 'highlight' }, 'ml-auto') %>"><%= n.count %></span><% } %></a>
    <% } }) %>
    <div class="<%= ui.separator('my-2') %>"></div>
    <a class="<%= ui.button({ variant: 'outline' }) %>" href="/kiosk" target="_blank" rel="noopener">Buka kiosk wajah</a>
  </nav>
</dialog>
<% } %>
<% if (isPegawai) { %>
<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t bg-card pb-[env(safe-area-inset-bottom)] md:hidden" aria-label="Navigasi pegawai">
  <% pegNav.forEach(([href, label, icon, active]) => { %>
    <a href="<%= href %>" class="<%= ui.cn('flex min-h-15 flex-col items-center justify-center gap-0.5 text-[0.72rem] font-semibold text-muted-foreground', active && 'text-navy shadow-[inset_0_3px_0_var(--highlight)]') %>" <%- active ? 'aria-current="page"' : '' %>><%- ui.icon(icon, 'size-5') %><%= label %></a>
  <% }) %>
</nav>
<% } %>
<main class="mx-auto max-w-7xl px-4 py-6 lg:px-6" id="konten" tabindex="-1">
  <% if (flash) { const v = { success: 'success', danger: 'destructive', warning: 'warning' }[flash.type] || 'default'; %>
    <div data-slot="alert" class="<%= ui.alert(v, 'mb-4 pr-12') %>" role="<%= flash.type === 'danger' ? 'alert' : 'status' %>">
      <%- ui.icon(flash.type === 'danger' ? 'circle-alert' : flash.type === 'warning' ? 'triangle-alert' : 'circle-check') %>
      <div class="<%= ui.alertTitle('line-clamp-none font-normal') %>"><%= flash.message %></div>
      <button type="button" data-dismiss class="<%= ui.button({ variant: 'ghost', size: 'icon-sm' }, 'absolute top-1.5 right-1.5') %>" aria-label="Tutup pesan"><%- ui.icon('x') %></button>
    </div>
  <% } %>
