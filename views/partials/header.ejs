<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= settings.nama_instansi %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<% const active = (p) => path === p || (p !== '/admin' && p !== '/pegawai' && path.startsWith(p)) ? 'active' : ''; %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary-subtle-dark shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-person-badge-fill"></i>
      <span class="d-none d-sm-inline"><%= settings.nama_instansi %></span>
      <span class="d-sm-none">Absensi</span>
    </a>
    <% if (user) { %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <% if (user.role === 'admin') { %>
          <li class="nav-item"><a class="nav-link <%= active('/admin') %>" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/admin/pegawai') %>" href="/admin/pegawai"><i class="bi bi-people"></i> Pegawai</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= active('/admin/shift') || active('/admin/jadwal') %>" href="#" data-bs-toggle="dropdown"><i class="bi bi-clock-history"></i> Shift</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin/shift">Master Shift</a></li>
              <li><a class="dropdown-item" href="/admin/jadwal">Jadwal Shift Pegawai</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= active('/admin/absensi') || active('/admin/rekap') %>" href="#" data-bs-toggle="dropdown"><i class="bi bi-calendar-check"></i> Absensi</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin/absensi">Data Absensi</a></li>
              <li><a class="dropdown-item" href="/admin/rekap">Rekap Absensi</a></li>
              <li><a class="dropdown-item" href="/admin/absensi/input">Input / Koreksi Manual</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link <%= active('/admin/klarifikasi') %>" href="/admin/klarifikasi"><i class="bi bi-chat-square-text"></i> Klarifikasi</a></li>
          <li class="nav-item"><a class="nav-link" href="/kiosk" target="_blank"><i class="bi bi-camera-video"></i> Kiosk Wajah</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/admin/pengaturan') %>" href="/admin/pengaturan"><i class="bi bi-gear"></i> Pengaturan</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link <%= active('/pegawai') %>" href="/pegawai"><i class="bi bi-house"></i> Beranda</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/pegawai/absen') %>" href="/pegawai/absen"><i class="bi bi-person-bounding-box"></i> Absen Wajah</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/pegawai/dinas-luar') %>" href="/pegawai/dinas-luar"><i class="bi bi-geo-alt"></i> Dinas Luar</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/pegawai/riwayat') %>" href="/pegawai/riwayat"><i class="bi bi-list-check"></i> Riwayat</a></li>
          <li class="nav-item"><a class="nav-link <%= active('/pegawai/klarifikasi') %>" href="/pegawai/klarifikasi"><i class="bi bi-chat-square-text"></i> Klarifikasi</a></li>
        <% } %>
      </ul>
      <div class="dropdown">
        <a class="nav-link text-white dropdown-toggle" href="#" data-bs-toggle="dropdown">
          <i class="bi bi-person-circle"></i> <%= user.nama || user.username %>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><span class="dropdown-item-text small text-muted"><%= user.role === 'admin' ? 'Administrator' : 'Pegawai' %> · <%= user.username %></span></li>
          <li><a class="dropdown-item" href="/akun/password"><i class="bi bi-key"></i> Ubah Password</a></li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form method="post" action="/logout"><button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Keluar</button></form>
          </li>
        </ul>
      </div>
    </div>
    <% } %>
  </div>
</nav>
<main class="container-xl py-4">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
  <% } %>
