<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Absen wajah</h1>
    <div class="sub"><%= rec && rec.jam_masuk ? `Sudah absen masuk pukul ${rec.jam_masuk.slice(11, 16)}${rec.jam_pulang ? `, pulang ${rec.jam_pulang.slice(11, 16)}` : ''}.` : 'Belum absen hari ini.' %></div>
  </div>
</div>
<% if (!enabled) { %>
  <div class="card"><%- include('../partials/empty', { judul: 'Absen dari HP sedang dinonaktifkan', alasan: 'Admin hanya mengizinkan absen lewat kiosk wajah di kantor. Bila sedang bertugas di luar kantor, gunakan absen dinas luar.', aksi: [{ href: '/pegawai/dinas-luar', label: 'Absen dinas luar', utama: true }] }) %></div>
<% } else if (!hasFace) { %>
  <div class="card"><%- include('../partials/empty', { judul: 'Wajah Anda belum terdaftar', alasan: 'Daftarkan wajah satu kali, sekitar satu menit, lalu Anda bisa absen dari halaman ini.', aksi: [{ href: '/pegawai/wajah', label: 'Daftarkan wajah', utama: true }] }) %></div>
<% } else { %>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="camera-wrap mirror">
      <video id="video" autoplay muted playsinline></video>
      <canvas class="overlay" id="overlay"></canvas>
      <div class="face-guide"></div>
      <div class="camera-status" id="status" aria-live="polite">Memuat model pengenal wajah...</div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-body">
        <div class="mb-3">
          <div class="small text-muted">Jam kantor</div>
          <div class="h3 mb-0 num" id="clock">--:--:--</div>
        </div>
        <div class="mb-3">
          <div class="small text-muted">Lokasi</div>
          <div id="loc" class="small" aria-live="polite">Mengambil lokasi GPS...</div>
        </div>
        <div class="d-grid gap-2">
          <button class="btn <%= nextMode === 'masuk' ? 'btn-primary' : 'btn-outline-primary' %> btn-lg" data-mode="masuk" disabled>Absen masuk</button>
          <button class="btn <%= nextMode === 'pulang' ? 'btn-primary' : 'btn-outline-primary' %> btn-lg" data-mode="pulang" disabled>Absen pulang</button>
          <div class="small text-muted">Tombol aktif setelah wajah terdeteksi di kamera.</div>
        </div>
        <div id="msg" class="mt-3" aria-live="polite"></div>
        <p class="small text-muted mt-3 mb-0">Sedang bertugas di luar kantor? Gunakan <a href="/pegawai/dinas-luar">absen dinas luar</a>.</p>
      </div>
    </div>
  </div>
</div>
<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const LIVENESS = <%- JSON.stringify(settings.liveness === '1') %>;
  const TZ = <%- JSON.stringify(settings.timezone_label).replace(/</g, '\\u003c') %>;
  const video = document.getElementById('video');
  const overlay = document.getElementById('overlay');
  const status = document.getElementById('status');
  const msg = document.getElementById('msg');
  const locEl = document.getElementById('loc');
  const buttons = document.querySelectorAll('button[data-mode]');
  const esc = FaceKit.esc;
  let gps = null;
  let current = null;
  let busy = false;
  const blink = FaceKit.blinkDetector();

  const now = await FaceKit.serverClock();
  setInterval(() => { document.getElementById('clock').textContent = `${FaceKit.fmtClock(now())} ${TZ}`; }, 500);

  async function refreshLocation() {
    try {
      gps = await FaceKit.getLocation();
      locEl.innerHTML = `Terdeteksi: ${gps.lat.toFixed(6)}, ${gps.lng.toFixed(6)} (±${gps.accuracy} m)`;
    } catch (e) {
      gps = null;
      locEl.innerHTML = `<span class="text-danger">${esc(e.message)}</span>`;
    }
  }
  refreshLocation();

  try {
    await FaceKit.load();
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Gagal memulai kamera: ' + e.message;
    return;
  }

  buttons.forEach((b) => b.addEventListener('click', async () => {
    if (!current || busy) return;
    busy = true;
    buttons.forEach((x) => { x.disabled = true; });
    msg.innerHTML = '<div class="alert alert-info py-2">Memproses absensi...</div>';
    const det = current;
    const photo = FaceKit.capture(video, { maxWidth: 480 }).toDataURL('image/jpeg', 0.8);
    if (!gps) await refreshLocation();
    try {
      const r = await FaceKit.postJson('/api/pegawai/absen', {
        mode: b.dataset.mode, descriptor: FaceKit.toArray(det.descriptor), photo,
        lat: gps && gps.lat, lng: gps && gps.lng,
      });
      const extra = r.terlambat_menit && r.mode === 'masuk' ? ` (terlambat ${r.terlambat_menit} menit)`
        : r.pulang_cepat_menit && r.mode === 'pulang' ? ` (pulang cepat ${r.pulang_cepat_menit} menit)` : '';
      msg.innerHTML = `<div class="alert alert-success">Absen <b>${r.mode}</b> berhasil pukul <b>${esc(r.jam)}</b>${esc(extra)}.<br><small>Status: ${esc(r.status_label)} · kemiripan wajah ${r.similarity}%</small></div>`;
      FaceKit.stopCamera(video);
      status.textContent = 'Absensi tercatat.';
      setTimeout(() => { window.location.href = '/pegawai'; }, 2500);
      return;
    } catch (e) {
      msg.innerHTML = `<div class="alert alert-danger">${esc(e.message)}</div>`;
      blink.reset();
    }
    busy = false;
  }));

  async function loop() {
    if (!video.srcObject) return;
    if (!busy && video.readyState >= 2) {
      const { detection, count } = await FaceKit.detect(video, 320);
      FaceKit.draw(overlay, video, detection, detection && count === 1 ? '#00e676' : '#ffc107');
      const blinked = detection && count === 1 && (LIVENESS ? blink.update(detection) : true);
      current = blinked ? detection : null;
      buttons.forEach((x) => { x.disabled = !current; });
      status.textContent = !detection ? 'Hadapkan wajah ke kamera.'
        : count > 1 ? 'Hanya wajah Anda yang boleh terlihat.'
          : !blinked ? 'Kedipkan mata untuk verifikasi.' : 'Wajah terdeteksi. Pilih Absen Masuk / Pulang.';
    }
    requestAnimationFrame(loop);
  }
  status.textContent = 'Hadapkan wajah ke kamera.';
  loop();
})();
</script>
<% } %>
<%- include('../partials/footer') %>
