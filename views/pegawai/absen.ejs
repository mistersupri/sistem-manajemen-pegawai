<%- include('../partials/header') %>
<div class="page-head mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Absen wajah</h1>
  <p class="mt-1 text-sm text-muted-foreground"><%= rec && rec.jam_masuk ? `Sudah absen masuk pukul ${rec.jam_masuk.slice(11, 16)}${rec.jam_pulang ? `, pulang ${rec.jam_pulang.slice(11, 16)}` : ''}.` : 'Belum absen hari ini.' %></p>
</div>
<% if (!enabled) { %>
  <div class="<%= ui.card('py-0') %>"><%- include('../partials/empty', { judul: 'Absen dari HP sedang dinonaktifkan', alasan: 'Admin hanya mengizinkan absen lewat kiosk wajah di kantor. Bila sedang bertugas di luar kantor, gunakan absen dinas luar.', aksi: [{ href: '/pegawai/dinas-luar', label: 'Absen dinas luar', utama: true }] }) %></div>
<% } else if (!hasFace) { %>
  <div class="<%= ui.card('py-0') %>"><%- include('../partials/empty', { judul: 'Wajah Anda belum terdaftar', alasan: 'Daftarkan wajah satu kali, sekitar satu menit, lalu Anda bisa absen dari halaman ini.', aksi: [{ href: '/pegawai/wajah', label: 'Daftarkan wajah', utama: true }] }) %></div>
<% } else { %>
<div class="grid items-start gap-6 lg:grid-cols-[7fr_5fr]">
  <div class="camera-wrap mirror">
    <video id="video" autoplay muted playsinline></video>
    <canvas class="overlay" id="overlay"></canvas>
    <div class="face-guide"></div>
    <div class="camera-status" id="status" aria-live="polite">Memuat model pengenal wajah...</div>
  </div>
  <section class="<%= ui.card() %>" aria-label="Absen">
    <div class="<%= ui.cardContent('grid gap-4') %>">
      <div>
        <div class="text-sm text-muted-foreground">Jam kantor</div>
        <div class="text-3xl font-bold tabular" id="clock">--:--:--</div>
      </div>
      <div>
        <div class="text-sm text-muted-foreground">Lokasi</div>
        <div id="loc" class="text-sm" aria-live="polite">Mengambil lokasi GPS...</div>
      </div>
      <div class="grid gap-2">
        <button class="<%= ui.button({ variant: nextMode === 'masuk' ? 'default' : 'outline', size: 'lg' }, 'h-12 text-base') %>" data-mode="masuk" disabled>Absen masuk</button>
        <button class="<%= ui.button({ variant: nextMode === 'pulang' ? 'default' : 'outline', size: 'lg' }, 'h-12 text-base') %>" data-mode="pulang" disabled>Absen pulang</button>
        <p class="text-sm text-muted-foreground">Tombol aktif setelah wajah terdeteksi di kamera.</p>
      </div>
      <div id="msg" aria-live="polite"></div>
      <p class="text-sm text-muted-foreground">Sedang bertugas di luar kantor? Gunakan <a href="/pegawai/dinas-luar">absen dinas luar</a>.</p>
    </div>
  </section>
</div>
<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const LIVENESS = <%- JSON.stringify(settings.liveness === '1') %>;
  const TZ = <%- JSON.stringify(settings.timezone_label).replace(/</g, '\\u003c') %>;
  const video = document.getElementById('video');
  const overlay = document.getElementById('overlay');
  const status = document.getElementById('status');
  const msg = document.getElementById('msg');
  const locEl = document.getElementById('loc');
  const buttons = document.querySelectorAll('button[data-mode]');
  const esc = FaceKit.esc;
  let gps = null;
  let current = null;
  let busy = false;
  const blink = FaceKit.blinkDetector();

  const now = await FaceKit.serverClock();
  setInterval(() => { document.getElementById('clock').textContent = `${FaceKit.fmtClock(now())} ${TZ}`; }, 500);

  async function refreshLocation() {
    try {
      gps = await FaceKit.getLocation();
      locEl.innerHTML = `Terdeteksi: ${gps.lat.toFixed(6)}, ${gps.lng.toFixed(6)} (±${gps.accuracy} m)`;
    } catch (e) {
      gps = null;
      locEl.innerHTML = `<span class="text-destructive">${esc(e.message)}</span>`;
    }
  }
  refreshLocation();

  try {
    await FaceKit.load();
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Gagal memulai kamera: ' + e.message;
    return;
  }

  buttons.forEach((b) => b.addEventListener('click', async () => {
    if (!current || busy) return;
    busy = true;
    buttons.forEach((x) => { x.disabled = true; });
    msg.innerHTML = uiAlert('info', 'Memproses absensi...');
    const det = current;
    const photo = FaceKit.capture(video, { maxWidth: 480 }).toDataURL('image/jpeg', 0.8);
    if (!gps) await refreshLocation();
    try {
      const r = await FaceKit.postJson('/api/pegawai/absen', {
        mode: b.dataset.mode, descriptor: FaceKit.toArray(det.descriptor), photo,
        lat: gps && gps.lat, lng: gps && gps.lng,
      });
      const extra = r.terlambat_menit && r.mode === 'masuk' ? ` (terlambat ${r.terlambat_menit} menit)`
        : r.pulang_cepat_menit && r.mode === 'pulang' ? ` (pulang cepat ${r.pulang_cepat_menit} menit)` : '';
      msg.innerHTML = uiAlert('success', `Absen <b>${r.mode}</b> berhasil pukul <b>${esc(r.jam)}</b>${esc(extra)}.<br><small>Status: ${esc(r.status_label)} · kemiripan wajah ${r.similarity}%</small>`);
      FaceKit.stopCamera(video);
      status.textContent = 'Absensi tercatat.';
      setTimeout(() => { window.location.href = '/pegawai'; }, 2500);
      return;
    } catch (e) {
      msg.innerHTML = uiAlert('danger', esc(e.message));
      blink.reset();
    }
    busy = false;
  }));

  async function loop() {
    if (!video.srcObject) return;
    if (!busy && video.readyState >= 2) {
      const { detection, count } = await FaceKit.detect(video, 320);
      FaceKit.draw(overlay, video, detection, detection && count === 1 ? '#00e676' : '#ffc107');
      const blinked = detection && count === 1 && (LIVENESS ? blink.update(detection) : true);
      current = blinked ? detection : null;
      buttons.forEach((x) => { x.disabled = !current; });
      status.textContent = !detection ? 'Hadapkan wajah ke kamera.'
        : count > 1 ? 'Hanya wajah Anda yang boleh terlihat.'
          : !blinked ? 'Kedipkan mata untuk verifikasi.' : 'Wajah terdeteksi. Pilih Absen Masuk / Pulang.';
    }
    requestAnimationFrame(loop);
  }
  status.textContent = 'Hadapkan wajah ke kamera.';
  loop();
})();
</script>
<% } %>
<%- include('../partials/footer') %>
