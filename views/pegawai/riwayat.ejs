<%- include('../partials/header') %>
<% const [yy, mm] = bulan.split('-').map(Number); %>
<div class="page-head mb-6 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Riwayat absensi</h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= T.BULAN[mm - 1] %> <%= yy %></p>
  </div>
  <form method="get" class="flex gap-2" aria-label="Pilih bulan">
    <label class="sr-only" for="bulan">Bulan</label>
    <input type="month" id="bulan" name="bulan" class="<%= ui.input('w-auto') %>" value="<%= bulan %>" onchange="this.form.submit()">
    <noscript><button class="<%= ui.button() %>">Tampilkan</button></noscript>
  </form>
</div>
<% if (summary) { %>
<section class="<%= ui.card('mb-6') %>" aria-label="Ringkasan bulan">
  <div class="<%= ui.cardContent('flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm text-muted-foreground') %>">
    <div><span class="text-3xl font-bold text-foreground tabular"><%= summary.total_hadir %></span> dari <%= summary.hari_kerja %> hari kerja hadir</div>
    <div><b class="text-foreground tabular"><%= summary.terlambat %></b> terlambat</div>
    <div><b class="text-foreground tabular"><%= summary.dinas_luar %></b> dinas luar</div>
    <div><b class="text-foreground tabular"><%= summary.izin + summary.sakit + summary.cuti %></b> izin, sakit, cuti</div>
    <div><b class="text-foreground tabular"><%= summary.tanpa_keterangan %></b> tanpa keterangan</div>
  </div>
</section>
<% } %>
<div class="<%= ui.card('gap-0 py-0') %>">
  <div class="<%= ui.tableContainer %>">
    <table class="<%= ui.table('table-stack') %>">
      <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>"><th class="<%= ui.tableHead('pl-6') %>">Tanggal</th><th class="<%= ui.tableHead() %>">Masuk</th><th class="<%= ui.tableHead() %>">Pulang</th><th class="<%= ui.tableHead() %>">Status</th><th class="<%= ui.tableHead() %>">Keterangan</th><th class="<%= ui.tableHead('pr-6 text-right') %>"><span class="sr-only">Aksi</span></th></tr></thead>
      <tbody class="<%= ui.tableBody %>">
      <% if (!records.length) { %><tr><td colspan="6"><%- include('../partials/empty', { judul: 'Belum ada absensi di bulan ini', alasan: 'Pilih bulan lain di atas, atau mulai absen dari menu Absen.' }) %></td></tr><% } %>
      <% records.forEach((r) => { %>
        <% if (r.kosong) { %>
        <tr class="<%= ui.tableRow() %>">
          <td class="<%= ui.tableCell('stack-head pl-6 font-medium') %>"><%= T.fmtTglPendek(r.tanggal) %></td>
          <td data-label="Masuk" class="<%= ui.tableCell() %>">-</td>
          <td data-label="Pulang" class="<%= ui.tableCell() %>">-</td>
          <td data-label="Status" class="<%= ui.tableCell() %>"><span class="<%= ui.badge({ variant: 'alpa' }) %>">Tanpa keterangan</span></td>
          <td data-label="Keterangan" class="<%= ui.tableCell('text-muted-foreground') %>">Tidak ada catatan absen</td>
          <td class="<%= ui.tableCell('pr-6') %>"><div class="row-actions flex justify-end"><a class="<%= ui.button({ size: 'sm' }) %>" href="/pegawai/klarifikasi?tanggal=<%= r.tanggal %>">Ajukan klarifikasi</a></div></td>
        </tr>
        <% } else { %>
        <tr class="<%= ui.tableRow() %>">
          <td class="<%= ui.tableCell('stack-head pl-6 font-medium') %>"><%= T.fmtTglPendek(r.tanggal) %><% if (r.shift_kode) { %><span class="block text-xs font-normal text-muted-foreground tabular"><%= r.shift_masuk %> sampai <%= r.shift_pulang %></span><% } %></td>
          <td data-label="Masuk" class="<%= ui.tableCell('tabular') %>"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %><% if (r.foto_masuk) { %> <a class="text-sm" href="/uploads/<%= r.foto_masuk %>" target="_blank" rel="noopener">foto</a><% } %></td>
          <td data-label="Pulang" class="<%= ui.tableCell('tabular') %>"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %><% if (r.foto_pulang) { %> <a class="text-sm" href="/uploads/<%= r.foto_pulang %>" target="_blank" rel="noopener">foto</a><% } %></td>
          <td data-label="Status" class="<%= ui.tableCell() %>"><%- include('../partials/status_badge', { status: r.status }) %><% if (r.terlambat_menit) { %><span class="block text-xs text-muted-foreground tabular">telat <%= r.terlambat_menit %> mnt</span><% } %></td>
          <td data-label="Keterangan" class="<%= ui.tableCell('text-muted-foreground') %>"><%= r.keterangan || '' %></td>
          <td class="<%= ui.tableCell('pr-6') %>"><div class="row-actions flex justify-end"><a class="<%= ui.button({ variant: 'outline', size: 'sm' }) %>" href="/pegawai/klarifikasi?tanggal=<%= r.tanggal %>">Klarifikasi</a></div></td>
        </tr>
        <% } %>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
