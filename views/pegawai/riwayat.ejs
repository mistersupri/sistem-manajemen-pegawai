<%- include('../partials/header') %>
<% const [yy, mm] = bulan.split('-').map(Number); %>
<div class="page-head">
  <div>
    <h1>Riwayat absensi</h1>
    <div class="sub"><%= T.BULAN[mm - 1] %> <%= yy %></div>
  </div>
  <form method="get" class="actions" aria-label="Pilih bulan">
    <label class="visually-hidden" for="bulan">Bulan</label>
    <input type="month" id="bulan" name="bulan" class="form-control" value="<%= bulan %>" onchange="this.form.submit()">
    <noscript><button class="btn btn-primary">Tampilkan</button></noscript>
  </form>
</div>
<% if (summary) { %>
<section class="card mb-4" aria-label="Ringkasan bulan">
  <div class="card-body summary-line">
    <div><span class="big num"><%= summary.total_hadir %></span> <span class="text-muted">dari <%= summary.hari_kerja %> hari kerja hadir</span></div>
    <div class="item text-muted"><b class="text-body num"><%= summary.terlambat %></b> terlambat</div>
    <div class="item text-muted"><b class="text-body num"><%= summary.dinas_luar %></b> dinas luar</div>
    <div class="item text-muted"><b class="text-body num"><%= summary.izin + summary.sakit + summary.cuti %></b> izin, sakit, cuti</div>
    <div class="item text-muted"><b class="text-body num"><%= summary.tanpa_keterangan %></b> tanpa keterangan</div>
  </div>
</section>
<% } %>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover table-stack">
      <thead><tr><th>Tanggal</th><th>Masuk</th><th>Pulang</th><th>Status</th><th>Keterangan</th><th class="text-end"><span class="visually-hidden">Aksi</span></th></tr></thead>
      <tbody>
      <% if (!records.length) { %><tr class="empty-row"><td colspan="6"><%- include('../partials/empty', { judul: 'Belum ada absensi di bulan ini', alasan: 'Pilih bulan lain di atas, atau mulai absen dari menu Absen.' }) %></td></tr><% } %>
      <% records.forEach((r) => { %>
        <% if (r.kosong) { %>
        <tr>
          <td class="stack-head fw-semibold"><%= T.fmtTglPendek(r.tanggal) %></td>
          <td data-label="Masuk">-</td>
          <td data-label="Pulang">-</td>
          <td data-label="Status"><span class="badge status-alpa">Tanpa keterangan</span></td>
          <td data-label="Keterangan" class="small text-muted">Tidak ada catatan absen</td>
          <td class="text-end"><a class="btn btn-sm btn-primary" href="/pegawai/klarifikasi?tanggal=<%= r.tanggal %>">Ajukan klarifikasi</a></td>
        </tr>
        <% } else { %>
        <tr>
          <td class="stack-head fw-semibold"><%= T.fmtTglPendek(r.tanggal) %><% if (r.shift_kode) { %><span class="cell-sub fw-normal num"><%= r.shift_masuk %> sampai <%= r.shift_pulang %></span><% } %></td>
          <td data-label="Masuk" class="num"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %><% if (r.foto_masuk) { %> <a class="small" href="/uploads/<%= r.foto_masuk %>" target="_blank" rel="noopener">foto</a><% } %></td>
          <td data-label="Pulang" class="num"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %><% if (r.foto_pulang) { %> <a class="small" href="/uploads/<%= r.foto_pulang %>" target="_blank" rel="noopener">foto</a><% } %></td>
          <td data-label="Status"><%- include('../partials/status_badge', { status: r.status }) %><% if (r.terlambat_menit) { %><span class="cell-sub num">telat <%= r.terlambat_menit %> mnt</span><% } %></td>
          <td data-label="Keterangan" class="small text-muted"><%= r.keterangan || '' %></td>
          <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/pegawai/klarifikasi?tanggal=<%= r.tanggal %>">Klarifikasi</a></td>
        </tr>
        <% } %>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
