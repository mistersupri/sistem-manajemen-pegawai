<%- include('../partials/header') %>
<div class="mb-3">
  <h1 class="h4 mb-0">Halo, <%= emp.nama %> 👋</h1>
  <div class="text-muted"><%= T.fmtTanggalIndo(today) %> · <%= emp.jabatan || '' %> <%= emp.unit_kerja ? '· ' + emp.unit_kerja : '' %></div>
</div>

<% if (!emp.face_descriptors) { %>
  <div class="alert alert-warning d-flex justify-content-between align-items-center">
    <span><i class="bi bi-exclamation-triangle"></i> Wajah Anda belum terdaftar. Daftarkan wajah agar dapat absen.</span>
    <a href="/pegawai/wajah" class="btn btn-warning btn-sm">Daftarkan Wajah</a>
  </div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <div class="small text-muted">Jadwal hari ini</div>
        <% if (libur) { %><div class="h4 text-danger mb-0">Libur</div>
        <% } else if (shift) { %><div class="h4 mb-0"><span class="shift-chip" style="background: <%= shift.warna %>"><%= shift.kode %></span> <%= shift.jam_masuk %> – <%= shift.jam_pulang %></div><div class="small text-muted"><%= shift.nama %> · toleransi <%= shift.toleransi_menit %> menit</div>
        <% } else { %><div class="h5 text-muted mb-0">Tidak ada shift</div><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <div class="small text-muted">Absensi hari ini</div>
        <% if (todayRec) { %>
          <div class="h5 mb-1">Masuk <b><%= todayRec.jam_masuk ? todayRec.jam_masuk.slice(11, 16) : '--:--' %></b> · Pulang <b><%= todayRec.jam_pulang ? todayRec.jam_pulang.slice(11, 16) : '--:--' %></b></div>
          <%- include('../partials/status_badge', { status: todayRec.status }) %>
          <% if (todayRec.terlambat_menit) { %><span class="small text-muted">terlambat <%= todayRec.terlambat_menit %> menit</span><% } %>
        <% } else if (openRec) { %>
          <div class="h6 mb-1">Shift kemarin: masuk <%= openRec.jam_masuk.slice(11, 16) %>, belum absen pulang.</div>
        <% } else { %><div class="h5 text-muted mb-0">Belum absen</div><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body d-grid gap-2">
        <a href="/pegawai/absen" class="btn btn-primary"><i class="bi bi-person-bounding-box"></i> Absen dengan Wajah</a>
        <a href="/pegawai/dinas-luar" class="btn btn-info text-white"><i class="bi bi-geo-alt"></i> Absen Dinas Luar (Foto GPS)</a>
        <a href="/pegawai/klarifikasi" class="btn btn-outline-secondary"><i class="bi bi-chat-square-text"></i> Klarifikasi Absen<% if (pending) { %> <span class="badge bg-warning text-dark"><%= pending %> menunggu</span><% } %></a>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-white"><b>Ringkasan bulan ini</b></div>
      <% if (summary) { %>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">Hari kerja <b><%= summary.hari_kerja %></b></li>
        <li class="list-group-item d-flex justify-content-between">Hadir tepat waktu <b class="text-success"><%= summary.hadir %></b></li>
        <li class="list-group-item d-flex justify-content-between">Terlambat <b class="text-warning"><%= summary.terlambat %> (<%= summary.total_terlambat %> mnt)</b></li>
        <li class="list-group-item d-flex justify-content-between">Dinas luar <b><%= summary.dinas_luar %></b></li>
        <li class="list-group-item d-flex justify-content-between">Izin / Sakit / Cuti <b><%= summary.izin + summary.sakit + summary.cuti %></b></li>
        <li class="list-group-item d-flex justify-content-between">Tanpa keterangan <b class="text-danger"><%= summary.tanpa_keterangan %></b></li>
      </ul>
      <% } %>
    </div>
    <div class="card shadow-sm">
      <div class="card-header bg-white"><b>Jadwal 7 hari ke depan</b></div>
      <ul class="list-group list-group-flush">
        <% upcoming.forEach((u) => { %>
          <li class="list-group-item d-flex justify-content-between small">
            <span><%= T.HARI[T.parseDateTime(u.tanggal).getDay()] %>, <%= +u.tanggal.slice(8) %>/<%= +u.tanggal.slice(5, 7) %></span>
            <% if (u.libur) { %><span class="libur text-danger fw-bold">Libur</span>
            <% } else if (u.shift) { %><span><span class="shift-chip" style="background: <%= u.shift.warna %>"><%= u.shift.kode %></span> <%= u.shift.jam_masuk %>-<%= u.shift.jam_pulang %></span>
            <% } else { %><span class="text-muted">-</span><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between"><b>Absensi terakhir</b><a href="/pegawai/riwayat" class="small">Lihat semua</a></div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead><tr><th>Tanggal</th><th>Shift</th><th>Masuk</th><th>Pulang</th><th>Status</th></tr></thead>
          <tbody>
          <% if (!recent.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Belum ada data.</td></tr><% } %>
          <% recent.forEach((r) => { %>
            <tr>
              <td><%= r.tanggal %></td><td><%= r.shift_kode || '-' %></td>
              <td><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %></td><td><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></td>
              <td><%- include('../partials/status_badge', { status: r.status }) %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
