<%- include('../partials/header') %>
<%
  const rec = todayRec;
  const sub = [T.fmtTanggalIndo(today), emp.jabatan, emp.unit_kerja].filter(Boolean).join(' · ');
  let next = null;
  if (openRec) next = { label: 'Absen pulang shift kemarin', href: '/pegawai/absen', note: `Anda masuk ${openRec.jam_masuk.slice(11, 16)} kemarin dan belum absen pulang.` };
  else if (!rec || !rec.jam_masuk) next = libur ? null : { label: 'Absen masuk sekarang', href: '/pegawai/absen' };
  else if (!rec.jam_pulang) next = { label: 'Absen pulang', href: '/pegawai/absen' };
%>
<div class="page-head">
  <div>
    <h1>Halo, <%= emp.nama %></h1>
    <div class="sub"><%= sub %></div>
  </div>
</div>

<% if (!emp.face_descriptors) { %>
  <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="status">
    <span>Wajah Anda belum terdaftar, jadi absen wajah dan dinas luar belum bisa dipakai.</span>
    <a href="/pegawai/wajah" class="btn btn-sm btn-primary">Daftarkan wajah</a>
  </div>
<% } %>

<section class="card mb-4" aria-labelledby="hariIni">
  <div class="card-body">
    <div class="row g-4 align-items-center">
      <div class="col-md-7">
        <h2 class="h6 text-muted mb-1" id="hariIni">Hari ini</h2>
        <% if (libur) { %>
          <div class="h3 mb-1">Libur</div>
          <p class="text-muted mb-0">Tidak ada jadwal kerja hari ini.</p>
        <% } else { %>
          <div class="h3 mb-1 num"><%= shift ? `${shift.jam_masuk} sampai ${shift.jam_pulang}` : 'Tanpa shift' %></div>
          <p class="text-muted mb-3"><%= shift ? `${shift.nama}, toleransi ${shift.toleransi_menit} menit` : 'Hubungi admin bila Anda seharusnya punya jadwal.' %></p>
        <% } %>
        <div class="d-flex flex-wrap gap-4 mb-3">
          <div><div class="small text-muted">Masuk</div><div class="h5 mb-0 num"><%= rec && rec.jam_masuk ? rec.jam_masuk.slice(11, 16) : 'Belum' %></div></div>
          <div><div class="small text-muted">Pulang</div><div class="h5 mb-0 num"><%= rec && rec.jam_pulang ? rec.jam_pulang.slice(11, 16) : 'Belum' %></div></div>
          <% if (rec) { %><div><div class="small text-muted">Status</div><%- include('../partials/status_badge', { status: rec.status }) %><% if (rec.terlambat_menit) { %> <span class="small num">telat <%= rec.terlambat_menit %> mnt</span><% } %></div><% } %>
        </div>
        <% if (shift && !libur) { %>
          <%- include('../partials/dayline', { shiftMasuk: shift.jam_masuk, shiftPulang: shift.jam_pulang, masuk: rec && rec.jam_masuk, pulang: rec && rec.jam_pulang, telat: rec && rec.terlambat_menit > 0 }) %>
          <div class="dayline-scale" aria-hidden="true"><span>05.00</span><span>13.30</span><span>22.00</span></div>
        <% } %>
      </div>
      <div class="col-md-5 d-grid gap-2">
        <% if (next) { %>
          <% if (next.note) { %><p class="small mb-1"><%= next.note %></p><% } %>
          <a href="<%= next.href %>" class="btn btn-primary btn-lg"><%= next.label %></a>
        <% } else if (rec && rec.jam_pulang) { %>
          <p class="mb-1">Absen hari ini sudah lengkap.</p>
        <% } %>
        <a href="/pegawai/dinas-luar" class="btn btn-outline-primary">Sedang di luar kantor? Absen dinas luar</a>
        <a href="/pegawai/klarifikasi" class="btn btn-outline-secondary">Ajukan klarifikasi<% if (pending) { %> (<%= pending %> menunggu)<% } %></a>
      </div>
    </div>
  </div>
</section>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="card mb-4" aria-labelledby="bulanIni">
      <div class="card-header"><h2 class="h6 mb-0" id="bulanIni">Bulan ini</h2></div>
      <% if (summary) { %>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">Hari kerja sampai hari ini <b class="num"><%= summary.hari_kerja %></b></li>
        <li class="list-group-item d-flex justify-content-between">Hadir tepat waktu <b class="num"><%= summary.hadir %></b></li>
        <li class="list-group-item d-flex justify-content-between">Terlambat <b class="num"><%= summary.terlambat %><%= summary.total_terlambat ? ` (${summary.total_terlambat} mnt)` : '' %></b></li>
        <li class="list-group-item d-flex justify-content-between">Dinas luar <b class="num"><%= summary.dinas_luar %></b></li>
        <li class="list-group-item d-flex justify-content-between">Izin, sakit, cuti <b class="num"><%= summary.izin + summary.sakit + summary.cuti %></b></li>
        <li class="list-group-item d-flex justify-content-between">Tanpa keterangan <% if (summary.tanpa_keterangan) { %><span class="badge status-alpa num"><%= summary.tanpa_keterangan %></span><% } else { %><b class="num">0</b><% } %></li>
      </ul>
      <% if (summary.tanpa_keterangan) { %><div class="card-footer small">Ada hari tanpa keterangan? <a href="/pegawai/riwayat">Cek riwayat</a> lalu ajukan klarifikasi.</div><% } %>
      <% } %>
    </section>
    <section class="card" aria-labelledby="jadwal7">
      <div class="card-header"><h2 class="h6 mb-0" id="jadwal7">Jadwal 7 hari ke depan</h2></div>
      <ul class="list-group list-group-flush">
        <% upcoming.forEach((u) => { %>
          <li class="list-group-item d-flex justify-content-between small">
            <span><%= T.fmtTglPendek(u.tanggal, false) %></span>
            <% if (u.libur) { %><span class="text-muted fw-semibold">Libur</span>
            <% } else if (u.shift) { %><span class="num"><%= u.shift.jam_masuk %> sampai <%= u.shift.jam_pulang %></span>
            <% } else { %><span class="text-muted">Tanpa shift</span><% } %>
          </li>
        <% }) %>
      </ul>
    </section>
  </div>
  <div class="col-lg-8">
    <section class="card" aria-labelledby="terakhir">
      <div class="card-header d-flex justify-content-between align-items-center"><h2 class="h6 mb-0" id="terakhir">Absensi terakhir</h2><a href="/pegawai/riwayat" class="small">Lihat semua riwayat</a></div>
      <div class="table-responsive">
        <table class="table table-stack">
          <thead><tr><th>Tanggal</th><th>Masuk</th><th>Pulang</th><th>Status</th></tr></thead>
          <tbody>
          <% if (!recent.length) { %><tr class="empty-row"><td colspan="4"><%- include('../partials/empty', { judul: 'Belum ada absensi', alasan: 'Riwayat absen Anda akan muncul di sini setelah absen pertama, baik lewat wajah, dinas luar, maupun mesin fingerprint.' }) %></td></tr><% } %>
          <% recent.forEach((r) => { %>
            <tr>
              <td class="stack-head fw-semibold"><%= T.fmtTglPendek(r.tanggal) %></td>
              <td data-label="Masuk" class="num"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %></td>
              <td data-label="Pulang" class="num"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></td>
              <td data-label="Status"><%- include('../partials/status_badge', { status: r.status }) %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>
