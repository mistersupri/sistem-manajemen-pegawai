<%- include('../partials/header') %>
<%
  const rec = todayRec;
  const sub = [T.fmtTanggalIndo(today), emp.jabatan, emp.unit_kerja].filter(Boolean).join(' · ');
  let next = null;
  if (openRec) next = { label: 'Absen pulang shift kemarin', href: '/pegawai/absen', note: `Anda masuk ${openRec.jam_masuk.slice(11, 16)} kemarin dan belum absen pulang.` };
  else if (!rec || !rec.jam_masuk) next = libur ? null : { label: 'Absen masuk sekarang', href: '/pegawai/absen' };
  else if (!rec.jam_pulang) next = { label: 'Absen pulang', href: '/pegawai/absen' };
  const row = 'flex items-center justify-between gap-3 px-6 py-2.5';
%>
<div class="page-head mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight">Halo, <%= emp.nama %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= sub %></p>
    <% if (next && next.note) { %><p class="mt-2 text-sm"><%= next.note %></p><% } %>
  </div>
  <% if (next) { %><a href="<%= next.href %>" class="<%= ui.button({ size: 'lg' }, 'h-12 w-full text-base sm:w-auto') %>"><%- ui.icon('scan-face') %> <%= next.label %></a><% } %>
</div>

<% if (!emp.face_descriptors) { %>
  <div data-slot="alert" class="<%= ui.alert('warning', 'mb-4') %>" role="status">
    <%- ui.icon('triangle-alert') %>
    <div data-slot="alert-description" class="<%= ui.alertDescription('flex flex-wrap items-center justify-between gap-2') %>">
      <span>Wajah Anda belum terdaftar, jadi absen wajah dan dinas luar belum bisa dipakai.</span>
      <a href="/pegawai/wajah" class="<%= ui.button({ size: 'sm' }) %>">Daftarkan wajah</a>
    </div>
  </div>
<% } %>

<section class="<%= ui.card('mb-6') %>" aria-labelledby="hariIni">
  <div class="<%= ui.cardContent('grid items-center gap-6 md:grid-cols-[7fr_5fr]') %>">
    <div>
      <h2 class="mb-1 text-sm font-medium text-muted-foreground" id="hariIni">Hari ini</h2>
      <% if (libur) { %>
        <div class="text-3xl font-bold">Libur</div>
        <p class="mb-4 text-muted-foreground">Tidak ada jadwal kerja hari ini.</p>
      <% } else { %>
        <div class="text-3xl font-bold tabular"><%= shift ? `${shift.jam_masuk} sampai ${shift.jam_pulang}` : 'Tanpa shift' %></div>
        <p class="mb-4 text-muted-foreground"><%= shift ? `${shift.nama}, toleransi ${shift.toleransi_menit} menit` : 'Hubungi admin bila Anda seharusnya punya jadwal.' %></p>
      <% } %>
      <dl class="mb-4 flex flex-wrap gap-6">
        <div><dt class="text-sm text-muted-foreground">Masuk</dt><dd class="text-xl font-semibold tabular"><%= rec && rec.jam_masuk ? rec.jam_masuk.slice(11, 16) : 'Belum' %></dd></div>
        <div><dt class="text-sm text-muted-foreground">Pulang</dt><dd class="text-xl font-semibold tabular"><%= rec && rec.jam_pulang ? rec.jam_pulang.slice(11, 16) : 'Belum' %></dd></div>
        <% if (rec) { %><div><dt class="text-sm text-muted-foreground">Status</dt><dd class="mt-1 flex items-center gap-2"><%- include('../partials/status_badge', { status: rec.status }) %><% if (rec.terlambat_menit) { %><span class="text-sm tabular">telat <%= rec.terlambat_menit %> mnt</span><% } %></dd></div><% } %>
      </dl>
      <% if (shift && !libur) { %>
        <%- include('../partials/dayline', { shiftMasuk: shift.jam_masuk, shiftPulang: shift.jam_pulang, masuk: rec && rec.jam_masuk, pulang: rec && rec.jam_pulang, telat: rec && rec.terlambat_menit > 0 }) %>
        <div class="flex justify-between text-xs text-muted-foreground" aria-hidden="true"><span>05.00</span><span>13.30</span><span>22.00</span></div>
      <% } %>
    </div>
    <div class="grid gap-2">
      <% if (!next && rec && rec.jam_pulang) { %>
        <p class="flex items-center gap-2 font-medium text-status-hadir-foreground"><%- ui.icon('circle-check') %> Absen hari ini sudah lengkap.</p>
      <% } %>
      <a href="/pegawai/dinas-luar" class="<%= ui.button({ variant: 'outline' }, 'whitespace-normal') %>"><%- ui.icon('map-pin') %> Sedang di luar kantor? Absen dinas luar</a>
      <a href="/pegawai/klarifikasi" class="<%= ui.button({ variant: 'outline' }, 'whitespace-normal') %>">Ajukan klarifikasi<% if (pending) { %> (<%= pending %> menunggu)<% } %></a>
    </div>
  </div>
</section>

<div class="grid items-start gap-6 lg:grid-cols-[1fr_2fr]">
  <div class="grid gap-6">
    <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="bulanIni">
      <h2 class="<%= ui.cardTitle('border-b px-6 py-4') %>" id="bulanIni">Bulan ini</h2>
      <% if (summary) { %>
      <ul class="divide-y text-sm">
        <li class="<%= row %>">Hari kerja sampai hari ini <b class="tabular"><%= summary.hari_kerja %></b></li>
        <li class="<%= row %>">Hadir tepat waktu <b class="tabular"><%= summary.hadir %></b></li>
        <li class="<%= row %>">Terlambat <b class="tabular"><%= summary.terlambat %><%= summary.total_terlambat ? ` (${summary.total_terlambat} mnt)` : '' %></b></li>
        <li class="<%= row %>">Dinas luar <b class="tabular"><%= summary.dinas_luar %></b></li>
        <li class="<%= row %>">Izin, sakit, cuti <b class="tabular"><%= summary.izin + summary.sakit + summary.cuti %></b></li>
        <li class="<%= row %>">Tanpa keterangan <% if (summary.tanpa_keterangan) { %><span class="<%= ui.badge({ variant: 'alpa' }, 'tabular') %>"><%= summary.tanpa_keterangan %></span><% } else { %><b class="tabular">0</b><% } %></li>
      </ul>
      <% if (summary.tanpa_keterangan) { %><p class="border-t px-6 py-3 text-sm">Ada hari tanpa keterangan? <a href="/pegawai/riwayat">Cek riwayat</a> lalu ajukan klarifikasi.</p><% } %>
      <% } %>
    </section>
    <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="jadwal7">
      <h2 class="<%= ui.cardTitle('border-b px-6 py-4') %>" id="jadwal7">Jadwal 7 hari ke depan</h2>
      <ul class="divide-y text-sm">
        <% upcoming.forEach((u) => { %>
          <li class="<%= row %>">
            <span><%= T.fmtTglPendek(u.tanggal, false) %></span>
            <% if (u.libur) { %><span class="font-medium text-muted-foreground">Libur</span>
            <% } else if (u.shift) { %><span class="tabular"><%= u.shift.jam_masuk %> sampai <%= u.shift.jam_pulang %></span>
            <% } else { %><span class="text-muted-foreground">Tanpa shift</span><% } %>
          </li>
        <% }) %>
      </ul>
    </section>
  </div>
  <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="terakhir">
    <div class="flex items-center justify-between gap-3 border-b px-6 py-4"><h2 class="<%= ui.cardTitle() %>" id="terakhir">Absensi terakhir</h2><a href="/pegawai/riwayat" class="text-sm">Lihat semua riwayat</a></div>
    <div class="<%= ui.tableContainer %>">
      <table class="<%= ui.table('table-stack') %>">
        <thead class="<%= ui.tableHeader %>"><tr class="<%= ui.tableRow() %>"><th class="<%= ui.tableHead('pl-6') %>">Tanggal</th><th class="<%= ui.tableHead() %>">Masuk</th><th class="<%= ui.tableHead() %>">Pulang</th><th class="<%= ui.tableHead('pr-6') %>">Status</th></tr></thead>
        <tbody class="<%= ui.tableBody %>">
        <% if (!recent.length) { %><tr><td colspan="4"><%- include('../partials/empty', { judul: 'Belum ada absensi', alasan: 'Riwayat absen Anda akan muncul di sini setelah absen pertama, baik lewat wajah, dinas luar, maupun mesin fingerprint.' }) %></td></tr><% } %>
        <% recent.forEach((r) => { %>
          <tr class="<%= ui.tableRow() %>">
            <td class="<%= ui.tableCell('stack-head pl-6 font-medium') %>"><%= T.fmtTglPendek(r.tanggal) %></td>
            <td data-label="Masuk" class="<%= ui.tableCell('tabular') %>"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %></td>
            <td data-label="Pulang" class="<%= ui.tableCell('tabular') %>"><%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></td>
            <td data-label="Status" class="<%= ui.tableCell('pr-6') %>"><%- include('../partials/status_badge', { status: r.status }) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
