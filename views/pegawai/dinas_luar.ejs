<%- include('../partials/header') %>
<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Absen dinas luar</h1>
  <p class="mt-1 text-sm text-muted-foreground">Ambil foto selfie di lokasi tugas. Foto otomatis diberi stempel jam kantor, koordinat GPS, dan alamat.</p>
</div>
<% if (!hasFace) { %>
  <div class="<%= ui.card('py-0') %>"><%- include('../partials/empty', { judul: 'Wajah Anda belum terdaftar', alasan: 'Foto dinas luar dicocokkan dengan wajah terdaftar agar tidak bisa diwakilkan. Daftarkan wajah satu kali terlebih dahulu.', aksi: [{ href: '/pegawai/wajah', label: 'Daftarkan wajah', utama: true }] }) %></div>
<% } else { %>
<% const toggle = 'flex min-h-9 cursor-pointer items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground peer-checked:bg-background peer-checked:text-foreground peer-checked:shadow-sm peer-focus-visible:ring-[3px] peer-focus-visible:ring-ring/50 pointer-coarse:min-h-11 max-lg:min-h-11'; %>
<div class="grid items-start gap-6 lg:grid-cols-[7fr_5fr]">
  <div>
    <div class="camera-wrap mirror" id="camWrap">
      <video id="video" autoplay muted playsinline></video>
      <canvas class="overlay" id="overlay"></canvas>
      <div class="camera-status" id="status" aria-live="polite">Menyiapkan kamera...</div>
    </div>
    <div id="previewWrap" hidden>
      <img id="preview" class="w-full rounded-xl border" alt="Pratinjau foto dengan stempel waktu dan lokasi">
    </div>
  </div>
  <div class="grid gap-6">
    <section class="<%= ui.card() %>" aria-label="Absen dinas luar">
      <div class="<%= ui.cardContent('grid gap-4') %>">
        <div>
          <div class="text-sm text-muted-foreground">Lokasi GPS</div>
          <div id="loc" class="text-sm" aria-live="polite">Mengambil lokasi...</div>
          <div id="addr" class="text-sm text-muted-foreground"></div>
          <button type="button" class="<%= ui.button({ variant: 'outline', size: 'sm' }, 'mt-2') %>" id="btnLoc"><%- ui.icon('locate-fixed') %> Perbarui lokasi</button>
        </div>
        <div class="grid gap-2">
          <label class="<%= ui.label() %>" for="ket">Tujuan atau keterangan tugas <span class="text-destructive" aria-hidden="true">*</span></label>
          <input id="ket" class="<%= ui.input() %>" maxlength="300" placeholder="Contoh: rapat koordinasi di Dinas Pendidikan Provinsi" required>
        </div>
        <fieldset>
          <legend class="<%= ui.label('mb-2') %>">Jenis absen</legend>
          <div class="grid grid-cols-2 gap-1 rounded-lg bg-muted p-[3px]">
            <div><input type="radio" class="peer sr-only" name="mode" id="mMasuk" value="masuk" checked><label class="<%= toggle %>" for="mMasuk">Masuk</label></div>
            <div><input type="radio" class="peer sr-only" name="mode" id="mPulang" value="pulang"><label class="<%= toggle %>" for="mPulang">Pulang</label></div>
          </div>
        </fieldset>
        <div id="stepCapture" class="grid">
          <button class="<%= ui.button({ size: 'lg' }, 'h-12 text-base') %>" id="btnCapture" disabled><%- ui.icon('camera') %> Ambil foto</button>
        </div>
        <div id="stepConfirm" class="grid gap-2" hidden>
          <button class="<%= ui.button({ size: 'lg' }, 'h-12 text-base') %>" id="btnSend">Kirim absensi</button>
          <button class="<%= ui.button({ variant: 'outline' }) %>" id="btnRetake">Ulangi foto</button>
        </div>
        <div id="msg" aria-live="polite"></div>
      </div>
    </section>
    <% if (recent.length) { %>
    <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="dlTerakhir">
      <h2 class="<%= ui.cardTitle('border-b px-6 py-4') %>" id="dlTerakhir">Dinas luar terakhir</h2>
      <ul class="divide-y text-sm">
        <% recent.forEach((r) => { %>
          <li class="flex flex-wrap justify-between gap-2 px-6 py-2.5">
            <span><%= T.fmtTglPendek(r.tanggal) %> · <span class="tabular"><%= r.jam_masuk ? r.jam_masuk.slice(11, 16) : '-' %> sampai <%= r.jam_pulang ? r.jam_pulang.slice(11, 16) : '-' %></span></span>
            <span>
              <% if (r.foto_masuk) { %><a href="/uploads/<%= r.foto_masuk %>" target="_blank" rel="noopener">foto masuk</a><% } %>
              <% if (r.foto_pulang) { %> · <a href="/uploads/<%= r.foto_pulang %>" target="_blank" rel="noopener">foto pulang</a><% } %>
            </span>
          </li>
        <% }) %>
      </ul>
    </section>
    <% } %>
  </div>
</div>

<script src="/vendor/face-api/face-api.js"></script>
<script src="/static/js/face.js"></script>
<script>
(async () => {
  const EMP = <%- JSON.stringify({ nama: emp.nama, nip: emp.nip }).replace(/</g, '\\u003c') %>;
  const INSTANSI = <%- JSON.stringify(settings.nama_instansi).replace(/</g, '\\u003c') %>;
  const TZ = <%- JSON.stringify(settings.timezone_label).replace(/</g, '\\u003c') %>;
  const HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  const BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const $ = (id) => document.getElementById(id);
  const esc = FaceKit.esc;
  const video = $('video');
  const status = $('status');
  let gps = null;
  let alamat = '';
  let pending = null; // { photo, descriptor }

  const now = await FaceKit.serverClock();
  const show = (type, text) => { $('msg').innerHTML = uiAlert(type, esc(text)); };

  async function refreshLocation() {
    $('loc').textContent = 'Mengambil lokasi...';
    $('addr').textContent = '';
    try {
      gps = await FaceKit.getLocation(20000);
      $('loc').innerHTML = `Terdeteksi: ${gps.lat.toFixed(6)}, ${gps.lng.toFixed(6)} (akurasi ±${gps.accuracy} m)`;
      alamat = await FaceKit.reverseGeocode(gps.lat, gps.lng);
      $('addr').textContent = alamat || '(alamat tidak tersedia)';
    } catch (e) {
      gps = null;
      $('loc').innerHTML = `<span class="text-destructive">${esc(e.message)}</span>`;
    }
  }
  $('btnLoc').addEventListener('click', refreshLocation);
  refreshLocation();

  try {
    await FaceKit.load();
    await FaceKit.startCamera(video);
  } catch (e) {
    status.textContent = 'Gagal memulai kamera: ' + e.message;
    return;
  }
  status.textContent = 'Posisikan wajah Anda di dalam bingkai, lalu klik Ambil Foto.';
  $('btnCapture').disabled = false;

  // Tulis teks dengan pemenggalan baris otomatis, mengembalikan array baris.
  function wrap(ctx, text, maxWidth) {
    const words = String(text).split(/\s+/);
    const lines = [];
    let line = '';
    for (const w of words) {
      const t = line ? `${line} ${w}` : w;
      if (ctx.measureText(t).width > maxWidth && line) { lines.push(line); line = w; } else line = t;
    }
    if (line) lines.push(line);
    return lines;
  }

  /** Bubuhkan stempel waktu + GPS + alamat ke foto. */
  function stamp(canvas, when, keterangan) {
    const ctx = canvas.getContext('2d');
    const W = canvas.width;
    const fs = Math.max(13, Math.round(W / 40));
    ctx.font = `${fs}px sans-serif`;
    const waktu = `${HARI[when.getUTCDay()]}, ${when.getUTCDate()} ${BULAN[when.getUTCMonth()]} ${when.getUTCFullYear()} ${FaceKit.fmtClock(when)} ${TZ}`;
    const rows = [
      { text: `DINAS LUAR · ${EMP.nama} (${EMP.nip})`, bold: true },
      { text: `Waktu: ${waktu}` },
      { text: `Lokasi: ${gps.lat.toFixed(6)}, ${gps.lng.toFixed(6)} (±${gps.accuracy} m)` },
    ];
    const lines = [];
    for (const r of rows) lines.push(r);
    if (alamat) wrap(ctx, alamat, W - fs * 2).slice(0, 3).forEach((t) => lines.push({ text: t, small: true }));
    if (keterangan) wrap(ctx, `Ket: ${keterangan}`, W - fs * 2).slice(0, 2).forEach((t) => lines.push({ text: t, small: true }));
    lines.push({ text: INSTANSI, small: true });
    const lh = Math.round(fs * 1.35);
    const boxH = lh * lines.length + fs;
    const grad = ctx.createLinearGradient(0, canvas.height - boxH - fs, 0, canvas.height);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(0.25, 'rgba(0,0,0,.65)');
    grad.addColorStop(1, 'rgba(0,0,0,.8)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, canvas.height - boxH - fs, W, boxH + fs);
    let y = canvas.height - boxH + lh * 0.6;
    ctx.textBaseline = 'middle';
    for (const l of lines) {
      ctx.font = `${l.bold ? 'bold ' : ''}${l.small ? Math.round(fs * 0.85) : fs}px sans-serif`;
      ctx.fillStyle = l.bold ? '#ffd54f' : '#ffffff';
      ctx.fillText(l.text, fs, y);
      y += lh;
    }
  }

  $('btnCapture').addEventListener('click', async () => {
    $('msg').innerHTML = '';
    const ket = $('ket').value.trim();
    if (!ket) return show('warning', 'Isi tujuan / keterangan dinas terlebih dahulu.');
    if (!gps) {
      await refreshLocation();
      if (!gps) return show('danger', 'Lokasi GPS wajib. Aktifkan GPS dan izinkan akses lokasi.');
    }
    $('btnCapture').disabled = true;
    status.textContent = 'Memeriksa wajah...';
    const canvas = FaceKit.capture(video, { maxWidth: 960 });
    const { detection, count } = await FaceKit.detect(canvas, 416);
    $('btnCapture').disabled = false;
    if (!detection) { status.textContent = 'Wajah tidak terdeteksi. Coba lagi.'; return show('warning', 'Wajah tidak terdeteksi pada foto. Pastikan wajah terlihat jelas.'); }
    if (count > 1) show('info', 'Terdeteksi lebih dari satu wajah; wajah terbesar yang diverifikasi.');
    stamp(canvas, now(), ket);
    pending = { photo: canvas.toDataURL('image/jpeg', 0.85), descriptor: FaceKit.toArray(detection.descriptor) };
    $('preview').src = pending.photo;
    $('camWrap').hidden = true;
    $('previewWrap').hidden = false;
    $('stepCapture').hidden = true;
    $('stepConfirm').hidden = false;
  });

  $('btnRetake').addEventListener('click', () => {
    pending = null;
    $('camWrap').hidden = false;
    $('previewWrap').hidden = true;
    $('stepCapture').hidden = false;
    $('stepConfirm').hidden = true;
    status.textContent = 'Posisikan wajah Anda, lalu klik Ambil Foto.';
  });

  $('btnSend').addEventListener('click', async () => {
    if (!pending) return;
    $('btnSend').disabled = true;
    show('info', 'Mengirim absensi...');
    try {
      const r = await FaceKit.postJson('/api/pegawai/dinas-luar', {
        mode: document.querySelector('input[name=mode]:checked').value,
        photo: pending.photo, descriptor: pending.descriptor,
        lat: gps.lat, lng: gps.lng, alamat, keterangan: $('ket').value.trim(),
      });
      show('success', `Absen ${r.mode} dinas luar berhasil pukul ${r.jam} (kemiripan wajah ${r.similarity}%).`);
      FaceKit.stopCamera(video);
      $('btnRetake').disabled = true;
      setTimeout(() => { window.location.href = '/pegawai'; }, 2500);
    } catch (e) {
      show('danger', e.message);
      $('btnSend').disabled = false;
    }
  });
})();
</script>
<% } %>
<%- include('../partials/footer') %>
