<%- include('../partials/header') %>
<div class="page-head mb-6">
  <h1 class="text-2xl font-bold tracking-tight">Klarifikasi absen</h1>
  <p class="mt-1 text-sm text-muted-foreground">Untuk lupa absen, terlambat, izin, sakit, cuti, atau dinas luar. Admin akan meninjau dan memperbarui absensi Anda.</p>
</div>
<div class="grid items-start gap-6 lg:grid-cols-[5fr_7fr]">
  <form method="post" enctype="multipart/form-data" class="<%= ui.card() %>" data-loading="Mengirim...">
    <div class="<%= ui.cardHeader() %>"><h2 class="<%= ui.cardTitle() %>">Ajukan klarifikasi</h2></div>
    <div class="<%= ui.cardContent('grid gap-4') %>">
      <% if (error) { %><div data-slot="alert" class="<%= ui.alert('destructive') %>" role="alert"><%- ui.icon('circle-alert') %><div data-slot="alert-description" class="<%= ui.alertDescription() %>"><%= error %></div></div><% } %>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="ktgl">Tanggal absen</label><input type="date" id="ktgl" name="tanggal" class="<%= ui.input() %>" value="<%= form.tanggal || '' %>" min="<%= minDate %>" max="<%= maxDate %>" required></div>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="jenis">Jenis klarifikasi</label>
        <div class="<%= ui.selectWrap() %>"><select name="jenis" id="jenis" class="<%= ui.select() %>" required>
          <option value="">Pilih jenis</option>
          <% Object.entries(JENIS).forEach(([k, v]) => { %><option value="<%= k %>" <%= form.jenis === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select><%- ui.icon('chevron-down', ui.selectIcon) %></div>
      </div>
      <div class="grid grid-cols-2 gap-3" id="jamRow">
        <div class="grid gap-2" id="jmBox"><label class="<%= ui.label() %>" for="kjm">Jam masuk sebenarnya</label><input type="time" id="kjm" name="jam_masuk" class="<%= ui.input() %>" value="<%= form.jam_masuk || '' %>"></div>
        <div class="grid gap-2" id="jpBox"><label class="<%= ui.label() %>" for="kjp">Jam pulang sebenarnya</label><input type="time" id="kjp" name="jam_pulang" class="<%= ui.input() %>" value="<%= form.jam_pulang || '' %>"></div>
      </div>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="kal">Alasan</label><textarea id="kal" aria-describedby="kalHelp" name="alasan" class="<%= ui.textarea() %>" rows="4" minlength="10" required><%= form.alasan || '' %></textarea><p class="text-sm text-muted-foreground" id="kalHelp">Minimal 10 karakter. Jelaskan apa yang terjadi, misalnya "Mesin absen mati saat saya tiba pukul 07.20".</p></div>
      <div class="grid gap-2"><label class="<%= ui.label() %>" for="klamp">Lampiran bukti (opsional)</label><input type="file" id="klamp" name="lampiran" class="<%= ui.input('h-auto py-1.5') %>" accept="image/jpeg,image/png,application/pdf" aria-describedby="klampHelp"><p class="text-sm text-muted-foreground" id="klampHelp">Surat dokter, surat tugas, atau foto. JPG, PNG, atau PDF maksimal 5 MB.</p></div>
      <button class="<%= ui.button({}, 'w-full') %>">Kirim klarifikasi</button>
    </div>
  </form>
  <section class="<%= ui.card('gap-0 py-0') %>" aria-labelledby="riwKlar">
    <h2 class="<%= ui.cardTitle('border-b px-6 py-4') %>" id="riwKlar">Pengajuan Anda</h2>
    <% if (!list.length) { %>
      <%- include('../partials/empty', { judul: 'Belum ada pengajuan', alasan: 'Klarifikasi yang Anda kirim akan tercatat di sini beserta keputusan admin.' }) %>
    <% } %>
    <ul class="divide-y">
      <% list.forEach((c) => { %>
        <li class="grid gap-2 px-6 py-4">
          <div class="flex justify-between gap-2">
            <div><b><%= JENIS[c.jenis] %></b><span class="block text-sm text-muted-foreground">untuk <%= T.fmtTglPendek(c.tanggal) %></span></div>
            <span class="<%= ui.statusBadge(c.status, 'self-start') %>"><%= STATUS_KLARIFIKASI[c.status] %></span>
          </div>
          <p class="text-sm whitespace-pre-wrap"><%= c.alasan %></p>
          <p class="text-sm text-muted-foreground">
            <%= [c.jam_masuk_usulan && `Masuk ${c.jam_masuk_usulan}`, c.jam_pulang_usulan && `Pulang ${c.jam_pulang_usulan}`, `Diajukan ${T.fmtTglPendek(c.created_at.slice(0, 10), false)}, ${c.created_at.slice(11, 16)}`].filter(Boolean).join(' · ') %>
            <% if (c.lampiran) { %>· <a href="/uploads/<%= c.lampiran %>" target="_blank" rel="noopener">lihat lampiran</a><% } %>
          </p>
          <% if (c.catatan_admin) { %><p class="rounded-md bg-muted p-2 text-sm"><b>Catatan admin:</b> <%= c.catatan_admin %></p><% } %>
          <% if (c.status === 'menunggu') { %>
            <form method="post" action="/pegawai/klarifikasi/<%= c.id %>/batal" data-confirm="Batalkan klarifikasi ini?" data-confirm-label="Batalkan pengajuan" data-loading="Membatalkan..."><button class="<%= ui.button({ variant: 'outline-destructive', size: 'sm' }) %>">Batalkan pengajuan</button></form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </section>
</div>
<script>
(() => {
  const jenis = document.getElementById('jenis');
  const jm = document.getElementById('jmBox');
  const jp = document.getElementById('jpBox');
  const update = () => {
    const v = jenis.value;
    const showM = ['lupa_absen_masuk', 'lupa_absen', 'terlambat', 'dinas_luar', 'lainnya'].includes(v);
    const showP = ['lupa_absen_pulang', 'lupa_absen', 'pulang_cepat', 'dinas_luar', 'lainnya'].includes(v);
    jm.hidden = !showM;
    jp.hidden = !showP;
    jm.querySelector('input').required = ['lupa_absen_masuk', 'lupa_absen'].includes(v);
    jp.querySelector('input').required = ['lupa_absen_pulang', 'lupa_absen'].includes(v);
    if (!showM) jm.querySelector('input').value = '';
    if (!showP) jp.querySelector('input').value = '';
  };
  jenis.addEventListener('change', update);
  update();
})();
</script>
<%- include('../partials/footer') %>
