<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h5 mb-3"><i class="bi bi-key"></i> Ubah Password</h1>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post">
          <div class="mb-3"><label class="form-label">Password Lama</label><input type="password" name="lama" class="form-control" required autocomplete="current-password"></div>
          <div class="mb-3"><label class="form-label">Password Baru</label><input type="password" name="baru" class="form-control" minlength="6" required autocomplete="new-password"></div>
          <div class="mb-3"><label class="form-label">Ulangi Password Baru</label><input type="password" name="ulang" class="form-control" minlength="6" required autocomplete="new-password"></div>
          <button class="btn btn-primary">Simpan</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
