<%- include('partials/header') %>
<div class="page-head"><div><h1>Ubah password</h1><div class="sub">Gunakan minimal 6 karakter. Setelah diubah, password lama tidak berlaku lagi.</div></div></div>
<div class="row"><div class="col-md-7 col-lg-5">
  <form method="post" class="card" data-loading="Menyimpan...">
    <div class="card-body">
      <% if (error) { %><div class="alert alert-danger py-2" role="alert"><%= error %></div><% } %>
      <div class="mb-3"><label class="form-label" for="pl">Password lama</label><input type="password" id="pl" name="lama" class="form-control" required autocomplete="current-password"></div>
      <div class="mb-3"><label class="form-label" for="pb">Password baru</label><input type="password" id="pb" name="baru" class="form-control" minlength="6" required autocomplete="new-password"></div>
      <div class="mb-1"><label class="form-label" for="pu">Ulangi password baru</label><input type="password" id="pu" name="ulang" class="form-control" minlength="6" required autocomplete="new-password"></div>
    </div>
    <div class="card-footer"><button class="btn btn-primary">Simpan password</button></div>
  </form>
</div></div>
<%- include('partials/footer') %>
