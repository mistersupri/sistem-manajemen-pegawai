<%- include('partials/header') %>
<div class="mb-6"><h1 class="text-2xl font-bold tracking-tight">Ubah password</h1><p class="mt-1 text-sm text-muted-foreground">Gunakan minimal 6 karakter. Setelah diubah, password lama tidak berlaku lagi.</p></div>
<form method="post" class="<%= ui.card('max-w-md') %>" data-loading="Menyimpan...">
  <div class="<%= ui.cardContent('grid gap-5') %>">
    <% if (error) { %><div data-slot="alert" class="<%= ui.alert('destructive') %>" role="alert"><div class="<%= ui.alertTitle('line-clamp-none') %>"><%= error %></div></div><% } %>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="pl">Password lama</label><input type="password" id="pl" name="lama" class="<%= ui.input() %>" required autocomplete="current-password"></div>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="pb">Password baru</label><input type="password" id="pb" name="baru" class="<%= ui.input() %>" minlength="6" required autocomplete="new-password"></div>
    <div class="grid gap-2"><label class="<%= ui.label() %>" for="pu">Ulangi password baru</label><input type="password" id="pu" name="ulang" class="<%= ui.input() %>" minlength="6" required autocomplete="new-password"></div>
  </div>
  <div class="<%= ui.cardFooter() %>"><button class="<%= ui.button() %>">Simpan password</button></div>
</form>
<%- include('partials/footer') %>
