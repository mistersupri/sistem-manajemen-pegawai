{
  "name": "sistem-manajemen-pegawai",
  "version": "1.0.0",
  "description": "Sistem absensi pegawai dengan pengenalan wajah, shift kerja, klarifikasi absen, dan absen dinas luar berbasis foto GPS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
