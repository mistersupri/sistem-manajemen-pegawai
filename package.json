    "watch:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudinpendidikanjp2-del/sistem-manajemen-pegawai.git"
  },
